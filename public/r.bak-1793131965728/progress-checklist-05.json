      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { CheckIcon } from \"lucide-react\"\n\nimport { cn } from \"@/lib/utils\"\n\ntype Step = {\n  id: number\n  type: \"done\" | \"in progress\" | \"open\"\n  title: string\n  description: string\n  activityTime: string\n}\n\nconst STEPS: Step[] = [\n  {\n    id: 1,\n    type: \"done\",\n    title: \"Repository connected\",\n    description: \"Linked your GitHub repo to the SonoJS publish pipeline.\",\n    activityTime: \"3d ago\",\n  },\n  {\n    id: 2,\n    type: \"done\",\n    title: \"Registry build configured\",\n    description: \"Set build commands, tokens, and registry output paths.\",\n    activityTime: \"2d ago\",\n  },\n  {\n    id: 3,\n    type: \"done\",\n    title: \"Docs domain verified\",\n    description: \"Custom docs domain checked and SSL certificate issued.\",\n    activityTime: \"31m ago\",\n  },\n  {\n    id: 4,\n    type: \"in progress\",\n    title: \"Running health checks\",\n    description: \"Verifying docs routes and registry JSON endpoints.\",\n    activityTime: \"Running now…\",\n  },\n  {\n    id: 5,\n    type: \"open\",\n    title: \"Go live\",\n    description: \"Promote this build and switch traffic to the new release.\",\n    activityTime: \"Upcoming\",\n  },\n]\n\nexport default function ProgressChecklist({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  return (\n    <section\n      className={cn(\n        \"relative isolate flex w-full min-w-0 items-center justify-center overflow-hidden bg-canvas px-4 py-10 text-foreground sm:py-12\",\n        className\n      )}\n      aria-labelledby=\"progress-checklist-05-heading\"\n      {...props}\n    >\n      <div\n        aria-hidden\n        className=\"pointer-events-none absolute inset-0 -z-10\"\n      >\n        <div className=\"absolute start-1/2 top-[-18%] size-[22rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl\" />\n      </div>\n\n      <div className=\"mx-auto w-full max-w-lg\">\n        <h2\n          id=\"progress-checklist-05-heading\"\n          className=\"text-start font-medium text-foreground\"\n        >\n          Deployment progress\n        </h2>\n        <ul className=\"mt-6 space-y-6\">\n          {STEPS.map((step, stepIdx) => (\n            <li key={step.id} className=\"relative flex gap-3\">\n              <div\n                className={cn(\n                  \"absolute start-0 top-0 flex w-6 justify-center\",\n                  stepIdx === STEPS.length - 1 ? \"h-6\" : \"-bottom-6\"\n                )}\n              >\n                <span aria-hidden className=\"w-px bg-border\" />\n              </div>\n              <div className=\"flex items-start gap-2.5\">\n                <div className=\"relative flex size-6 flex-none items-center justify-center bg-canvas\">\n                  {step.type === \"done\" ? (\n                    <CheckIcon\n                      aria-hidden\n                      className=\"size-5 text-primary\"\n                      strokeWidth={2.5}\n                    />\n                  ) : step.type === \"in progress\" ? (\n                    <div\n                      aria-hidden\n                      className=\"size-2.5 rounded-full bg-primary ring-4 ring-canvas\"\n                    />\n                  ) : (\n                    <div\n                      aria-hidden\n                      className=\"size-3 rounded-full border border-border bg-card ring-4 ring-canvas\"\n                    />\n                  )}\n                </div>\n                <div className=\"text-start\">\n                  <p className=\"mt-0.5 text-sm font-medium text-foreground\">\n                    {step.title}{\" \"}\n                    <span\n                      dir=\"ltr\"\n                      className=\"font-normal text-muted-foreground/60\"\n                    >\n                      &#8729; {step.activityTime}\n                    </span>\n                  </p>\n                  <p className=\"mt-0.5 text-sm leading-6 text-muted-foreground\">\n                    {step.description}\n                  </p>\n                </div>\n              </div>\n            </li>\n          ))}\n        </ul>\n      </div>\n    </section>\n  )\n}\n",
      "target": "components/blocks/onboarding/progress-checklist-05/progress-checklist.tsx"
    }
