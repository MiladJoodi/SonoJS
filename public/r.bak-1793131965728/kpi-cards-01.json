      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ActivityIcon,\n  CreditCardIcon,\n  DollarSignIcon,\n  TrendingDownIcon,\n  TrendingUpIcon,\n  UsersIcon,\n  type LucideIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport {\n  Card,\n  CardContent,\n  CardHeader,\n} from \"@/components/ui/card\"\nimport { cn } from \"@/lib/utils\"\n\ntype Stat = {\n  title: string\n  value: string\n  change: string\n  isPositive: boolean\n  description: string\n  icon: LucideIcon\n  sparkline: string\n}\n\nconst STATS: Stat[] = [\n  {\n    title: \"Total Revenue\",\n    value: \"$45,231.89\",\n    change: \"+20.1%\",\n    isPositive: true,\n    description: \"from last month\",\n    icon: DollarSignIcon,\n    sparkline: \"M0,30 Q10,25 20,28 T40,20 T60,15 T80,10 T100,5\",\n  },\n  {\n    title: \"Subscriptions\",\n    value: \"+2350\",\n    change: \"+180.1%\",\n    isPositive: true,\n    description: \"from last month\",\n    icon: UsersIcon,\n    sparkline: \"M0,25 Q15,30 25,20 T50,25 T75,10 T100,2\",\n  },\n  {\n    title: \"Sales\",\n    value: \"+12,234\",\n    change: \"+19%\",\n    isPositive: true,\n    description: \"from last month\",\n    icon: CreditCardIcon,\n    sparkline: \"M0,20 Q10,25 30,15 T50,18 T80,5 T100,10\",\n  },\n  {\n    title: \"Active Now\",\n    value: \"+573\",\n    change: \"-5%\",\n    isPositive: false,\n    description: \"since last hour\",\n    icon: ActivityIcon,\n    sparkline: \"M0,5 Q15,10 25,20 T50,15 T75,25 T100,30\",\n  },\n]\n\nfunction Sparkline({\n  path,\n  isPositive,\n}: {\n  path: string\n  isPositive: boolean\n}) {\n  const stroke = isPositive ? \"#059669\" : \"#e11d48\"\n  return (\n    <svg\n      viewBox=\"0 0 100 35\"\n      className=\"size-full overflow-visible\"\n      aria-hidden\n    >\n      <path\n        d={`${path} L100,35 L0,35 Z`}\n        fill={stroke}\n        className=\"opacity-10\"\n        vectorEffect=\"non-scaling-stroke\"\n      />\n      <path\n        d={path}\n        fill=\"none\"\n        stroke={stroke}\n        strokeWidth=\"2\"\n        strokeLinecap=\"round\"\n        strokeLinejoin=\"round\"\n        vectorEffect=\"non-scaling-stroke\"\n      />\n    </svg>\n  )\n}\n\nexport default function KpiCards({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  return (\n    <section\n      className={cn(\n        \"relative isolate w-full min-w-0 overflow-hidden bg-canvas py-8 text-foreground sm:py-10\",\n        className\n      )}\n      aria-labelledby=\"kpi-cards-01-heading\"\n      {...props}\n    >\n      <div\n        aria-hidden\n        className=\"pointer-events-none absolute inset-0 -z-10\"\n      >\n        <div className=\"absolute start-1/2 top-[-20%] size-[22rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl\" />\n      </div>\n\n      <div className=\"mx-auto w-full max-w-7xl space-y-6 px-4 sm:px-6 lg:px-8\">\n        <header className=\"text-start\">\n          <h2\n            id=\"kpi-cards-01-heading\"\n            className=\"text-2xl font-semibold tracking-tight text-foreground\"\n          >\n            Overview\n          </h2>\n          <p className=\"mt-1 text-sm text-muted-foreground\">\n            Your key performance metrics for this month.\n          </p>\n        </header>\n\n        <div className=\"grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n          {STATS.map((stat) => {\n            const Icon = stat.icon\n            const TrendIcon = stat.isPositive\n              ? TrendingUpIcon\n              : TrendingDownIcon\n            return (\n              <Card\n                key={stat.title}\n                className=\"overflow-hidden border-border/70 shadow-soft\"\n              >\n                <CardHeader className=\"flex flex-row items-center justify-between gap-3 pb-2\">\n                  <p className=\"text-sm font-medium text-muted-foreground\">\n                    {stat.title}\n                  </p>\n                  <Icon\n                    className=\"size-5 shrink-0 text-muted-foreground\"\n                    aria-hidden\n                  />\n                </CardHeader>\n                <CardContent className=\"pt-0\">\n                  <p\n                    dir=\"ltr\"\n                    className=\"text-2xl font-semibold tracking-tight tabular-nums text-foreground\"\n                  >\n                    {stat.value}\n                  </p>\n\n                  <div className=\"mt-4 flex flex-wrap items-center gap-2\">\n                    <Badge\n                      variant={stat.isPositive ? \"secondary\" : \"destructive\"}\n                      className={cn(\n                        \"h-5 gap-1 px-1.5\",\n                        stat.isPositive &&\n                          \"border-transparent bg-emerald-500/10 text-emerald-700 dark:bg-emerald-500/20 dark:text-emerald-400\"\n                      )}\n                    >\n                      <TrendIcon aria-hidden />\n                      <span dir=\"ltr\">{stat.change}</span>\n                    </Badge>\n                    <span className=\"text-xs text-muted-foreground\">\n                      {stat.description}\n                    </span>\n                  </div>\n\n                  <div className=\"mt-4 h-10 w-full\">\n                    <Sparkline\n                      path={stat.sparkline}\n                      isPositive={stat.isPositive}\n                    />\n                  </div>\n                </CardContent>\n              </Card>\n            )\n          })}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
