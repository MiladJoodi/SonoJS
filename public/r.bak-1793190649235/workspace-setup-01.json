      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n  InputGroupText,\n} from \"@/components/ui/input-group\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\"\nimport { Separator } from \"@/components/ui/separator\"\nimport { cn } from \"@/lib/utils\"\n\nconst ROLES = [\n  { value: \"founder\", label: \"Founder / CEO\" },\n  { value: \"engineering\", label: \"Engineering\" },\n  { value: \"design\", label: \"Design\" },\n  { value: \"product\", label: \"Product\" },\n  { value: \"marketing\", label: \"Marketing\" },\n  { value: \"ops\", label: \"Operations\" },\n  { value: \"other\", label: \"Other\" },\n] as const\n\nconst TEAM_SIZES = [\n  { value: \"1\", label: \"Just me\" },\n  { value: \"2-10\", label: \"2–10 people\" },\n  { value: \"11-50\", label: \"11–50 people\" },\n  { value: \"51-200\", label: \"51–200 people\" },\n  { value: \"200+\", label: \"200+ people\" },\n] as const\n\nconst COUNTRIES = [\n  { value: \"us\", label: \"United States\" },\n  { value: \"gb\", label: \"United Kingdom\" },\n  { value: \"ca\", label: \"Canada\" },\n  { value: \"de\", label: \"Germany\" },\n  { value: \"nl\", label: \"Netherlands\" },\n  { value: \"ae\", label: \"United Arab Emirates\" },\n  { value: \"in\", label: \"India\" },\n  { value: \"au\", label: \"Australia\" },\n  { value: \"other\", label: \"Other\" },\n] as const\n\nfunction slugify(value: string) {\n  return value\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]+/g, \"-\")\n    .replace(/^-+|-+$/g, \"\")\n    .slice(0, 48)\n}\n\nfunction RequiredMark() {\n  return (\n    <span className=\"text-destructive\" aria-hidden>\n      *\n    </span>\n  )\n}\n\nexport default function WorkspaceSetup({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  const [workspaceName, setWorkspaceName] = React.useState(\"\")\n  const [slug, setSlug] = React.useState(\"\")\n  const [slugTouched, setSlugTouched] = React.useState(false)\n  const [role, setRole] = React.useState(\"\")\n  const [teamSize, setTeamSize] = React.useState(\"\")\n  const [country, setCountry] = React.useState(\"\")\n  const [accepted, setAccepted] = React.useState(false)\n\n  const onWorkspaceNameChange = (value: string) => {\n    setWorkspaceName(value)\n    if (!slugTouched) {\n      setSlug(slugify(value))\n    }\n  }\n\n  return (\n    <section\n      className={cn(\n        \"relative isolate w-full min-w-0 overflow-hidden bg-white dark:bg-background py-10 text-foreground sm:py-12\",\n        className\n      )}\n      aria-labelledby=\"workspace-setup-01-heading\"\n      {...props}\n    >\n      <div\n        aria-hidden\n        className=\"pointer-events-none absolute inset-0 -z-10\"\n      >\n        <div className=\"absolute start-1/2 top-[-18%] size-[24rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl\" />\n      </div>\n\n      <div className=\"mx-auto w-full max-w-2xl px-4 sm:px-6\">\n        <header className=\"text-start\">\n          <p className=\"mb-2 text-sm font-medium tracking-wide text-primary\">\n            Workspace\n          </p>\n          <h1\n            id=\"workspace-setup-01-heading\"\n            className=\"text-balance text-2xl font-semibold tracking-tight text-foreground sm:text-3xl\"\n          >\n            Create your workspace\n          </h1>\n          <p className=\"mt-2 text-pretty text-sm text-muted-foreground\">\n            Set up your team’s SonoJS workspace — invite members and ship UI\n            after you create it.\n          </p>\n        </header>\n\n        <form\n          className=\"mt-8 rounded-[12px] border border-border/70 bg-card p-6 shadow-soft sm:p-8\"\n          onSubmit={(event) => event.preventDefault()}\n          noValidate\n        >\n          <FieldGroup className=\"gap-6\">\n            <div className=\"grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-6\">\n              <Field className=\"col-span-full sm:col-span-3\">\n                <FieldLabel htmlFor=\"workspace-setup-01-first-name\">\n                  First name <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-first-name\"\n                  name=\"firstName\"\n                  type=\"text\"\n                  autoComplete=\"given-name\"\n                  placeholder=\"Jordan\"\n                  required\n                  aria-required=\"true\"\n                />\n              </Field>\n\n              <Field className=\"col-span-full sm:col-span-3\">\n                <FieldLabel htmlFor=\"workspace-setup-01-last-name\">\n                  Last name <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-last-name\"\n                  name=\"lastName\"\n                  type=\"text\"\n                  autoComplete=\"family-name\"\n                  placeholder=\"Lee\"\n                  required\n                  aria-required=\"true\"\n                />\n              </Field>\n\n              <Field className=\"col-span-full\">\n                <FieldLabel htmlFor=\"workspace-setup-01-email\">\n                  Work email <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-email\"\n                  name=\"email\"\n                  type=\"email\"\n                  dir=\"ltr\"\n                  autoComplete=\"email\"\n                  placeholder=\"jordan@acme.com\"\n                  required\n                  aria-required=\"true\"\n                />\n                <FieldDescription>\n                  We’ll send the invite link and billing receipts here.\n                </FieldDescription>\n              </Field>\n\n              <Field className=\"col-span-full\">\n                <FieldLabel htmlFor=\"workspace-setup-01-workspace\">\n                  Workspace name <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-workspace\"\n                  name=\"workspaceName\"\n                  type=\"text\"\n                  autoComplete=\"organization\"\n                  placeholder=\"Acme Design System\"\n                  value={workspaceName}\n                  onChange={(e) => onWorkspaceNameChange(e.target.value)}\n                  required\n                  aria-required=\"true\"\n                />\n              </Field>\n\n              <Field className=\"col-span-full\">\n                <FieldLabel htmlFor=\"workspace-setup-01-slug\">\n                  Workspace URL <RequiredMark />\n                </FieldLabel>\n                <InputGroup dir=\"ltr\">\n                  <InputGroupAddon align=\"inline-start\">\n                    <InputGroupText>app.sonojs.com/</InputGroupText>\n                  </InputGroupAddon>\n                  <InputGroupInput\n                    id=\"workspace-setup-01-slug\"\n                    name=\"workspaceSlug\"\n                    type=\"text\"\n                    autoComplete=\"off\"\n                    spellCheck={false}\n                    placeholder=\"acme\"\n                    value={slug}\n                    onChange={(e) => {\n                      setSlugTouched(true)\n                      setSlug(slugify(e.target.value))\n                    }}\n                    required\n                    aria-required=\"true\"\n                    aria-describedby=\"workspace-setup-01-slug-hint\"\n                  />\n                </InputGroup>\n                <FieldDescription id=\"workspace-setup-01-slug-hint\">\n                  Lowercase letters, numbers, and hyphens. You can change this\n                  later in settings.\n                </FieldDescription>\n              </Field>\n\n              <Field className=\"col-span-full sm:col-span-3\">\n                <FieldLabel htmlFor=\"workspace-setup-01-role\">\n                  Your role <RequiredMark />\n                </FieldLabel>\n                <Select value={role} onValueChange={setRole}>\n                  <SelectTrigger\n                    id=\"workspace-setup-01-role\"\n                    className=\"w-full\"\n                    aria-required=\"true\"\n                  >\n                    <SelectValue placeholder=\"Select your role\" />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {ROLES.map((item) => (\n                      <SelectItem key={item.value} value={item.value}>\n                        {item.label}\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n              </Field>\n\n              <Field className=\"col-span-full sm:col-span-3\">\n                <FieldLabel htmlFor=\"workspace-setup-01-team-size\">\n                  Team size <RequiredMark />\n                </FieldLabel>\n                <Select value={teamSize} onValueChange={setTeamSize}>\n                  <SelectTrigger\n                    id=\"workspace-setup-01-team-size\"\n                    className=\"w-full\"\n                    aria-required=\"true\"\n                  >\n                    <SelectValue placeholder=\"Select team size\" />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {TEAM_SIZES.map((item) => (\n                      <SelectItem key={item.value} value={item.value}>\n                        {item.label}\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n              </Field>\n\n              <Field className=\"col-span-full sm:col-span-3\">\n                <FieldLabel htmlFor=\"workspace-setup-01-country\">\n                  Country / region <RequiredMark />\n                </FieldLabel>\n                <Select value={country} onValueChange={setCountry}>\n                  <SelectTrigger\n                    id=\"workspace-setup-01-country\"\n                    className=\"w-full\"\n                    aria-required=\"true\"\n                  >\n                    <SelectValue placeholder=\"Select country\" />\n                  </SelectTrigger>\n                  <SelectContent>\n                    {COUNTRIES.map((item) => (\n                      <SelectItem key={item.value} value={item.value}>\n                        {item.label}\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n                <FieldDescription>\n                  Used for tax and data-residency defaults.\n                </FieldDescription>\n              </Field>\n\n              <Field className=\"col-span-full sm:col-span-3\">\n                <FieldLabel htmlFor=\"workspace-setup-01-phone\">\n                  Phone{\" \"}\n                  <span className=\"font-normal text-muted-foreground\">\n                    (optional)\n                  </span>\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-phone\"\n                  name=\"phone\"\n                  type=\"tel\"\n                  dir=\"ltr\"\n                  autoComplete=\"tel\"\n                  placeholder=\"+1 415 555 0199\"\n                />\n              </Field>\n            </div>\n\n            <Separator />\n\n            <Field orientation=\"horizontal\" className=\"items-start gap-3\">\n              <Checkbox\n                id=\"workspace-setup-01-terms\"\n                checked={accepted}\n                onCheckedChange={(value) => setAccepted(value === true)}\n                aria-required=\"true\"\n              />\n              <div className=\"grid gap-1.5 leading-none\">\n                <FieldLabel\n                  htmlFor=\"workspace-setup-01-terms\"\n                  className=\"font-normal\"\n                >\n                  I agree to the Terms of Service and Privacy Policy{\" \"}\n                  <RequiredMark />\n                </FieldLabel>\n                <FieldDescription>\n                  You can invite teammates right after the workspace is created.\n                </FieldDescription>\n              </div>\n            </Field>\n\n            <div className=\"flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end\">\n              <Button type=\"button\" variant=\"outline\">\n                Cancel\n              </Button>\n              <Button type=\"submit\" disabled={!accepted}>\n                Create workspace\n              </Button>\n            </div>\n          </FieldGroup>\n        </form>\n      </div>\n    </section>\n  )\n}\n",
      "target": "components/blocks/onboarding/workspace-setup-01/workspace-setup.tsx"
    }
  ],
