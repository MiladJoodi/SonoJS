      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowLeftIcon,\n  ArrowRightIcon,\n  CheckCircle2Icon,\n  CheckIcon,\n  LockIcon,\n  MailIcon,\n  RocketIcon,\n  ShieldCheckIcon,\n  SparklesIcon,\n  UserIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n} from \"@/components/ui/input-group\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\nimport { Progress } from \"@/components/ui/progress\"\nimport { cn } from \"@/lib/utils\"\n\nconst STEPS = [\n  {\n    id: \"account\",\n    label: \"Account\",\n    blurb: \"Name, email, password\",\n    icon: UserIcon,\n  },\n  {\n    id: \"verify\",\n    label: \"Verify\",\n    blurb: \"Confirm your email\",\n    icon: ShieldCheckIcon,\n  },\n  {\n    id: \"experience\",\n    label: \"Experience\",\n    blurb: \"Tailor onboarding\",\n    icon: SparklesIcon,\n  },\n  {\n    id: \"launch\",\n    label: \"Launch\",\n    blurb: \"You're ready\",\n    icon: RocketIcon,\n  },\n] as const\n\nconst EXPERIENCE_OPTIONS = [\n  {\n    value: \"beginner\",\n    label: \"Just starting out\",\n    desc: \"Learning React and modern UI\",\n  },\n  {\n    value: \"intermediate\",\n    label: \"Growing team\",\n    desc: \"Building production apps\",\n  },\n  {\n    value: \"expert\",\n    label: \"Senior / architect\",\n    desc: \"Design systems and scale\",\n  },\n] as const\n\nexport default function SetupWizard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [step, setStep] = React.useState(0)\n  const [email, setEmail] = React.useState(\"\")\n  const [name, setName] = React.useState(\"\")\n  const [otp, setOtp] = React.useState(\"\")\n  const [experience, setExperience] = React.useState(\"\")\n\n  const next = () => setStep((s) => Math.min(s + 1, STEPS.length - 1))\n  const back = () => setStep((s) => Math.max(s - 1, 0))\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-16\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-4xl overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft lg:grid lg:grid-cols-[minmax(14rem,17rem)_minmax(0,1fr)]\">\n        <aside className=\"hidden flex-col gap-1 border-b border-border/70 bg-muted/40 p-5 sm:p-6 lg:flex lg:border-b-0 lg:border-e\">\n          <p className=\"mb-3 text-xs font-medium uppercase tracking-wide text-muted-foreground\">\n            Setup\n          </p>\n          <ol className=\"flex flex-col gap-1\" aria-label=\"Onboarding steps\">\n            {STEPS.map((item, index) => {\n              const Icon = item.icon\n              const done = index < step\n              const current = index === step\n              return (\n                <li key={item.id}>\n                  <div\n                    className={cn(\n                      \"flex w-full items-start gap-3 rounded-[12px] px-3 py-2.5 text-start\",\n                      current && \"bg-card shadow-soft ring-1 ring-border/70\"\n                    )}\n                    aria-current={current ? \"step\" : undefined}\n                  >\n                    <span\n                      className={cn(\n                        \"mt-0.5 flex size-7 shrink-0 items-center justify-center rounded-full border text-xs font-medium\",\n                        done &&\n                          \"border-primary bg-primary text-primary-foreground\",\n                        current &&\n                          !done &&\n                          \"border-primary bg-primary/10 text-primary\",\n                        !done &&\n                          !current &&\n                          \"border-border/70 bg-transparent text-muted-foreground\"\n                      )}\n                    >\n                      {done ? (\n                        <CheckIcon className=\"size-3.5\" aria-hidden />\n                      ) : (\n                        <Icon className=\"size-3.5\" aria-hidden />\n                      )}\n                    </span>\n                    <span className=\"min-w-0\">\n                      <span\n                        className={cn(\n                          \"block text-sm font-medium\",\n                          current || done\n                            ? \"text-foreground\"\n                            : \"text-muted-foreground\"\n                        )}\n                      >\n                        {item.label}\n                      </span>\n                      <span className=\"mt-0.5 block text-xs text-muted-foreground\">\n                        {item.blurb}\n                      </span>\n                    </span>\n                  </div>\n                </li>\n              )\n            })}\n          </ol>\n        </aside>\n\n        <div className=\"min-w-0\">\n          <div className=\"border-b border-border/70 px-5 py-3 lg:hidden\">\n            <Progress\n              value={((step + 1) / STEPS.length) * 100}\n              className=\"h-1.5\"\n              aria-label={`Step ${step + 1} of ${STEPS.length}`}\n            />\n            <p className=\"mt-2 text-xs text-muted-foreground\" aria-live=\"polite\">\n              Step {step + 1} of {STEPS.length} · {STEPS[step].label}\n            </p>\n          </div>\n\n          <div className=\"p-6 sm:p-8\">\n            {step === 0 ? (\n              <FieldGroup className=\"gap-6\">\n                <div className=\"space-y-1.5 text-start\">\n                  <h1 className=\"text-h3 font-semibold tracking-tight\">\n                    Create your account\n                  </h1>\n                  <p className=\"text-sm text-muted-foreground\">\n                    Tell us who you are — then we&apos;ll verify your email.\n                  </p>\n                </div>\n                <Field>\n                  <FieldLabel htmlFor=\"setup-wizard-02-name\">\n                    Full name\n                  </FieldLabel>\n                  <InputGroup>\n                    <InputGroupAddon align=\"inline-start\">\n                      <UserIcon aria-hidden />\n                    </InputGroupAddon>\n                    <InputGroupInput\n                      id=\"setup-wizard-02-name\"\n                      placeholder=\"Alex Rivera\"\n                      value={name}\n                      onChange={(e) => setName(e.target.value)}\n                      autoComplete=\"name\"\n                    />\n                  </InputGroup>\n                </Field>\n                <Field>\n                  <FieldLabel htmlFor=\"setup-wizard-02-email\">\n                    Email address\n                  </FieldLabel>\n                  <InputGroup>\n                    <InputGroupAddon align=\"inline-start\">\n                      <MailIcon aria-hidden />\n                    </InputGroupAddon>\n                    <InputGroupInput\n                      id=\"setup-wizard-02-email\"\n                      type=\"email\"\n                      dir=\"ltr\"\n                      placeholder=\"alex@company.com\"\n                      value={email}\n                      onChange={(e) => setEmail(e.target.value)}\n                      autoComplete=\"email\"\n                    />\n                  </InputGroup>\n                </Field>\n                <Field>\n                  <FieldLabel htmlFor=\"setup-wizard-02-password\">\n                    Password\n                  </FieldLabel>\n                  <InputGroup>\n                    <InputGroupAddon align=\"inline-start\">\n                      <LockIcon aria-hidden />\n                    </InputGroupAddon>\n                    <InputGroupInput\n                      id=\"setup-wizard-02-password\"\n                      type=\"password\"\n                      placeholder=\"At least 8 characters\"\n                      autoComplete=\"new-password\"\n                    />\n                  </InputGroup>\n                  <FieldDescription>\n                    Use 8+ characters with a mix of letters and numbers.\n                  </FieldDescription>\n                </Field>\n                <Button\n                  type=\"button\"\n                  size=\"lg\"\n                  className=\"w-full cursor-pointer gap-2 sm:w-auto sm:self-start\"\n                  onClick={next}\n                >\n                  Continue\n                  <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n                </Button>\n              </FieldGroup>\n            ) : null}\n\n            {step === 1 ? (\n              <div className=\"flex max-w-md flex-col gap-6\">\n                <div className=\"space-y-1.5 text-start\">\n                  <h1 className=\"text-h3 font-semibold tracking-tight\">\n                    Verify your email\n                  </h1>\n                  <p className=\"text-sm text-muted-foreground\">\n                    Enter the code we sent to{\" \"}\n                    <span dir=\"ltr\" className=\"font-medium text-foreground\">\n                      {email || \"alex@company.com\"}\n                    </span>\n                  </p>\n                </div>\n                <div dir=\"ltr\" className=\"flex justify-start\">\n                  <InputOTP\n                    id=\"setup-wizard-02-otp\"\n                    maxLength={6}\n                    value={otp}\n                    onChange={setOtp}\n                  >\n                    <InputOTPGroup>\n                      <InputOTPSlot index={0} />\n                      <InputOTPSlot index={1} />\n                      <InputOTPSlot index={2} />\n                    </InputOTPGroup>\n                    <InputOTPSeparator />\n                    <InputOTPGroup>\n                      <InputOTPSlot index={3} />\n                      <InputOTPSlot index={4} />\n                      <InputOTPSlot index={5} />\n                    </InputOTPGroup>\n                  </InputOTP>\n                </div>\n                <div className=\"flex gap-3\">\n                  <Button\n                    type=\"button\"\n                    variant=\"outline\"\n                    size=\"lg\"\n                    className=\"cursor-pointer gap-2\"\n                    onClick={back}\n                  >\n                    <ArrowLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                    Back\n                  </Button>\n                  <Button\n                    type=\"button\"\n                    size=\"lg\"\n                    className=\"cursor-pointer gap-2\"\n                    onClick={next}\n                  >\n                    Verify\n                    <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n                  </Button>\n                </div>\n              </div>\n            ) : null}\n\n            {step === 2 ? (\n              <div className=\"max-w-lg space-y-6\">\n                <div className=\"space-y-1.5 text-start\">\n                  <h1 className=\"text-h3 font-semibold tracking-tight\">\n                    Experience level\n                  </h1>\n                  <p className=\"text-sm text-muted-foreground\">\n                    Pick what fits best — you can change this later.\n                  </p>\n                </div>\n                <div\n                  className=\"flex flex-col gap-2.5\"\n                  role=\"radiogroup\"\n                  aria-label=\"Experience level\"\n                >\n                  {EXPERIENCE_OPTIONS.map((opt) => {\n                    const selected = experience === opt.value\n                    return (\n                      <button\n                        key={opt.value}\n                        type=\"button\"\n                        role=\"radio\"\n                        aria-checked={selected}\n                        onClick={() => setExperience(opt.value)}\n                        className={cn(\n                          \"flex w-full cursor-pointer items-center justify-between gap-3 rounded-[12px] border px-4 py-3.5 text-start transition-colors\",\n                          selected\n                            ? \"border-primary/40 bg-primary/5 ring-1 ring-primary/30\"\n                            : \"border-border/70 hover:bg-muted/40\"\n                        )}\n                      >\n                        <span className=\"min-w-0\">\n                          <span className=\"block text-sm font-semibold\">\n                            {opt.label}\n                          </span>\n                          <span className=\"mt-0.5 block text-xs text-muted-foreground\">\n                            {opt.desc}\n                          </span>\n                        </span>\n                        {selected ? (\n                          <CheckCircle2Icon\n                            className=\"size-5 shrink-0 text-primary\"\n                            aria-hidden\n                          />\n                        ) : null}\n                      </button>\n                    )\n                  })}\n                </div>\n                <div className=\"flex gap-3\">\n                  <Button\n                    type=\"button\"\n                    variant=\"outline\"\n                    size=\"lg\"\n                    className=\"cursor-pointer gap-2\"\n                    onClick={back}\n                  >\n                    <ArrowLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                    Back\n                  </Button>\n                  <Button\n                    type=\"button\"\n                    size=\"lg\"\n                    className=\"cursor-pointer gap-2\"\n                    disabled={!experience}\n                    onClick={next}\n                  >\n                    Continue\n                    <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n                  </Button>\n                </div>\n              </div>\n            ) : null}\n\n            {step === 3 ? (\n              <div className=\"flex max-w-md flex-col gap-5 text-start\">\n                <span className=\"flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary\">\n                  <RocketIcon className=\"size-6\" aria-hidden />\n                </span>\n                <Badge className=\"w-fit border-0 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300\">\n                  Setup complete\n                </Badge>\n                <div className=\"space-y-1.5\">\n                  <h1 className=\"text-h3 font-semibold tracking-tight\">\n                    You&apos;re ready to build\n                  </h1>\n                  <p className=\"text-sm text-muted-foreground\">\n                    Jump into your dashboard or revisit these steps anytime.\n                  </p>\n                </div>\n                <div className=\"flex flex-wrap gap-3\">\n                  <Button\n                    type=\"button\"\n                    size=\"lg\"\n                    className=\"cursor-pointer gap-2\"\n                  >\n                    Go to dashboard\n                    <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n                  </Button>\n                  <Button\n                    type=\"button\"\n                    variant=\"outline\"\n                    size=\"lg\"\n                    className=\"cursor-pointer\"\n                    onClick={() => {\n                      setStep(0)\n                      setOtp(\"\")\n                      setExperience(\"\")\n                    }}\n                  >\n                    Start over\n                  </Button>\n                </div>\n              </div>\n            ) : null}\n          </div>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/onboarding/setup-wizard-02/setup-wizard.tsx"
    }
