    <svg aria-hidden fill=\"currentColor\" viewBox=\"0 0 24 24\">\n        <path d={brand.glyph} />\n      </svg>\n    </span>\n  )\n}\n\n/** A structured table for comparing AI models and their results. */\nfunction DataTable({ rows = DEFAULT_ROWS, className }: DataTableProps) {\n  return (\n    <div\n      data-slot=\"structured-output\"\n      aria-label=\"AI model pricing\"\n      className={cn(styles.table, className)}\n      role=\"table\"\n    >\n      <div className={styles.tableHead} role=\"row\">\n        {[\"Model\", \"Context\", \"$/1M in\"].map((heading) => (\n          <div className={styles.tableCell} key={heading} role=\"columnheader\">\n            {heading}\n          </div>\n        ))}\n      </div>\n\n      <div className={styles.tableBody} role=\"rowgroup\">\n        {rows.map((row) => (\n          <div className={styles.tableRow} key={row.model} role=\"row\">\n            <div className={styles.tableCell} role=\"cell\">\n              <span className={styles.modelCell}>\n                <ModelIcon model={row.model} />\n                <span className={styles.tableCellText}>{row.model}</span>\n              </span>\n            </div>\n            <div className={styles.tableCell} role=\"cell\">\n              {row.context}\n            </div>\n            <div className={styles.tableCell} role=\"cell\">\n              {row.price}\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  )\n}\n\nexport { DataTable }\n",
