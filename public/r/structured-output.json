    {
      "path": "components/sonojs/structured-output/data-table.module.css",
      "type": "registry:ui",
      "content": ".table {\n  width: min(34rem, calc(100vw - 3rem));\n  overflow: hidden;\n  color: var(--foreground);\n  background: color-mix(in oklab, var(--card) 96%, transparent);\n  border: 1px solid var(--border);\n  border-radius: 0.75rem;\n  box-shadow:\n    0 1px 2px rgb(0 0 0 / 5%),\n    0 12px 36px rgb(0 0 0 / 4%);\n}\n\n.tableHead,\n.tableRow {\n  display: grid;\n  grid-template-columns:\n    minmax(10rem, 1.45fr) minmax(6rem, 0.8fr)\n    minmax(6rem, 0.75fr);\n  align-items: center;\n}\n\n.tableHead {\n  min-height: 2.75rem;\n  color: var(--muted-foreground);\n  background: color-mix(in oklab, var(--muted) 54%, transparent);\n  border-bottom: 1px solid var(--border);\n  font-size: 0.6875rem;\n  font-weight: 600;\n  letter-spacing: 0.045em;\n  text-transform: uppercase;\n}\n\n.tableBody {\n  display: flex;\n  flex-direction: column;\n}\n\n.tableRow {\n  min-height: 3.5rem;\n  font-size: 0.8125rem;\n  font-variant-numeric: tabular-nums;\n  transition: background-color 160ms ease;\n}\n\n.tableRow:not(:last-child) {\n  border-bottom: 1px solid color-mix(in oklab, var(--border) 72%, transparent);\n}\n\n.tableRow:hover {\n  background: color-mix(in oklab, var(--muted) 42%, transparent);\n}\n\n.tableCell {\n  min-width: 0;\n  padding: 0.75rem 1rem;\n}\n\n.tableHead .tableCell:not(:first-child),\n.tableRow .tableCell:not(:first-child) {\n  border-inline-start: 1px solid color-mix(in oklab, var(--border) 60%, transparent);\n}\n\n.modelCell {\n  display: inline-flex;\n  min-width: 0;\n  align-items: center;\n  gap: 0.625rem;\n}\n\n.modelIcon {\n  display: inline-grid;\n  width: 1.5rem;\n  height: 1.5rem;\n  flex: 0 0 auto;\n  place-items: center;\n  color: white;\n  background: var(--brand-color);\n  border-radius: 0.4375rem;\n  box-shadow: inset 0 0 0 1px rgb(255 255 255 / 18%);\n}\n\n.modelIcon svg {\n  width: 0.6875rem;\n  height: 0.6875rem;\n}\n\n.tableCellText {\n  overflow: hidden;\n  font-weight: 500;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n@media (max-width: 480px) {\n  .tableHead,\n  .tableRow {\n    grid-template-columns:\n      minmax(8rem, 1.3fr) minmax(4.75rem, 0.7fr)\n      minmax(4.75rem, 0.7fr);\n  }\n\n  .tableCell {\n    padding-inline: 0.75rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .tableRow {\n    transition: none;\n  }\n}\n",
