Name=\"h-0.5 w-8 rounded-full bg-primary\" aria-hidden />\n            <div className=\"space-y-1.5\">\n              <h1 className=\"text-h3 text-foreground\">Set a new password</h1>\n              <p className=\"text-sm text-muted-foreground\">\n                Choose a new password for your account.\n              </p>\n            </div>\n          </header>\n\n          <form\n            className=\"flex flex-col gap-4\"\n            onSubmit={(event) => event.preventDefault()}\n          >\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"reset-03-password\">New password</Label>\n              <Input\n                id=\"reset-03-password\"\n                type=\"password\"\n                autoComplete=\"new-password\"\n                placeholder={\"\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\"}\n                required\n                className={controlClass}\n              />\n            </div>\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"reset-03-confirm\">Confirm password</Label>\n              <Input\n                id=\"reset-03-confirm\"\n                type=\"password\"\n                autoComplete=\"new-password\"\n                placeholder={\"\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\"}\n                required\n                className={controlClass}\n              />\n            </div>\n            <Button\n              type=\"submit\"\n              className=\"mt-1 h-[46px] w-full rounded-[12px] shadow-none\"\n            >\n              Update password\n            </Button>\n          </form>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
