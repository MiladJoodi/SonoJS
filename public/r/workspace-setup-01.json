      "content": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n  InputGroupText,\n} from \"@/components/ui/input-group\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\"\nimport { Separator } from \"@/components/ui/separator\"\nimport { cn } from \"@/lib/utils\"\n\nconst ROLES = [\n  { value: \"founder\", label: \"Founder / CEO\" },\n  { value: \"engineering\", label: \"Engineering\" },\n  { value: \"design\", label: \"Design\" },\n  { value: \"product\", label: \"Product\" },\n  { value: \"marketing\", label: \"Marketing\" },\n  { value: \"ops\", label: \"Operations\" },\n  { value: \"other\", label: \"Other\" },\n] as const\n\nconst TEAM_SIZES = [\n  { value: \"1\", label: \"Just me\" },\n  { value: \"2-10\", label: \"2–10 people\" },\n  { value: \"11-50\", label: \"11–50 people\" },\n  { value: \"51-200\", label: \"51–200 people\" },\n  { value: \"200+\", label: \"200+ people\" },\n] as const\n\nfunction slugify(value: string) {\n  return value\n    .toLowerCase()\n    .trim()\n    .replace(/[^a-z0-9]+/g, \"-\")\n    .replace(/^-+|-+$/g, \"\")\n    .slice(0, 48)\n}\n\nfunction RequiredMark() {\n  return (\n    <span className=\"text-destructive\" aria-hidden>\n      *\n    </span>\n  )\n}\n\nexport default function WorkspaceSetup({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [workspaceName, setWorkspaceName] = React.useState(\"\")\n  const [slug, setSlug] = React.useState(\"\")\n  const [slugTouched, setSlugTouched] = React.useState(false)\n  const [role, setRole] = React.useState(\"\")\n  const [teamSize, setTeamSize] = React.useState(\"\")\n  const [accepted, setAccepted] = React.useState(false)\n\n  const onWorkspaceNameChange = (value: string) => {\n    setWorkspaceName(value)\n    if (!slugTouched) {\n      setSlug(slugify(value))\n    }\n  }\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-16\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-lg\">\n        <form\n          className=\"overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\"\n          onSubmit={(event) => event.preventDefault()}\n          noValidate\n          aria-labelledby=\"workspace-setup-01-heading\"\n        >\n          <header className=\"border-b border-border/70 px-5 py-5 text-start sm:px-8 sm:py-6\">\n            <h1\n              id=\"workspace-setup-01-heading\"\n              className=\"text-balance text-xl font-semibold tracking-tight sm:text-2xl\"\n            >\n              Create your workspace\n            </h1>\n            <p className=\"mt-1.5 text-pretty text-sm text-muted-foreground\">\n              Name it, pick a URL, and tell us a bit about your team.\n            </p>\n          </header>\n\n          <div className=\"px-5 py-6 sm:px-8 sm:py-8\">\n            <FieldGroup className=\"gap-5\">\n              <Field>\n                <FieldLabel htmlFor=\"workspace-setup-01-name\">\n                  Full name <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-name\"\n                  name=\"fullName\"\n                  type=\"text\"\n                  autoComplete=\"name\"\n                  placeholder=\"Jordan Lee\"\n                  required\n                  aria-required=\"true\"\n                />\n              </Field>\n\n              <Field>\n                <FieldLabel htmlFor=\"workspace-setup-01-email\">\n                  Work email <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-email\"\n                  name=\"email\"\n                  type=\"email\"\n                  dir=\"ltr\"\n                  autoComplete=\"email\"\n                  placeholder=\"jordan@acme.com\"\n                  required\n                  aria-required=\"true\"\n                />\n                <FieldDescription>\n                  We’ll send invites and billing receipts here.\n                </FieldDescription>\n              </Field>\n\n              <Field>\n                <FieldLabel htmlFor=\"workspace-setup-01-workspace\">\n                  Workspace name <RequiredMark />\n                </FieldLabel>\n                <Input\n                  id=\"workspace-setup-01-workspace\"\n                  name=\"workspaceName\"\n                  type=\"text\"\n                  autoComplete=\"organization\"\n                  placeholder=\"Acme Design\"\n                  value={workspaceName}\n                  onChange={(e) => onWorkspaceNameChange(e.target.value)}\n                  required\n                  aria-required=\"true\"\n                />\n              </Field>\n\n              <Field>\n                <FieldLabel htmlFor=\"workspace-setup-01-slug\">\n                  Workspace URL <RequiredMark />\n                </FieldLabel>\n                <InputGroup dir=\"ltr\">\n                  <InputGroupAddon align=\"inline-start\">\n                    <InputGroupText>app.example.com/</InputGroupText>\n                  </InputGroupAddon>\n                  <InputGroupInput\n                    id=\"workspace-setup-01-slug\"\n                    name=\"workspaceSlug\"\n                    type=\"text\"\n                    autoComplete=\"off\"\n                    spellCheck={false}\n                    placeholder=\"acme\"\n                    value={slug}\n                    onChange={(e) => {\n                      setSlugTouched(true)\n                      setSlug(slugify(e.target.value))\n                    }}\n                    required\n                    aria-required=\"true\"\n                    aria-describedby=\"workspace-setup-01-slug-hint\"\n                  />\n                </InputGroup>\n                <FieldDescription id=\"workspace-setup-01-slug-hint\">\n                  Lowercase letters, numbers, and hyphens.\n                </FieldDescription>\n              </Field>\n\n              <div className=\"grid grid-cols-1 gap-5 sm:grid-cols-2\">\n                <Field>\n                  <FieldLabel htmlFor=\"workspace-setup-01-role\">\n                    Your role <RequiredMark />\n                  </FieldLabel>\n                  <Select value={role} onValueChange={setRole}>\n                    <SelectTrigger\n                      id=\"workspace-setup-01-role\"\n                      className=\"w-full cursor-pointer\"\n                      aria-required=\"true\"\n                    >\n                      <SelectValue placeholder=\"Select role\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      {ROLES.map((item) => (\n                        <SelectItem\n                          key={item.value}\n                          value={item.value}\n                          className=\"cursor-pointer\"\n                        >\n                          {item.label}\n                        </SelectItem>\n                      ))}\n                    </SelectContent>\n                  </Select>\n                </Field>\n\n                <Field>\n                  <FieldLabel htmlFor=\"workspace-setup-01-team-size\">\n                    Team size <RequiredMark />\n                  </FieldLabel>\n                  <Select value={teamSize} onValueChange={setTeamSize}>\n                    <SelectTrigger\n                      id=\"workspace-setup-01-team-size\"\n                      className=\"w-full cursor-pointer\"\n                      aria-required=\"true\"\n                    >\n                      <SelectValue placeholder=\"Select size\" />\n                    </SelectTrigger>\n                    <SelectContent>\n                      {TEAM_SIZES.map((item) => (\n                        <SelectItem\n                          key={item.value}\n                          value={item.value}\n                          className=\"cursor-pointer\"\n                        >\n                          {item.label}\n                        </SelectItem>\n                      ))}\n                    </SelectContent>\n                  </Select>\n                </Field>\n              </div>\n\n              <Separator />\n\n              <Field orientation=\"horizontal\" className=\"items-start gap-3\">\n                <Checkbox\n                  id=\"workspace-setup-01-terms\"\n                  checked={accepted}\n                  onCheckedChange={(value) => setAccepted(value === true)}\n                  className=\"cursor-pointer\"\n                  aria-required=\"true\"\n                />\n                <div className=\"grid gap-1 leading-none\">\n                  <FieldLabel\n                    htmlFor=\"workspace-setup-01-terms\"\n                    className=\"cursor-pointer font-normal\"\n                  >\n                    I agree to the Terms of Service and Privacy Policy{\" \"}\n                    <RequiredMark />\n                  </FieldLabel>\n                  <FieldDescription>\n                    You can invite teammates right after create.\n                  </FieldDescription>\n                </div>\n              </Field>\n\n              <div className=\"flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end\">\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  className=\"cursor-pointer\"\n                >\n                  Cancel\n                </Button>\n                <Button\n                  type=\"submit\"\n                  disabled={!accepted}\n                  className=\"cursor-pointer disabled:cursor-not-allowed\"\n                >\n                  Create workspace\n                </Button>\n              </div>\n            </FieldGroup>\n          </div>\n        </form>\n      </div>\n    </div>\n  )\n}\n",
