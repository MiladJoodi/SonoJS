      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { MailIcon } from \"lucide-react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\nimport { Label } from \"@/components/ui/label\"\nimport { cn } from \"@/lib/utils\"\n\nconst RESEND_SECONDS = 30\n\nexport default function OtpVerificationForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [otp, setOtp] = React.useState(\"\")\n  const [seconds, setSeconds] = React.useState(RESEND_SECONDS)\n\n  React.useEffect(() => {\n    if (seconds <= 0) return\n    const id = window.setTimeout(() => setSeconds((s) => s - 1), 1000)\n    return () => window.clearTimeout(id)\n  }, [seconds])\n\n  const ready = otp.length === 6\n\n  return (\n    <div\n      className={cn(\n        \"flex w-full flex-col gap-6 rounded-[12px] border border-border/70 bg-card p-6 shadow-soft sm:p-8\",\n        className\n      )}\n      {...props}\n    >\n      <header className=\"flex flex-col items-center gap-3 text-center\">\n        <span className=\"flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary\">\n          <MailIcon className=\"size-5\" aria-hidden />\n        </span>\n        <div className=\"space-y-1.5\">\n          <h1 className=\"text-h3 font-semibold tracking-tight text-foreground\">\n            Check your email\n          </h1>\n          <p className=\"text-sm text-muted-foreground\">\n            Enter the 6-digit code sent to{\" \"}\n            <span dir=\"ltr\" className=\"font-medium text-foreground\">\n              a***@company.com\n            </span>\n          </p>\n        </div>\n      </header>\n\n      <form\n        className=\"flex flex-col items-center gap-4\"\n        onSubmit={(event) => event.preventDefault()}\n      >\n        <div className=\"flex w-full flex-col items-center gap-2\">\n          <Label htmlFor=\"otp-01\" className=\"sr-only\">\n            Email verification code\n          </Label>\n          <InputOTP\n            id=\"otp-01\"\n            maxLength={6}\n            value={otp}\n            onChange={setOtp}\n            autoFocus\n            containerClassName=\"justify-center\"\n          >\n            <InputOTPGroup>\n              <InputOTPSlot index={0} />\n              <InputOTPSlot index={1} />\n              <InputOTPSlot index={2} />\n            </InputOTPGroup>\n            <InputOTPSeparator />\n            <InputOTPGroup>\n              <InputOTPSlot index={3} />\n              <InputOTPSlot index={4} />\n              <InputOTPSlot index={5} />\n            </InputOTPGroup>\n          </InputOTP>\n        </div>\n\n        <Button\n          type=\"submit\"\n          className=\"mt-1 w-full cursor-pointer\"\n          disabled={!ready}\n        >\n          Verify email\n        </Button>\n      </form>\n\n      <div className=\"flex flex-col items-center gap-2 text-center text-sm\">\n        {seconds > 0 ? (\n          <p className=\"text-muted-foreground\" dir=\"ltr\">\n            Resend code in {seconds}s\n          </p>\n        ) : (\n          <button\n            type=\"button\"\n            className=\"cursor-pointer font-medium text-primary underline-offset-4 hover:underline\"\n            onClick={() => {\n              setSeconds(RESEND_SECONDS)\n              setOtp(\"\")\n            }}\n          >\n            Resend code\n          </button>\n        )}\n        <a\n          href=\"#\"\n          className=\"cursor-pointer text-muted-foreground underline-offset-4 hover:text-foreground hover:underline\"\n        >\n          Use a different email\n        </a>\n      </div>\n    </div>\n  )\n}\n",
