      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  AlertCircleIcon,\n  CheckCircle2Icon,\n  DownloadIcon,\n  FileSpreadsheetIcon,\n  Loader2Icon,\n  RefreshCwIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Separator } from \"@/components/ui/separator\"\nimport { cn } from \"@/lib/utils\"\n\ntype ExportStatus = \"ready\" | \"processing\" | \"failed\" | \"expired\"\n\ninterface ExportJob {\n  id: string\n  name: string\n  format: string\n  records: number\n  size: string\n  createdAt: string\n  status: ExportStatus\n}\n\nconst INITIAL: ExportJob[] = [\n  {\n    id: \"ex_1\",\n    name: \"Customers · Last 30 days\",\n    format: \"CSV\",\n    records: 1842,\n    size: \"2.4 MB\",\n    createdAt: \"Jun 22, 2026 · 14:12\",\n    status: \"ready\",\n  },\n  {\n    id: \"ex_2\",\n    name: \"Orders · Full dump\",\n    format: \"XLSX\",\n    records: 12_480,\n    size: \"—\",\n    createdAt: \"Jun 22, 2026 · 14:18\",\n    status: \"processing\",\n  },\n  {\n    id: \"ex_3\",\n    name: \"Analytics · Q2\",\n    format: \"JSON\",\n    records: 0,\n    size: \"—\",\n    createdAt: \"Jun 21, 2026 · 09:04\",\n    status: \"failed\",\n  },\n  {\n    id: \"ex_4\",\n    name: \"Invoices · May\",\n    format: \"CSV\",\n    records: 906,\n    size: \"890 KB\",\n    createdAt: \"May 31, 2026 · 18:40\",\n    status: \"expired\",\n  },\n]\n\nfunction statusBadge(status: ExportStatus) {\n  switch (status) {\n    case \"ready\":\n      return (\n        <Badge className=\"gap-1 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300\">\n          <CheckCircle2Icon className=\"size-3\" aria-hidden />\n          Ready\n        </Badge>\n      )\n    case \"processing\":\n      return (\n        <Badge variant=\"secondary\" className=\"gap-1\">\n          <Loader2Icon className=\"size-3 animate-spin\" aria-hidden />\n          Processing\n        </Badge>\n      )\n    case \"failed\":\n      return (\n        <Badge variant=\"destructive\" className=\"gap-1\">\n          <AlertCircleIcon className=\"size-3\" aria-hidden />\n          Failed\n        </Badge>\n      )\n    default:\n      return <Badge variant=\"outline\">Expired</Badge>\n  }\n}\n\nexport default function DataExport({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [jobs, setJobs] = React.useState(INITIAL)\n\n  const retry = (id: string) => {\n    setJobs((prev) =>\n      prev.map((j) =>\n        j.id === id\n          ? {\n              ...j,\n              status: \"processing\",\n              size: \"—\",\n              createdAt: \"Just now\",\n            }\n          : j\n      )\n    )\n    window.setTimeout(() => {\n      setJobs((prev) =>\n        prev.map((j) =>\n          j.id === id && j.status === \"processing\"\n            ? {\n                ...j,\n                status: \"ready\",\n                size: \"1.1 MB\",\n                records: j.records || 420,\n                createdAt: \"Just now\",\n              }\n            : j\n        )\n      )\n    }, 1600)\n  }\n\n  return (\n    <div\n      className={cn(\n        \"flex w-full justify-center bg-white px-4 py-10 text-foreground dark:bg-background sm:px-6 sm:py-14\",\n        className\n      )}\n      {...props}\n    >\n      <section\n        className=\"w-full max-w-2xl overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\"\n        aria-labelledby=\"data-export-04-heading\"\n      >\n        <header className=\"flex flex-col gap-3 border-b border-border/70 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6\">\n          <div className=\"text-start\">\n            <h1\n              id=\"data-export-04-heading\"\n              className=\"text-lg font-semibold tracking-tight\"\n            >\n              Export history\n            </h1>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Downloads expire after 7 days. Retry failed jobs anytime.\n            </p>\n          </div>\n          <Badge variant=\"secondary\">{jobs.length} jobs</Badge>\n        </header>\n\n        <ul>\n          {jobs.map((job, index) => (\n            <li key={job.id}>\n              {index > 0 ? <Separator /> : null}\n              <div className=\"flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between sm:px-6\">\n                <div className=\"flex min-w-0 items-start gap-3 text-start\">\n                  <span className=\"mt-0.5 flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/60 text-muted-foreground\">\n                    <FileSpreadsheetIcon className=\"size-5\" aria-hidden />\n                  </span>\n                  <div className=\"min-w-0\">\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      <p className=\"truncate text-sm font-semibold\">\n                        {job.name}\n                      </p>\n                      {statusBadge(job.status)}\n                    </div>\n                    <p className=\"mt-1 text-xs text-muted-foreground\">\n                      {job.format}\n                      {job.records > 0 ? (\n                        <>\n                          {\" · \"}\n                          <span dir=\"ltr\">\n                            {job.records.toLocaleString(\"en-US\")} records\n                          </span>\n                        </>\n                      ) : null}\n                      {job.size !== \"—\" ? (\n                        <>\n                          {\" · \"}\n                          <span dir=\"ltr\">{job.size}</span>\n                        </>\n                      ) : null}\n                    </p>\n                    <p className=\"mt-0.5 text-xs text-muted-foreground\">\n                      {job.createdAt}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex shrink-0 gap-2 sm:ps-2\">\n                  {job.status === \"ready\" ? (\n                    <Button\n                      type=\"button\"\n                      size=\"sm\"\n                      className=\"cursor-pointer gap-1.5\"\n                    >\n                      <DownloadIcon className=\"size-3.5\" aria-hidden />\n                      Download\n                    </Button>\n                  ) : null}\n                  {job.status === \"failed\" ? (\n                    <Button\n                      type=\"button\"\n                      size=\"sm\"\n                      variant=\"outline\"\n                      className=\"cursor-pointer gap-1.5\"\n                      onClick={() => retry(job.id)}\n                    >\n                      <RefreshCwIcon className=\"size-3.5\" aria-hidden />\n                      Retry\n                    </Button>\n                  ) : null}\n                  {job.status === \"processing\" ? (\n                    <Button\n                      type=\"button\"\n                      size=\"sm\"\n                      variant=\"secondary\"\n                      className=\"cursor-not-allowed gap-1.5\"\n                      disabled\n                    >\n                      <Loader2Icon className=\"size-3.5 animate-spin\" aria-hidden />\n                      Working…\n                    </Button>\n                  ) : null}\n                  {job.status === \"expired\" ? (\n                    <Button\n                      type=\"button\"\n                      size=\"sm\"\n                      variant=\"outline\"\n                      className=\"cursor-pointer gap-1.5\"\n                      onClick={() => retry(job.id)}\n                    >\n                      <RefreshCwIcon className=\"size-3.5\" aria-hidden />\n                      Re-run\n                    </Button>\n                  ) : null}\n                </div>\n              </div>\n            </li>\n          ))}\n        </ul>\n      </section>\n    </div>\n  )\n}\n",
      "target": "components/blocks/files-media/data-export-04/data-export.tsx"
    }
  ],
