027-.035a.853.853 0 0 0 .11-.234c0-.019.012-.038.016-.057a.95.95 0 0 0 .016-.12V11.158c0-.029 0-.038-.008-.057a.778.778 0 0 0-.61-.613h-.03a.864.864 0 0 0-.12-.014zM13.396 15.117l1.21 1.203 5.909-5.909c.192-.188.443-.305.71-.331-1.045-.8-2.184-.59-7.829 5.037zM22.207 12.077l-.072.07-6.24 5.475 1.061 1.06c2.63-2.488 4.965-4.858 5.251-6.605zM6.643 24.904a.057.057 0 0 0 .051.042l2.72.187-1.525-1.525-1.233 1.232a.06.06 0 0 0-.013.064zM8.174 23.325l1.608 1.608a.122.122 0 0 0 .152.02.12.12 0 0 0 .062-.139l-.27-1.155a.346.346 0 0 1 .178-.385c2.819-1.413 5.092-2.868 6.761-4.32l-1.12-1.12-2.4.516zM15.201 17.494l-.602-.601-.831.83a.04.04 0 0 0 0 .051.038.038 0 0 0 .046.021z\" />\n      </g>\n      <path\n        fill=\"#ff6c37\"\n        d=\"M25.404 8.11a.185.185 0 1 0-.33.16.557.557 0 0 1-.07.602.185.185 0 0 0 .285.237.926.926 0 0 0 .115-.999z\"\n      />\n    </svg>\n  )\n}\n\nfunction OperaIcon({ className }: { className?: string }) {\n  const uid = React.useId()\n  const gradA = `${uid}-opera-a`\n  const gradB = `${uid}-opera-b`\n\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      className={cn(\"size-[18px] shrink-0\", className)}\n      viewBox=\"0 0 512.001 512.001\"\n      aria-hidden\n    >\n      <defs>\n        <linearGradient\n          id={gradA}\n          x1=\"213.312\"\n          x2=\"213.312\"\n          y1=\"8.348\"\n          y2=\"504.55\"\n          gradientUnits=\"userSpaceOnUse\"\n        >\n          <stop offset=\".3\" stopColor=\"#ff1b2d\" />\n          <stop offset=\".438\" stopColor=\"#fa1a2c\" />\n          <stop offset=\".594\" stopColor=\"#ed1528\" />\n          <stop offset=\".758\" stopColor=\"#d60e21\" />\n          <stop offset=\".927\" stopColor=\"#b70519\" />\n          <stop offset=\"1\" stopColor=\"#a70014\" />\n        </linearGradient>\n        <linearGradient\n          id={gradB}\n          x1=\"341.868\"\n          x2=\"341.868\"\n          y1=\"37.594\"\n          y2=\"476.46\"\n          gradientUnits=\"userSpaceOnUse\"\n        >\n          <stop offset=\"0\" stopColor=\"#9c0000\" />\n          <stop offset=\".7\" stopColor=\"#ff4b4b\" />\n        </linearGradient>\n      </defs>\n      <path\n        fill={`url(#${gradA})`}\n        d=\"M171.737 400.271c-28.302-33.411-46.637-82.808-47.882-138.238-.004-.143-.004-11.918 0-12.061 1.245-55.429 19.579-104.825 47.88-138.235 36.728-47.692 91.843-66.439 152.807-66.439 37.504 0 102.081 19.869 102.081 19.869C381.558 24.848 322.138.253 256.968.012c-.323-.001-.644-.012-.967-.012-141.385 0-256 114.615-256 256.001 0 137.295 108.085 249.338 243.808 255.704 4.042.19 8.104.297 12.192.297 65.542 0 125.317-24.642 170.604-65.151 0 0-62.116 14.14-99.614 14.14-60.965-.001-118.528-13.03-155.254-60.72z\"\n      />\n      <path\n        fill={`url(#${gradB})`}\n        d=\"M171.735 111.737c23.489-27.729 53.836-44.453 86.982-44.453 74.523 0 134.936 84.493 134.936 188.719S333.24 444.721 258.717 444.721c-33.145 0-63.492-16.724-86.98-44.451 36.726 47.69 91.319 77.93 152.283 77.93 37.498 0 72.581-11.448 102.585-31.351 52.404-46.876 85.396-115.005 85.396-190.849 0-75.836-32.984-143.958-85.378-190.834-30.008-19.91-65.099-31.362-102.603-31.362-60.964.001-115.558 30.242-152.285 77.933z\"\n      />\n    </svg>\n  )\n}\n\nfunction SlackIcon({ className }: { className?: string }) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      className={cn(\"size-[18px] shrink-0\", className)}\n      viewBox=\"0 0 24 24\"\n      aria-hidden\n    >\n      <path\n        fill=\"#e91e63\"\n        d=\"M8.843 12.651a2.521 2.521 0 0 0-2.521 2.521v6.306a2.521 2.521 0 0 0 5.042 0v-6.306a2.523 2.523 0 0 0-2.521-2.521zM.019 15.172a2.524 2.524 0 0 0 5.046 0v-2.523H2.542a2.524 2.524 0 0 0-2.523 2.523z\"\n      />\n      <path\n        fill=\"#00bcd4\"\n        d=\"M8.846-.001h-.003a2.524 2.524 0 0 0 0 5.046h2.521V2.517A2.519 2.519 0 0 0 8.846-.001zM2.525 11.37h6.318a2.524 2.524 0 0 0 0-5.046H2.525a2.524 2.524 0 0 0 0 5.046z\"\n      />\n      <path\n        fill=\"#4caf50\"\n        d=\"M21.457 6.323a2.518 2.518 0 0 0-2.518 2.518v2.528h2.521a2.524 2.524 0 0 0 0-5.046h-.003zm-8.816-3.801v6.325a2.521 2.521 0 0 0 5.042 0V2.522a2.521 2.521 0 0 0-5.042 0z\"\n      />\n      <path\n        fill=\"#ff9800\"\n        d=\"M17.682 21.476a2.521 2.521 0 0 0-2.521-2.521H12.64v2.523a2.521 2.521 0 0 0 5.042-.002zm3.797-8.827h-6.318a2.524 2.524 0 0 0 0 5.046h6.318a2.524 2.524 0 0 0 0-5.046z\"\n      />\n    </svg>\n  )\n}\n\nfunction LoomIcon({ className }: { className?: string }) {\n  return (\n    <svg\n      viewBox=\"0 0 30 30\"\n      fill=\"none\"\n      className={cn(\"size-[18px] shrink-0\", className)}\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden\n    >\n      <path\n        d=\"M30.01 13.43h-9.142l7.917-4.57-1.57-2.72-7.918 4.57 4.57-7.915-2.72-1.57-4.571 7.913V0h-3.142v9.139L8.863 1.225l-2.721 1.57 4.57 7.913L2.796 6.14 1.225 8.86l7.917 4.57H0v3.141h9.141l-7.916 4.57 1.57 2.72 7.918-4.57-4.571 7.915 2.72 1.57 4.572-7.914V30h3.142v-9.334l4.655 8.06 2.551-1.472-4.656-8.062 8.087 4.668 1.571-2.72-7.916-4.57h9.141v-3.14h.001zm-15.005 5.84a4.271 4.271 0 11-.001-8.542 4.271 4.271 0 01.001 8.542z\"\n        fill=\"#5531A7\"\n      />\n    </svg>\n  )\n}\n\nfunction DropboxIcon({ className }: { className?: string }) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      className={cn(\"size-[18px] shrink-0\", className)}\n      viewBox=\"0 0 64 64\"\n      aria-hidden\n    >\n      <g fill=\"#0756dc\" fillRule=\"evenodd\">\n        <path d=\"m48 33.688-9.414 6.146L32 34.336l-6.586 5.498L16 33.688l6.508-5.212L16 23.264l9.414-6.146L32 22.614l6.586-5.496L48 23.264l-6.508 5.212zm-6.548 7.536L32.02 46.88l-9.434-5.656v-2.068L25.414 41l6.606-5.482L38.626 41l2.826-1.844zM32 0C14.326 0 0 14.326 0 32c0 17.672 14.326 32 32 32s32-14.328 32-32C64 14.326 49.674 0 32 0z\" />\n        <path d=\"M22.509 28.475 32 34.335l9.49-5.86-9.49-5.86z\" />\n      </g>\n    </svg>\n  )\n}\n\nconst DEFAULT_ROWS: AppRow[] = [\n  {\n    id: \"figma\",\n    name: \"Figma\",\n    icon: <FigmaIcon />,\n    version: \"120.1.0\",\n    deviceCount: 5,\n    coverage: 14,\n    firstSeen: \"Jul 1, 2025\",\n    issues: 0,\n  },\n  {\n    id: \"safari\",\n    name: \"Safari\",\n    icon: <SafariIcon />,\n    version: \"17.1\",\n    deviceCount: 36,\n    coverage: 100,\n    firstSeen: \"Jun 26, 2025\",\n    issues: 0,\n  },\n  {\n    id: \"canva\",\n    name: \"Canva\",\n    icon: <CanvaIcon />,\n    version: \"11.0.2\",\n    deviceCount: 3,\n    coverage: 8,\n    firstSeen: \"Jun 29, 2025\",\n    issues: 1,\n  },\n  {\n    id: \"grammarly\",\n    name: \"Grammarly\",\n    icon: <GrammarlyIcon />,\n    version: \"6 versions\",\n    deviceCount: 12,\n    coverage: 33,\n    firstSeen: \"Jun 30, 2025\",\n    issues: 0,\n  },\n  {\n    id: \"notion\",\n    name: \"Notion\",\n    icon: <NotionIcon />,\n    version: \"3.3.0\",\n    deviceCount: 35,\n    coverage: 97,\n    firstSeen: \"Jun 25, 2025\",\n    issues: 0,\n  },\n  {\n    id: \"postman\",\n    name: \"Postman\",\n    icon: <PostmanIcon />,\n    version: \"11.0.0\",\n    deviceCount: 7,\n    coverage: 19,\n    firstSeen: \"Jun 28, 2025\",\n    issues: 2,\n  },\n  {\n    id: \"opera\",\n    name: \"Opera\",\n    icon: <OperaIcon />,\n    version: \"129.0.2\",\n    deviceCount: 8,\n    coverage: 22,\n    firstSeen: \"Jul 2, 2025\",\n    issues: 1,\n  },\n  {\n    id: \"slack\",\n    name: \"Slack\",\n    icon: <SlackIcon />,\n    version: \"10.2.0\",\n    deviceCount: 36,\n    coverage: 100,\n    firstSeen: \"Jun 15, 2025\",\n    issues: 0,\n  },\n  {\n    id: \"loom\",\n    name: \"Loom\",\n    icon: <LoomIcon />,\n    version: \"2.1.1\",\n    deviceCount: 31,\n    coverage: 86,\n    firstSeen: \"Jul 4, 2025\",\n    issues: 0,\n  },\n  {\n    id: \"dropbox\",\n    name: \"Dropbox\",\n    icon: <DropboxIcon />,\n    version: \"201.4.0\",\n    deviceCount: 4,\n    coverage: 11,\n    firstSeen: \"Jun 27, 2025\",\n    issues: 0,\n  },\n]\n\nconst PAGES = [1, 2, 3, 4, 5, 6] as const\n\nconst FILTERS: { id: StatusFilter; label: string }[] = [\n  { id: \"all\", label: \"All apps\" },\n  { id: \"healthy\", label: \"Healthy\" },\n  { id: \"issues\", label: \"Needs review\" },\n]\n\nexport default function AdvancedDataGrid({\n  rows = DEFAULT_ROWS,\n  className,\n  ...props\n}: React.ComponentProps<\"section\"> & {\n  rows?: AppRow[]\n}) {\n  const searchId = React.useId()\n  const [query, setQuery] = React.useState(\"\")\n  const [filter, setFilter] = React.useState<StatusFilter>(\"all\")\n  const [page, setPage] = React.useState(1)\n\n  const healthyCount = rows.filter((row) => row.issues === 0).length\n  const issueCount = rows.filter((row) => row.issues > 0).length\n\n  const q = query.trim().toLowerCase()\n  const filtered = rows.filter((row) => {\n    if (filter === \"healthy\" && row.issues > 0) return false\n    if (filter === \"issues\" && row.issues === 0) return false\n    if (!q) return true\n    return [row.name, row.version, row.firstSeen]\n      .join(\" \")\n      .toLowerCase()\n      .includes(q)\n  })\n\n  const statusBadge = (row: AppRow) => {\n    const healthy = row.issues === 0\n    return (\n      <span\n        className={cn(\n          \"inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium\",\n          healthy\n            ? \"bg-emerald-500/10 text-emerald-700 dark:text-emerald-400\"\n            : \"bg-amber-500/10 text-amber-700 dark:text-amber-400\"\n        )}\n      >\n        {healthy ? (\n          <CheckCircle2Icon className=\"size-3.5 shrink-0\" aria-hidden />\n        ) : (\n          <AlertTriangleIcon className=\"size-3.5 shrink-0\" aria-hidden />\n        )}\n        {healthy\n          ? \"Healthy\"\n          : `${row.issues} issue${row.issues === 1 ? \"\" : \"s\"}`}\n      </span>\n    )\n  }\n\n  const coverageMeter = (row: AppRow) => (\n    <div className=\"w-full min-w-0\">\n      <div className=\"mb-1.5 flex items-center justify-between gap-3 text-xs\">\n        <span className=\"text-muted-foreground\">\n          {row.deviceCount} devices\n        </span>\n        <span className=\"font-medium text-foreground tabular-nums\">\n          {row.coverage}%\n        </span>\n      </div>\n      <div className=\"flex h-1.5 w-full overflow-hidden rounded-full bg-muted\">\n        <div\n          className={cn(\n            \"h-full rounded-full transition-[width]\",\n            row.coverage >= 80\n              ? \"bg-emerald-600 dark:bg-emerald-500\"\n              : row.coverage >= 30\n                ? \"bg-primary\"\n                : \"bg-amber-500\"\n          )}\n          style={{ width: `${row.coverage}%` }}\n        />\n      </div>\n    </div>\n  )\n\n  return (\n    <section\n      className={cn(\n        \"w-full min-w-0 bg-card px-4 py-8 sm:py-12 md:px-8 md:py-16\",\n        className\n      )}\n      aria-label=\"Application security inventory\"\n      {...props}\n    >\n      <div className=\"mx-auto w-full min-w-0 max-w-7xl\">\n        <div className=\"mb-6 flex flex-col gap-5 sm:mb-8 sm:gap-6 lg:flex-row lg:items-end lg:justify-between\">\n          <div className=\"min-w-0 max-w-xl text-start\">\n            <div className=\"mb-3 inline-flex max-w-full items-center gap-2 rounded-full border border-border/70 bg-muted/40 px-3 py-1 text-xs font-medium text-muted-foreground\">\n              <ShieldCheckIcon\n                className=\"size-3.5 shrink-0 text-primary\"\n                aria-hidden\n              />\n              <span className=\"truncate\">Device fleet inventory</span>\n            </div>\n            <h2 className=\"text-h3 font-semibold tracking-tight text-foreground\">\n              Installed applications\n            </h2>\n            <p className=\"mt-2 text-sm text-muted-foreground\">\n              Monitor versions, coverage, and security posture across the\n              organization.\n            </p>\n          </div>\n\n          <form\n            className=\"w