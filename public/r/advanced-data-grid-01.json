      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  AlertTriangleIcon,\n  CheckCircle2Icon,\n  ChevronLeftIcon,\n  ChevronRightIcon,\n  SearchIcon,\n  ShieldCheckIcon,\n} from \"lucide-react\"\n\nimport { cn } from \"@/lib/utils\"\n\ntype AppRow = {\n  id: string\n  name: string\n  version: string\n  deviceCount: number\n  coverage: number\n  firstSeen: string\n  issues: number\n  icon: React.ReactNode\n}\n\ntype StatusFilter = \"all\" | \"healthy\" | \"issues\"\n\nfunction FigmaIcon({ className }: { className?: string }) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      className={cn(\"size-[18px] shrink-0\", className)}\n      viewBox=\"0 0 512 512\"\n      aria-hidden\n    >\n      <path\n        fill=\"#00bcff\"\n        d=\"M256.599 256c0-47.128 38.205-85.333 85.333-85.333s85.333 38.206 85.333 85.333c0 47.129-38.206 85.333-85.333 85.333-47.129 0-85.333-38.205-85.333-85.333z\"\n      />\n      <path\n        fill=\"#00cf7f\"\n        d=\"M85.932 426.667c0-47.128 38.205-85.333 85.333-85.333l45.475-24.009 39.858 24.009v85.333c0 47.129-38.205 85.333-85.333 85.333s-85.333-38.205-85.333-85.333z\"\n      />\n      <path\n        fill=\"#ff7361\"\n        d=\"m256.599 0-46.434 80.67 46.434 89.996h84.136c47.129 0 85.333-38.205 85.333-85.333S387.863 0 340.735 0z\"\n      />\n      <path\n        fill=\"#ff4d12\"\n        d=\"M84.734 85.333c0 47.128 38.205 85.333 85.333 85.333l45.267 17.484 41.263-17.484V0h-86.531c-47.127 0-85.332 38.205-85.332 85.333z\"\n      />\n      <path\n        fill=\"#b659ff\"\n        d=\"M85.932 256c0 47.129 38.205 85.333 85.333 85.333h85.333V170.666h-85.333c-47.128 0-85.333 38.206-85.333 85.334z\"\n      />\n    </svg>\n  )\n}\n\nfunction SafariIcon({ className }: { className?: string }) {\n  return (\n    <svg\n      xmlns=\"http://www.w3.org/2000/svg\"\n      className={cn(\"size-[18px] shrink-0\", className)}\n      viewBox=\"0 0 512 512\"\n      aria-hidden\n    >\n      <circle cx=\"2