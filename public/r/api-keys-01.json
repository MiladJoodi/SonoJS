      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ActivityIcon,\n  AlertCircleIcon,\n  CheckIcon,\n  CopyIcon,\n  EllipsisVerticalIcon,\n  KeyRoundIcon,\n  PlusIcon,\n  ShieldAlertIcon,\n  Trash2Icon,\n} from \"lucide-react\"\n\nimport { Alert, AlertDescription, AlertTitle } from \"@/components/ui/alert\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Card,\n  CardContent,\n} from \"@/components/ui/card\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\nconst API_KEYS = [\n  {\n    id: \"key_1\",\n    name: \"Production API Key\",\n    token: \"sk_live_••••••••••••••••••••3f8a\",\n    environment: \"live\" as const,\n    lastUsed: \"10 mins ago\",\n    created: \"Oct 12, 2026\",\n  },\n  {\n    id: \"key_2\",\n    name: \"Staging Webhooks\",\n    token: \"sk_test_••••••••••••••••••••9d2c\",\n    environment: \"test\" as const,\n    lastUsed: \"2 days ago\",\n    created: \"Oct 15, 2026\",\n  },\n  {\n    id: \"key_3\",\n    name: \"Developer Sandbox - Alex\",\n    token: \"sk_test_••••••••••••••••••••1b4e\",\n    environment: \"test\" as const,\n    lastUsed: \"Never\",\n    created: \"Oct 24, 2026\",\n  },\n]\n\nfunction CopyTokenButton({ value }: { value: string }) {\n  const [copied, setCopied] = React.useState(false)\n\n  return (\n    <Button\n      type=\"button\"\n      variant=\"ghost\"\n      size=\"icon-sm\"\n      className=\"size-8 shrink-0 text-muted-foreground\"\n      aria-label={copied ? \"Copied\" : \"Copy token\"}\n      onClick={async () => {\n        try {\n          await navigator.clipboard.writeText(value)\n          setCopied(true)\n          window.setTimeout(() => setCopied(false), 1500)\n        } catch {\n          /* ignore */\n        }\n      }}\n    >\n      {copied ? (\n        <CheckIcon className=\"size-3.5\" aria-hidden />\n      ) : (\n        <CopyIcon className=\"size-3.5\" aria-hidden />\n      )}\n    </Button>\n  )\n}\n\nexport default function ApiKeys({\n  className,\n  ...props\n}: React.ComponentProps<\"main\">) {\n  const [createOpen, setCreateOpen] = React.useState(false)\n\n  return (\n    <main\n      className={cn(\n        \"w-full min-w-0 bg-canvas px-4 py-10 text-foreground sm:px-6\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-5xl space-y-8\">\n        <div className=\"flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center\">\n          <div className=\"min-w-0 text-start\">\n            <h1 className=\"text-2xl font-semibold tracking-tight text-foreground\">\n              API Keys\n            </h1>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Manage your API keys for programmatic access to the platform.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <Button type=\"button\" variant=\"outline\">\n              <ShieldAlertIcon className=\"size-4\" aria-hidden />\n              Roll All Keys\n            </Button>\n            <Button type=\"button\" onClick={() => setCreateOpen(true)}>\n              <PlusIcon className=\"size-4\" aria-hidden />\n              Create new key\n            </Button>\n          </div>\n        </div>\n\n        <Alert className=\"border-primary/20 bg-primary/5 text-foreground\">\n          <AlertCircleIcon className=\"text-primary\" aria-hidden />\n          <AlertTitle className=\"text-foreground\">\n            Secret API keys should be kept secure\n          </AlertTitle>\n          <AlertDescription>\n            Do not share your secret API keys in publicly accessible areas such\n            as GitHub, client-side code, and so forth.\n          </AlertDescription>\n        </Alert>\n\n        <Card className=\"overflow-hidden border-border/70 bg-card shadow-soft\">\n          <CardContent className=\"p-0\">\n            <Table>\n              <TableHeader>\n                <TableRow className=\"hover:bg-transparent\">\n                  <TableHead className=\"h-11 px-4\">Name</TableHead>\n                  <TableHead className=\"h-11 px-4\">Token</TableHead>\n                  <TableHead className=\"h-11 px-4\">Environment</TableHead>\n                  <TableHead className=\"h-11 px-4\">Last Used</TableHead>\n                  <TableHead className=\"h-11 px-4 text-end\">Actions</TableHead>\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {API_KEYS.map((key) => (\n                  <TableRow key={key.id}>\n                    <TableCell className=\"px-4 py-3\">\n                      <div className=\"flex min-w-0 flex-col gap-0.5 text-start\">\n                        <span className=\"font-medium text-foreground\">\n                          {key.name}\n                        </span>\n                        <span className=\"text-xs text-muted-foreground\">\n                          Created {key.created}\n                        </span>\n                      </div>\n                    </TableCell>\n                    <TableCell className=\"px-4 py-3\">\n                      <div className=\"flex min-w-0 items-center gap-2 font-mono text-sm text-foreground\">\n                        <KeyRoundIcon\n                          className=\"size-4 shrink-0 text-muted-foreground\"\n                          aria-hidden\n                        />\n                        <span className=\"min-w-0 truncate\" dir=\"ltr\">\n                          {key.token}\n                        </span>\n                        <CopyTokenButton value={key.token} />\n                      </div>\n                    </TableCell>\n                    <TableCell className=\"px-4 py-3\">\n                      <Badge\n                        variant={\n                          key.environment === \"live\" ? \"default\" : \"secondary\"\n                        }\n                        className=\"uppercase tracking-wider\"\n                      >\n                        {key.environment}\n                      </Badge>\n                    </TableCell>\n                    <TableCell className=\"px-4 py-3 text-sm text-muted-foreground\">\n                      {key.lastUsed}\n                    </TableCell>\n                    <TableCell className=\"px-4 py-3 text-end\">\n                      <DropdownMenu>\n                        <DropdownMenuTrigger asChild>\n                          <Button\n                            type=\"button\"\n                            variant=\"ghost\"\n                            size=\"icon-sm\"\n                            className=\"size-8\"\n                            aria-label={`Actions for ${key.name}`}\n                          >\n                            <EllipsisVerticalIcon\n                              className=\"size-4\"\n                              aria-hidden\n                            />\n                          </Button>\n                        </DropdownMenuTrigger>\n                        <DropdownMenuContent align=\"end\" className=\"w-48\">\n                          <DropdownMenuItem>\n                            <ActivityIcon className=\"size-4\" aria-hidden />\n                            View Usage Logs\n                          </DropdownMenuItem>\n                          <DropdownMenuSeparator />\n                          <DropdownMenuItem variant=\"destructive\">\n                            <Trash2Icon className=\"size-4\" aria-hidden />\n                            Revoke Key\n                          </DropdownMenuItem>\n                        </DropdownMenuContent>\n                      </DropdownMenu>\n                    </TableCell>\n                  </TableRow>\n                ))}\n              </TableBody>\n            </Table>\n          </CardContent>\n        </Card>\n      </div>\n\n      <Dialog open={createOpen} onOpenChange={setCreateOpen}>\n        <DialogContent\n          className=\"gap-0 p-0 sm:max-w-md\"\n          style={{ maxWidth: \"min(28rem, calc(100% - 2rem))\" }}\n        >\n          <DialogHeader className=\"border-b border-border/70 px-6 py-5\">\n            <DialogTitle>Create API Key</DialogTitle>\n            <DialogDescription>\n              Generate a new secret key for API access.\n            </DialogDescription>\n          </DialogHeader>\n\n          <div className=\"space-y-6 px-6 py-5\">\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"api-keys-01-name\">\n                Key Name <span className=\"text-destructive\">*</span>\n              </Label>\n              <Input\n                id=\"api-keys-01-name\"\n                placeholder=\"e.g. Production Billing\"\n                autoComplete=\"off\"\n              />\n            </div>\n\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"api-keys-01-env\">\n                Environment <span className=\"text-destructive\">*</span>\n              </Label>\n              <Select defaultValue=\"test\">\n                <SelectTrigger id=\"api-keys-01-env\" className=\"w-full\">\n                  <SelectValue placeholder=\"Select environment\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"test\">Test / Sandbox</SelectItem>\n                  <SelectItem value=\"live\">Live / Production</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n\n            <div className=\"space-y-3\">\n              <p className=\"text-sm font-medium text-foreground\">Permissions</p>\n              <div className=\"space-y-3 rounded-lg border border-border/70 bg-muted/40 p-4\">\n                <div className=\"flex items-start gap-3\">\n                  <Checkbox id=\"api-keys-01-perm-read\" defaultChecked />\n                  <Label\n                    htmlFor=\"api-keys-01-perm-read\"\n                    className=\"font-normal leading-snug\"\n                  >\n                    Read access to all resources\n                  </Label>\n                </div>\n                <div className=\"flex items-start gap-3\">\n                  <Checkbox id=\"api-keys-01-perm-write\" />\n                  <Label\n                    htmlFor=\"api-keys-01-perm-write\"\n                    className=\"font-normal leading-snug\"\n                  >\n                    Write access to all resources\n                  </Label>\n                </div>\n                <div className=\"flex items-start gap-3\">\n                  <Checkbox id=\"api-keys-01-perm-billing\" />\n                  <Label\n                    htmlFor=\"api-keys-01-perm-billing\"\n                    className=\"font-normal leading-snug\"\n                  >\n                    Access to Billing &amp; Invoices\n                  </Label>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <DialogFooter className=\"border-t border-border/70 px-6 py-4\">\n            <DialogClose asChild>\n              <Button type=\"button\" variant=\"ghost\">\n                Cancel\n              </Button>\n            </DialogClose>\n            <Button type=\"button\" onClick={() => setCreateOpen(false)}>\n              Generate Key\n            </Button>\n          </DialogFooter>\n        </DialogContent>\n      </Dialog>\n    </main>\n  )\n}\n",
      "target": "components/blocks/developer-tools/api-keys-01/api-keys.tsx"
    }
  ],
