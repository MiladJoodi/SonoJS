      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowRightIcon,\n  DatabaseIcon,\n  MailIcon,\n  SparklesIcon,\n  UsersIcon,\n  ZapIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Separator } from \"@/components/ui/separator\"\nimport { cn } from \"@/lib/utils\"\n\ntype QuotaTone = \"default\" | \"warning\" | \"danger\" | \"success\"\n\ntype Quota = {\n  id: string\n  label: string\n  detail: string\n  usedLabel: string\n  percent: number\n  status: string\n  tone: QuotaTone\n  icon: React.ElementType\n}\n\nconst QUOTAS: Quota[] = [\n  {\n    id: \"seats\",\n    label: \"Team seats\",\n    detail: \"8 of 10 included\",\n    usedLabel: \"80% used\",\n    percent: 80,\n    status: \"2 left\",\n    tone: \"default\",\n    icon: UsersIcon,\n  },\n  {\n    id: \"api\",\n    label: \"API requests\",\n    detail: \"920K of 1M this month\",\n    usedLabel: \"92% used\",\n    percent: 92,\n    status: \"High usage\",\n    tone: \"warning\",\n    icon: ZapIcon,\n  },\n  {\n    id: \"storage\",\n    label: \"Database storage\",\n    detail: \"4.2 GB of 50 GB\",\n    usedLabel: \"8% used\",\n    percent: 8,\n    status: \"On track\",\n    tone: \"success\",\n    icon: DatabaseIcon,\n  },\n  {\n    id: \"email\",\n    label: \"Transactional email\",\n    detail: \"12,500 of 10,000 sent\",\n    usedLabel: \"125% used\",\n    percent: 100,\n    status: \"Over limit\",\n    tone: \"danger\",\n    icon: MailIcon,\n  },\n]\n\nfunction toneBadge(tone: QuotaTone) {\n  switch (tone) {\n    case \"warning\":\n      return \"bg-amber-500/10 text-amber-700 dark:text-amber-300\"\n    case \"danger\":\n      return \"bg-destructive/10 text-destructive\"\n    case \"success\":\n      return \"bg-emerald-500/10 text-emerald-700 dark:text-emerald-300\"\n    default:\n      return \"\"\n  }\n}\n\nfunction meterFill(tone: QuotaTone) {\n  switch (tone) {\n    case \"warning\":\n      return \"bg-amber-500\"\n    case \"danger\":\n      return \"bg-destructive\"\n    case \"success\":\n      return \"bg-emerald-500\"\n    default:\n      return \"bg-primary\"\n  }\n}\n\nfunction UsageMeter({\n  percent,\n  tone,\n  label,\n}: {\n  percent: number\n  tone: QuotaTone\n  label: string\n}) {\n  const value = Math.min(100, Math.max(0, percent))\n  return (\n    <div\n      className=\"h-1.5 w-full overflow-hidden rounded-full bg-muted\"\n      role=\"meter\"\n      aria-valuemin={0}\n      aria-valuemax={100}\n      aria-valuenow={value}\n      aria-label={label}\n    >\n      <div\n        className={cn(\"h-full rounded-full transition-all\", meterFill(tone))}\n        style={{ width: `${value}%` }}\n      />\n    </div>\n  )\n}\n\nexport default function UsageBasedBilling({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      className={cn(\n        \"w-full bg-white dark:bg-background px-4 py-10 text-foreground sm:px-6 sm:py-12\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-3xl space-y-6\">\n        <div className=\"flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between\">\n          <div className=\"min-w-0 text-start\">\n            <h1 className=\"text-2xl font-semibold tracking-tight\">\n              Plan & usage\n            </h1>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Track quotas for your current billing period.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-2\">\n            <Button type=\"button\" variant=\"outline\" size=\"sm\">\n              Manage billing\n            </Button>\n            <Button type=\"button\" size=\"sm\" className=\"gap-1.5\">\n              <SparklesIcon className=\"size-3.5\" aria-hidden />\n              Upgrade\n            </Button>\n          </div>\n        </div>\n\n        <section\n          className=\"overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\"\n          aria-labelledby=\"usage-plan-heading\"\n        >\n          <div className=\"flex flex-col gap-4 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6\">\n            <div className=\"min-w-0 text-start\">\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h2\n                  id=\"usage-plan-heading\"\n                  className=\"text-sm font-semibold text-foreground\"\n                >\n                  Pro\n                </h2>\n                <Badge variant=\"secondary\">Active</Badge>\n              </div>\n              <p className=\"mt-1 text-sm text-muted-foreground\">\n                <span className=\"font-medium text-foreground\" dir=\"ltr\">\n                  $49\n                </span>\n                /month · Renews Nov 1, 2026\n              </p>\n            </div>\n            <p className=\"text-sm text-muted-foreground sm:text-end\">\n              Current period\n              <span className=\"mt-0.5 block font-medium text-foreground\" dir=\"ltr\">\n                Oct 1 – Nov 1, 2026\n              </span>\n            </p>\n          </div>\n\n          <Separator />\n\n          <ul className=\"divide-y divide-border/70\">\n            {QUOTAS.map((quota) => {\n              const Icon = quota.icon\n              return (\n                <li\n                  key={quota.id}\n                  className=\"flex flex-col gap-3 px-5 py-4 sm:px-6 sm:py-5\"\n                >\n                  <div className=\"flex items-start justify-between gap-3\">\n                    <div className=\"flex min-w-0 items-start gap-3\">\n                      <div className=\"flex size-9 shrink-0 items-center justify-center rounded-md border border-border/70 bg-muted/50\">\n                        <Icon\n                          className=\"size-4 text-muted-foreground\"\n                          aria-hidden\n                        />\n                      </div>\n                      <div className=\"min-w-0 text-start\">\n                        <p className=\"text-sm font-medium text-foreground\">\n                          {quota.label}\n                        </p>\n                        <p\n                          className={cn(\n                            \"mt-0.5 text-sm\",\n                            quota.tone === \"danger\"\n                              ? \"text-destructive\"\n                              : \"text-muted-foreground\"\n                          )}\n                          dir=\"ltr\"\n                        >\n                          {quota.detail}\n                        </p>\n                      </div>\n                    </div>\n                    <Badge\n                      variant=\"secondary\"\n                      className={cn(\"shrink-0\", toneBadge(quota.tone))}\n                    >\n                      {quota.status}\n                    </Badge>\n                  </div>\n                  <div className=\"space-y-1.5 ps-0 sm:ps-12\">\n                    <UsageMeter\n                      percent={quota.percent}\n                      tone={quota.tone}\n                      label={`${quota.label}: ${quota.usedLabel}`}\n                    />\n                    <p\n                      className={cn(\n                        \"text-xs\",\n                        quota.tone === \"danger\"\n                          ? \"text-destructive\"\n                          : \"text-muted-foreground\"\n                      )}\n                    >\n                      {quota.tone === \"danger\"\n                        ? \"Over limit — overage charges apply this period.\"\n                        : quota.usedLabel}\n                    </p>\n                  </div>\n                </li>\n              )\n            })}\n          </ul>\n        </section>\n\n        <aside className=\"flex flex-col gap-4 rounded-[12px] border border-border/70 bg-card p-5 shadow-soft sm:flex-row sm:items-center sm:justify-between sm:p-6\">\n          <div className=\"min-w-0 text-start\">\n            <p className=\"text-sm font-semibold text-foreground\">\n              Need higher limits?\n            </p>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Enterprise unlocks higher API and email quotas, SAML SSO, and\n              dedicated support.\n            </p>\n          </div>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"sm\"\n            className=\"w-full shrink-0 gap-1.5 sm:w-auto\"\n          >\n            View Enterprise\n            <ArrowRightIcon className=\"icon-dir size-3.5\" aria-hidden />\n          </Button>\n        </aside>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/payments-billing/usage-based-billing-01/usage-based-billing.tsx"
    }
