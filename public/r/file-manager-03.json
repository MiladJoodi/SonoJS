      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ChevronRightIcon,\n  DownloadIcon,\n  EllipsisVerticalIcon,\n  FileTextIcon,\n  FolderIcon,\n  ImageIcon,\n  LinkIcon,\n  ShieldIcon,\n  UserPlusIcon,\n  UsersIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\nconst MEMBERS = [\n  { name: \"Alex Rivera\", initials: \"AR\", role: \"Owner\" },\n  { name: \"Sam Okonkwo\", initials: \"SO\", role: \"Editor\" },\n  { name: \"Jordan Lee\", initials: \"JL\", role: \"Viewer\" },\n  { name: \"Taylor Chen\", initials: \"TC\", role: \"Editor\" },\n] as const\n\nconst ITEMS = [\n  {\n    id: \"1\",\n    name: \"Brand guidelines.pdf\",\n    type: \"file\" as const,\n    access: \"Can edit\",\n    sharedBy: \"Alex Rivera\",\n    initials: \"AR\",\n    modified: \"2h ago\",\n  },\n  {\n    id: \"2\",\n    name: \"Launch assets\",\n    type: \"folder\" as const,\n    access: \"Can view\",\n    sharedBy: \"Sam Okonkwo\",\n    initials: \"SO\",\n    modified: \"Yesterday\",\n  },\n  {\n    id: \"3\",\n    name: \"hero_locked.png\",\n    type: \"image\" as const,\n    access: \"Restricted\",\n    sharedBy: \"Jordan Lee\",\n    initials: \"JL\",\n    modified: \"3d ago\",\n  },\n  {\n    id: \"4\",\n    name: \"Press kit\",\n    type: \"folder\" as const,\n    access: \"Can edit\",\n    sharedBy: \"Taylor Chen\",\n    initials: \"TC\",\n    modified: \"Oct 24\",\n  },\n  {\n    id: \"5\",\n    name: \"external_brief.pdf\",\n    type: \"file\" as const,\n    access: \"Link anyone\",\n    sharedBy: \"Alex Rivera\",\n    initials: \"AR\",\n    modified: \"Oct 20\",\n  },\n] as const\n\nfunction AccessBadge({ access }: { access: string }) {\n  if (access === \"Restricted\") {\n    return (\n      <Badge variant=\"destructive\" className=\"gap-1 font-normal\">\n        <ShieldIcon className=\"size-3\" aria-hidden />\n        {access}\n      </Badge>\n    )\n  }\n  if (access === \"Link anyone\") {\n    return (\n      <Badge variant=\"secondary\" className=\"gap-1 font-normal\">\n        <LinkIcon className=\"size-3\" aria-hidden />\n        {access}\n      </Badge>\n    )\n  }\n  return (\n    <Badge variant=\"outline\" className=\"font-normal\">\n      {access}\n    </Badge>\n  )\n}\n\n/** Shared team folder — member strip + ACL badges. */\nexport default function FileManager({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      className={cn(\n        \"flex h-[min(50rem,100svh)] w-full min-w-0 flex-col overflow-hidden border border-border/70 bg-canvas text-foreground\",\n        className\n      )}\n      {...props}\n    >\n      <header className=\"shrink-0 border-b border-border/70 bg-card px-4 py-4 sm:px-6\">\n        <div className=\"flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between\">\n          <div className=\"text-start\">\n            <div className=\"mb-1 flex flex-wrap items-center gap-2\">\n              <UsersIcon className=\"size-4 text-primary\" aria-hidden />\n              <h1 className=\"text-lg font-semibold tracking-tight\">\n                Shared · Marketing\n              </h1>\n              <Badge>Team</Badge>\n            </div>\n            <nav\n              aria-label=\"Breadcrumb\"\n              className=\"flex flex-wrap items-center gap-1 text-sm text-muted-foreground\"\n            >\n              <span>Shared with me</span>\n              <ChevronRightIcon className=\"icon-dir size-3.5\" aria-hidden />\n              <span className=\"font-medium text-foreground\">Marketing</span>\n            </nav>\n          </div>\n          <div className=\"flex flex-wrap gap-2\">\n            <Button type=\"button\" variant=\"outline\" size=\"sm\" className=\"cursor-pointer gap-1.5\">\n              <UserPlusIcon className=\"size-3.5\" aria-hidden />\n              Invite\n            </Button>\n            <Button type=\"button\" size=\"sm\" className=\"cursor-pointer gap-1.5\">\n              <LinkIcon className=\"size-3.5\" aria-hidden />\n              Copy link\n            </Button>\n          </div>\n        </div>\n\n        <div className=\"mt-4 flex flex-wrap items-center gap-3 border-t border-border/70 pt-4\">\n          <p className=\"text-xs font-semibold tracking-wide text-muted-foreground uppercase\">\n            Members\n          </p>\n          <div className=\"flex items-center -space-x-2 rtl:space-x-reverse\">\n            {MEMBERS.map((m) => (\n              <Avatar\n                key={m.initials}\n                className=\"size-8 border-2 border-card\"\n                title={`${m.name} · ${m.role}`}\n              >\n                <AvatarFallback className=\"text-[10px]\">{m.initials}</AvatarFallback>\n              </Avatar>\n            ))}\n          </div>\n          <span className=\"text-xs text-muted-foreground\" dir=\"ltr\">\n            {MEMBERS.length} people · 2 editors\n          </span>\n        </div>\n      </header>\n\n      <div className=\"min-h-0 flex-1 overflow-auto bg-card\">\n        <Table>\n          <TableHeader>\n            <TableRow className=\"hover:bg-transparent\">\n              <TableHead>Name</TableHead>\n              <TableHead>Access</TableHead>\n              <TableHead>Shared by</TableHead>\n              <TableHead>Modified</TableHead>\n              <TableHead className=\"w-12\">\n                <span className=\"sr-only\">Actions</span>\n              </TableHead>\n            </TableRow>\n          </TableHeader>\n          <TableBody>\n            {ITEMS.map((item) => (\n              <TableRow key={item.id}>\n                <TableCell>\n                  <span className=\"inline-flex items-center gap-2 font-medium\">\n                    {item.type === \"folder\" ? (\n                      <FolderIcon className=\"size-4 text-amber-500\" aria-hidden />\n                    ) : item.type === \"image\" ? (\n                      <ImageIcon className=\"size-4 text-primary\" aria-hidden />\n                    ) : (\n                      <FileTextIcon className=\"size-4 text-destructive\" aria-hidden />\n                    )}\n                    {item.name}\n                  </span>\n                </TableCell>\n                <TableCell>\n                  <AccessBadge access={item.access} />\n                </TableCell>\n                <TableCell>\n                  <span className=\"inline-flex items-center gap-2\">\n                    <Avatar className=\"size-6\">\n                      <AvatarFallback className=\"text-[10px]\">\n                        {item.initials}\n                      </AvatarFallback>\n                    </Avatar>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {item.sharedBy}\n                    </span>\n                  </span>\n                </TableCell>\n                <TableCell className=\"text-muted-foreground\" dir=\"ltr\">\n                  {item.modified}\n                </TableCell>\n                <TableCell>\n                  <DropdownMenu>\n                    <DropdownMenuTrigger asChild>\n                      <Button\n                        type=\"button\"\n                        variant=\"ghost\"\n                        size=\"icon-xs\"\n                        className=\"cursor-pointer\"\n                        aria-label={`Actions for ${item.name}`}\n                      >\n                        <EllipsisVerticalIcon className=\"size-4\" aria-hidden />\n                      </Button>\n                    </DropdownMenuTrigger>\n                    <DropdownMenuContent align=\"end\" className=\"w-44\">\n                      <DropdownMenuItem>\n                        <DownloadIcon className=\"size-4\" aria-hidden />\n                        Download\n                      </DropdownMenuItem>\n                      <DropdownMenuItem>\n                        <UserPlusIcon className=\"size-4\" aria-hidden />\n                        Manage access\n                      </DropdownMenuItem>\n                      <DropdownMenuSeparator />\n                      <DropdownMenuItem variant=\"destructive\">\n                        Remove\n                      </DropdownMenuItem>\n                    </DropdownMenuContent>\n                  </DropdownMenu>\n                </TableCell>\n              </TableRow>\n            ))}\n          </TableBody>\n        </Table>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/files-media/file-manager-03/file-manager.tsx"
    }
