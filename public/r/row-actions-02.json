      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  CopyIcon,\n  DownloadIcon,\n  EllipsisIcon,\n  EyeIcon,\n  SendIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport {\n  Tooltip,\n  TooltipContent,\n  TooltipProvider,\n  TooltipTrigger,\n} from \"@/components/ui/tooltip\"\nimport { cn } from \"@/lib/utils\"\n\ntype InvoiceStatus = \"paid\" | \"pending\" | \"overdue\"\n\ntype Invoice = {\n  id: string\n  number: string\n  customer: string\n  amount: string\n  issued: string\n  status: InvoiceStatus\n}\n\nconst INVOICES: Invoice[] = [\n  {\n    id: \"1\",\n    number: \"INV-2481\",\n    customer: \"Northwind Labs\",\n    amount: \"$2,480.00\",\n    issued: \"Mar 12, 2026\",\n    status: \"paid\",\n  },\n  {\n    id: \"2\",\n    number: \"INV-2482\",\n    customer: \"Acme Retail\",\n    amount: \"$890.00\",\n    issued: \"Mar 14, 2026\",\n    status: \"pending\",\n  },\n  {\n    id: \"3\",\n    number: \"INV-2483\",\n    customer: \"Orbit Media\",\n    amount: \"$4,120.00\",\n    issued: \"Mar 02, 2026\",\n    status: \"overdue\",\n  },\n  {\n    id: \"4\",\n    number: \"INV-2484\",\n    customer: \"Pixel Forge\",\n    amount: \"$1,050.00\",\n    issued: \"Mar 18, 2026\",\n    status: \"paid\",\n  },\n  {\n    id: \"5\",\n    number: \"INV-2485\",\n    customer: \"Brightline Co\",\n    amount: \"$3,275.00\",\n    issued: \"Mar 08, 2026\",\n    status: \"pending\",\n  },\n]\n\nconst statusStyles: Record<InvoiceStatus, string> = {\n  paid: \"border-transparent bg-emerald-500/10 text-emerald-700 dark:text-emerald-400\",\n  pending: \"border-transparent bg-muted text-muted-foreground\",\n  overdue: \"border-transparent bg-rose-500/10 text-rose-700 dark:text-rose-400\",\n}\n\nconst statusLabel: Record<InvoiceStatus, string> = {\n  paid: \"Paid\",\n  pending: \"Pending\",\n  overdue: \"Overdue\",\n}\n\nconst iconBtn =\n  \"size-8 cursor-pointer rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground\"\n\nfunction IconTip({\n  label,\n  children,\n}: {\n  label: string\n  children: React.ReactElement\n}) {\n  return (\n    <Tooltip>\n      <TooltipTrigger asChild>{children}</TooltipTrigger>\n      <TooltipContent>{label}</TooltipContent>\n    </Tooltip>\n  )\n}\n\nfunction RowActions({ invoice }: { invoice: Invoice }) {\n  return (\n    <div className=\"flex items-center gap-0.5\">\n      <IconTip label=\"View\">\n        <Button\n          type=\"button\"\n          size=\"icon-sm\"\n          variant=\"ghost\"\n          aria-label={`View ${invoice.number}`}\n          className={iconBtn}\n        >\n          <EyeIcon className=\"size-4\" aria-hidden />\n        </Button>\n      </IconTip>\n      <IconTip label=\"Copy link\">\n        <Button\n          type=\"button\"\n          size=\"icon-sm\"\n          variant=\"ghost\"\n          aria-label={`Copy link for ${invoice.number}`}\n          className={iconBtn}\n        >\n          <CopyIcon className=\"size-4\" aria-hidden />\n        </Button>\n      </IconTip>\n      <IconTip label=\"Download PDF\">\n        <Button\n          type=\"button\"\n          size=\"icon-sm\"\n          variant=\"ghost\"\n          aria-label={`Download ${invoice.number}`}\n          className={iconBtn}\n        >\n          <DownloadIcon className=\"size-4\" aria-hidden />\n        </Button>\n      </IconTip>\n      <DropdownMenu>\n        <DropdownMenuTrigger asChild>\n          <Button\n            type=\"button\"\n            size=\"icon-sm\"\n            variant=\"ghost\"\n            aria-label={`More actions for ${invoice.number}`}\n            className={iconBtn}\n          >\n            <EllipsisIcon className=\"size-4\" aria-hidden />\n          </Button>\n        </DropdownMenuTrigger>\n        <DropdownMenuContent align=\"end\" className=\"w-44\">\n          <DropdownMenuItem className=\"cursor-pointer gap-2\">\n            <SendIcon className=\"size-4 text-muted-foreground\" aria-hidden />\n            Send reminder\n          </DropdownMenuItem>\n          <DropdownMenuItem className=\"cursor-pointer gap-2\">\n            <CopyIcon className=\"size-4 text-muted-foreground\" aria-hidden />\n            Duplicate\n          </DropdownMenuItem>\n          <DropdownMenuSeparator />\n          <DropdownMenuItem className=\"cursor-pointer text-destructive focus:text-destructive\">\n            Void invoice\n          </DropdownMenuItem>\n        </DropdownMenuContent>\n      </DropdownMenu>\n    </div>\n  )\n}\n\nexport default function RowActions02({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <TooltipProvider>\n      <div className={cn(\"w-full min-w-0\", className)} {...props}>\n        <div className=\"mb-4 text-start\">\n          <h3 className=\"text-lg font-semibold tracking-tight text-foreground\">\n            Invoices\n          </h3>\n          <p className=\"mt-0.5 text-sm text-muted-foreground\">\n            Soft icon actions — view, copy, download, and overflow menu.\n          </p>\n        </div>\n\n        <ul className=\"flex flex-col gap-3 md:hidden\">\n          {INVOICES.map((invoice) => (\n            <li\n              key={invoice.id}\n              className=\"rounded-[12px] border border-border/70 bg-white p-4 shadow-soft dark:bg-card\"\n            >\n              <div className=\"flex flex-wrap items-start justify-between gap-2\">\n                <div className=\"min-w-0\">\n                  <p\n                    dir=\"ltr\"\n                    className=\"text-sm font-medium tabular-nums text-foreground\"\n                  >\n                    {invoice.number}\n                  </p>\n                  <p className=\"mt-0.5 text-sm text-muted-foreground\">\n                    {invoice.customer}\n                  </p>\n                </div>\n                <Badge\n                  variant=\"outline\"\n                  className={cn(\n                    \"h-6 rounded-full px-2.5 font-medium\",\n                    statusStyles[invoice.status]\n                  )}\n                >\n                  {statusLabel[invoice.status]}\n                </Badge>\n              </div>\n              <div className=\"mt-3 flex items-center justify-between gap-3 border-t border-border/70 pt-3\">\n                <div className=\"text-sm\">\n                  <p dir=\"ltr\" className=\"font-medium tabular-nums\">\n                    {invoice.amount}\n                  </p>\n                  <p\n                    dir=\"ltr\"\n                    className=\"text-xs tabular-nums text-muted-foreground\"\n                  >\n                    {invoice.issued}\n                  </p>\n                </div>\n                <RowActions invoice={invoice} />\n              </div>\n            </li>\n          ))}\n        </ul>\n\n        <div className=\"hidden rounded-[12px] border border-border/70 bg-white shadow-soft md:block dark:bg-card\">\n          <Table className=\"min-w-180\">\n            <TableHeader>\n              <TableRow className=\"hover:bg-transparent\">\n                <TableHead className=\"font-medium\">Invoice</TableHead>\n                <TableHead className=\"font-medium\">Customer</TableHead>\n                <TableHead className=\"font-medium\">Amount</TableHead>\n                <TableHead className=\"font-medium\">Issued</TableHead>\n                <TableHead className=\"font-medium\">Status</TableHead>\n                <TableHead className=\"w-40 font-medium\">\n                  <span className=\"sr-only\">Actions</span>\n                </TableHead>\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              {INVOICES.map((invoice) => (\n                <TableRow key={invoice.id} className=\"group hover:bg-muted/40\">\n                  <TableCell>\n                    <span\n                      dir=\"ltr\"\n                      className=\"text-sm font-medium tabular-nums\"\n                    >\n                      {invoice.number}\n                    </span>\n                  </TableCell>\n                  <TableCell className=\"text-sm text-muted-foreground\">\n                    {invoice.customer}\n                  </TableCell>\n                  <TableCell>\n                    <span dir=\"ltr\" className=\"text-sm font-medium tabular-nums\">\n                      {invoice.amount}\n                    </span>\n                  </TableCell>\n                  <TableCell>\n                    <span\n                      dir=\"ltr\"\n                      className=\"text-sm tabular-nums text-muted-foreground\"\n                    >\n                      {invoice.issued}\n                    </span>\n                  </TableCell>\n                  <TableCell>\n                    <Badge\n                      variant=\"outline\"\n                      className={cn(\n                        \"h-6 rounded-full px-2.5 font-medium\",\n                        statusStyles[invoice.status]\n                      )}\n                    >\n                      {statusLabel[invoice.status]}\n                    </Badge>\n                  </TableCell>\n                  <TableCell className=\"text-end\">\n                    <div className=\"flex justify-end opacity-100 md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100\">\n                      <RowActions invoice={invoice} />\n                    </div>\n                  </TableCell>\n                </TableRow>\n              ))}\n            </TableBody>\n          </Table>\n        </div>\n      </div>\n    </TooltipProvider>\n  )\n}\n",
      "target": "components/blocks/data-tables/row-actions-02/table.tsx"
    }
  ],
