    {
      "path": "components/3d/hanging-bag/hanging-bag.tsx",
      "type": "registry:ui",
      "content": "\"use client\"\n\nimport { Environment, OrbitControls } from \"@react-three/drei\"\nimport { Canvas, useThree } from \"@react-three/fiber\"\nimport {\n  Suspense,\n  useEffect,\n  useState,\n  useSyncExternalStore,\n  type CSSProperties,\n} from \"react\"\n\nimport { Carousel } from \"./carousel\"\nimport { Effects } from \"./effects\"\nimport { ensureBagFontsReady } from \"./load-fonts\"\nimport {\n  DEFAULT_HANGING_BAG_ITEMS,\n  type HangingBagItem,\n} from \"./projects\"\n\nexport type HangingBagProps = {\n  items?: HangingBagItem[]\n  className?: string\n  /** Stage height; default fills a typical docs preview. */\n  height?: number | string\n  /** Show orbit / scroll hint strip. */\n  showHint?: boolean\n}\n\nconst STAGE_LIGHT = \"#f2f1ed\"\nconst STAGE_DARK = \"#09090b\"\n\nfunction useIsDarkTheme() {\n  return useSyncExternalStore(\n    (onStoreChange) => {\n      if (typeof document === \"undefined\") return () => {}\n      const el = document.documentElement\n      const mo = new MutationObserver(onStoreChange)\n      mo.observe(el, { attributes: true, attributeFilter: [\"class\"] })\n      return () => mo.disconnect()\n    },\n    () =>\n      typeof document !== \"undefined\" &&\n      document.documentElement.classList.contains(\"dark\"),\n    () => false\n  )\n}\n\nfunction useFontsReady() {\n  const [ready, setReady] = useState(false)\n\n  useEffect(() => {\n    let cancelled = false\n    void ensureBagFontsReady().then(() => {\n      if (!cancelled) setReady(true)\n    })\n    return () => {\n      cancelled = true\n    }\n  }, [])\n\n  return ready\n}\n\nfunction StageAtmosphere({ isDark }: { isDark: boolean }) {\n  const { gl } = useThree()\n  const stage = isDark ? STAGE_DARK : STAGE_LIGHT\n\n  useEffect(() => {\n    gl.setClearColor(stage)\n  }, [gl, stage])\n\n  return (\n    <>\n      <color attach=\"background\" args={[stage]} />\n      <fog attach=\"fog\" args={[stage, isDark ? 10 : 12, isDark ? 20 : 22]} />\n\n      <ambientLight intensity={isDark ? 0.42 : 0.62} />\n      <directionalLight\n        position={[5.5, 9, 4.5]}\n        intensity={isDark ? 1.15 : 1.45}\n      />\n      <directionalLight\n        position={[-6, 4, -3]}\n        intensity={isDark ? 0.55 : 0.75}\n        color={isDark ? \"#9eb0d4\" : \"#c8d4f0\"}\n      />\n      <directionalLight\n        position={[1, 2.5, 7]}\n        intensity={isDark ? 0.4 : 0.55}\n        color=\"#ffffff\"\n      />\n      <pointLight\n        position={[0, 3.4, 2.2]}\n        intensity={isDark ? 0.28 : 0.35}\n        color=\"#fff1df\"\n      />\n\n      <mesh rotation={[-Math.PI / 2, 0, 0]}>\n        <planeGeometry args={[50, 50]} />\n        <meshStandardMaterial color={stage} roughness={0.96} metalness={0} />\n      </mesh>\n    </>\n  )\n}\n\nexport function HangingBag({\n  items = DEFAULT_HANGING_BAG_ITEMS,\n  className,\n  height = \"min(100vh, 640px)\",\n  showHint = true,\n}: HangingBagProps) {\n  const fontsReady = useFontsReady()\n  const isDark = useIsDarkTheme()\n  const heightStyle: CSSProperties = {\n    height: typeof height === \"number\" ? `${height}px` : height,\n  }\n\n  return (\n    <div\n      className={className}\n      style={{\n        position: \"relative\",\n        width: \"100%\",\n        ...heightStyle,\n        touchAction: \"none\",\n        cursor: \"grab\",\n      }}\n    >\n      <Canvas\n        style={{ width: \"100%\", height: \"100%\" }}\n        dpr={[1, 1.75]}\n        camera={{ position: [0, 2.6, 7.4], fov: 36, near: 0.5, far: 80 }}\n        gl={{\n          antialias: true,\n          alpha: false,\n          toneMappingExposure: isDark ? 0.88 : 0.95,\n          logarithmicDepthBuffer: true,\n        }}\n        onCreated={({ gl }) => {\n          gl.setClearColor(isDark ? STAGE_DARK : STAGE_LIGHT)\n        }}\n      >\n        <StageAtmosphere isDark={isDark} />\n\n        <Suspense fallback={null}>\n          <Environment\n            preset=\"apartment\"\n            environmentIntensity={isDark ? 0.55 : 0.75}\n          />\n          {fontsReady ? <Carousel items={items} /> : null}\n          <Effects />\n        </Suspense>\n\n        <OrbitControls\n          makeDefault\n          enableDamping\n          dampingFactor={0.08}\n          enablePan\n          enableZoom={false}\n          minDistance={3.2}\n          maxDistance={14}\n          minPolarAngle={0.12}\n          maxPolarAngle={Math.PI - 0.12}\n          target={[0, 1.2, 0]}\n        />\n      </Canvas>\n\n      {showHint ? (\n        <div\n          aria-hidden\n          style={{\n            position: \"absolute\",\n            insetInlineEnd: 24,\n            bottom: 20,\n            zIndex: 5,\n            pointerEvents: \"none\",\n            display: \"flex\",\n            flexDirection: \"column\",\n            alignItems: \"flex-end\",\n            gap: 4,\n            fontSize: 11,\n            fontWeight: 500,\n            letterSpacing: \"0.03em\",\n            color: isDark ? \"#94a3b8\" : \"#64748b\",\n          }}\n        >\n          <span>Drag — orbit X / Y / Z</span>\n          <span>Scroll — spin rack · Ctrl+scroll — zoom</span>\n        </div>\n      ) : null}\n    </div>\n  )\n}\n",
      "target": "components/3d/hanging-bag/hanging-bag.tsx"
    },
    {
      "path": "components/3d/hanging-bag/carousel.tsx",
      "type": "registry:ui",
      "content": "\"use client\"\n\nimport { useFrame, useThree } from \"@react-three/fiber\"\nimport { useEffect, useMemo, useRef } from \"react\"\nimport * as THREE from \"three\"\n\nimport { createCardTexture } from \"./card-texture\"\nimport { HangingBagMesh } from \"./hanging-bag-mesh\"\nimport type { HangingBagItem } from \"./projects\"\nimport { RackRail } from \"./rack-geometry\"\n\ntype Props = {\n  items: HangingBagItem[]\n}\n\nexport function Carousel({ items }: Props) {\n  const rotation = useRef(0)\n  const velocity = useRef(0)\n  const auto = useRef(0.14)\n  const { camera, controls, gl } = useThree()\n\n  const textures = useMemo(() => {\n    const maxA = gl.capabilities.getMaxAnisotropy()\n    return items.map((p) => {\n      try {\n        const tex = createCardTexture(p)\n        tex.anisotropy = Math.min(16, maxA)\n        return tex\n      } catch {\n        return new THREE.CanvasTexture(document.createElement(\"canvas\"))\n      }\n    })\n  }, [gl, items])\n\n  useEffect(() => {\n    return () => {\n      textures.forEach((t) => t.dispose())\n    }\n  }, [textures])\n\n  useEffect(() => {\n    const el = gl.domElement\n    const onWheel = (e: WheelEvent) => {\n      // Only when the pointer is over this canvas — never steal page scroll.\n      e.preventDefault()\n      e.stopPropagation()\n\n      if (e.ctrlKey || e.metaKey) {\n        const target =\n          controls && \"target\" in controls\n            ? (controls as unknown as { target: THREE.Vector3 }).target\n            : new THREE.Vector3(0, 1.5, 0)\n        const dir = new THREE.Vector3().subVectors(camera.position, target)\n        const factor = Math.exp(e.deltaY * 0.0012)\n        dir.multiplyScalar(factor)\n        const next = target.clone().add(dir)\n        const dist = next.distanceTo(target)\n        if (dist > 3.2 && dist < 14) camera.position.copy(next)\n        return\n      }\n\n      const delta =\n        Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY\n      velocity.current += delta * 0.00065\n      auto.current = 0.04\n    }\n\n    el.addEventListener(\"wheel\", onWheel, { passive: false })\n    return () => el.removeEventListener(\"wheel\", onWheel)\n  }, [camera, controls, gl])\n\n  useFrame((_, delta) => {\n    rotation.current += velocity.current\n    velocity.current *= 0.94\n    rotation.current += auto.current * delta\n    auto.current = THREE.MathUtils.lerp(auto.current, 0.14, delta * 0.1)\n  })\n\n  return (\n    <group>\n      <RackRail />\n      {items.map((project, index) => (\n        <HangingBagMesh\n          key={project.id}\n          project={project}\n          texture={textures[index]!}\n          index={index}\n          total={items.length}\n          rotationRef={rotation}\n        />\n      ))}\n    </group>\n  )\n}\n",
      "target": "components/3d/hanging-bag/carousel.tsx"
    },
    {
      "path": "components/3d/hanging-bag/hanging-bag-mesh.tsx",
      "type": "registry:ui",
      "content": "\"use client\"\n\nimport { useFrame } from \"@react-three/fiber\"\nimport { useMemo, useRef, type MutableRefObject } from \"react\"\nimport * as THREE from \"three\"\n\nimport { WireHanger, HANGER_BAR_Y } from \"./rack-geometry\"\nimport type { HangingBagItem } from \"./projects\"\nimport { ellipsePoint, RACK_Y } from \"./track\"\n\nconst CARD_W = 0.72\nconst CARD_H = 1.0\nconst CARD_D = 0.018\n\ntype Props = {\n  project: HangingBagItem\n  texture: THREE.Texture\n  index: number\n  total: number\n  rotationRef: MutableRefObject<number>\n}\n\nexport function HangingBagMesh({\n  project,\n  texture,\n  index,\n  total,\n  rotationRef,\n}: Props) {\n  const groupRef = useRef<THREE.Group>(null)\n  const cardRef = useRef<THREE.Mesh>(null)\n  const baseAngle = useMemo(\n    () => (index / total) * Math.PI * 2 + Math.PI / 2,\n    [index, total]\n  )\n\n  const materials = useMemo(() => {\n    const side = new THREE.MeshStandardMaterial({\n      color: project.color,\n      roughness: 0.88,\n      metalness: 0,\n      depthTest: true,\n      depthWrite: true,\n      transparent: false,\n      polygonOffset: true,\n      polygonOffsetFactor: 2,\n      polygonOffsetUnits: 2,\n    })\n    const face = new THREE.MeshBasicMaterial({\n      map: texture,\n      depthTest: true,\n      depthWrite: true,\n      transparent: false,\n      toneMapped: false,\n      polygonOffset: true,\n      polygonOffsetFactor: 2,\n      polygonOffsetUnits: 2,\n    })\n    return [side, side, side, side, face, side]\n  }, [project.color, texture])\n\n  useFrame(({ clock }) => {\n    if (!groupRef.current) return\n    const angle = baseAngle + rotationRef.current\n    const p = ellipsePoint(angle)\n    groupRef.current.position.set(p.x, RACK_Y, p.z)\n\n    groupRef.current.rotation.order = \"YXZ\"\n    groupRef.current.rotation.y = Math.PI / 2 - angle\n\n    const t = clock.elapsedTime\n    groupRef.current.rotation.z = Math.sin(t * 1.05 + index * 1.6) * 0.028\n    groupRef.current.rotation.x = 0.015 + Math.sin(t * 0.7 + index) * 0.008\n\n    if (cardRef.current) {\n      const frontness = Math.cos(angle - Math.PI / 2)\n      const dim = THREE.MathUtils.clamp(1 - (frontness + 1) * 0.5, 0, 1)\n      cardRef.current.scale.setScalar(1 - dim * 0.05)\n    }\n  })\n\n  const initial = ellipsePoint(baseAngle)\n  const bagY = HANGER_BAR_Y - CARD_H * 0.5 - 0.05\n\n  return (\n    <group\n      ref={groupRef}\n      position={[initial.x, RACK_Y, initial.z]}\n      rotation={[0.015, Math.PI / 2 - baseAngle, 0]}\n    >\n      <WireHanger />\n\n      <mesh ref={cardRef} position={[0, bagY, -0.1]} material={materials}>\n        <boxGeometry args={[CARD_W, CARD_H, CARD_D]} />\n      </mesh>\n\n      <mesh position={[0, HANGER_BAR_Y - 0.02, -0.04]}>\n        <boxGeometry args={[CARD_W * 0.65, 0.022, 0.032]} />\n        <meshStandardMaterial\n          color=\"#c5ceda\"\n          roughness={0.4}\n          metalness={0.15}\n        />\n      </mesh>\n    </group>\n  )\n}\n",
      "target": "components/3d/hanging-bag/hanging-bag-mesh.tsx"
    },
    {
      "path": "components/3d/hanging-bag/rack-geometry.tsx",
      "type": "registry:ui",
      "content": "\"use client\"\n\nimport { useMemo } from \"react\"\n\nimport { getHangerGeometry, HANGER_BAR_Y } from \"./hanger-geometry\"\nimport { ellipsePoint, makeEllipseTube, RACK_Y } from \"./track\"\n\nfunction Steel({ color = \"#9aa5b4\" }: { color?: string }) {\n  return (\n    <meshPhysicalMaterial\n      color={color}\n      metalness={1}\n      roughness={0.1}\n      clearcoat={1}\n      clearcoatRoughness={0.06}\n      envMapIntensity={2.8}\n    />\n  )\n}\n\nexport function RackRail() {\n  const topRail = useMemo(() => makeEllipseTube(0.062, 0.03), [])\n  const blackTrack = useMemo(() => makeEllipseTube(0.046, -0.042), [])\n  const bottomRail = useMemo(() => makeEllipseTube(0.042, -0.105), [])\n  const poles = useMemo(\n    () => [0.55, 2.15, 3.7, 5.25].map((a) => ellipsePoint(a)),\n    []\n  )\n\n  return (\n    <group position={[0, RACK_Y, 0]}>\n      <mesh geometry={topRail} renderOrder={2}>\n        <Steel color=\"#b0b9c6\" />\n      </mesh>\n      <mesh geometry={blackTrack} renderOrder={2}>\n        <meshStandardMaterial\n          color=\"#0a0c0f\"\n          metalness={0.35}\n          roughness={0.52}\n        />\n      </mesh>\n      <mesh geometry={bottomRail} renderOrder={2}>\n        <Steel color=\"#b0b9c6\" />\n      </mesh>\n\n      {poles.map((p, i) => (\n        <group key={i} position={[p.x, 0, p.z]}>\n          <mesh position={[0, 1.65, 0]}>\n            <cylinderGeometry args={[0.022, 0.022, 3.3, 16]} />\n            <Steel color=\"#a8b2c0\" />\n          </mesh>\n          <mesh position={[0, 3.28, 0]}>\n            <cylinderGeometry args={[0.055, 0.04, 0.08, 16]} />\n            <meshStandardMaterial\n              color=\"#6b7584\"\n              metalness={0.9}\n              roughness={0.25}\n            />\n          </mesh>\n          <mesh position={[0, 0.02, 0]}>\n            <boxGeometry args={[0.14, 0.08, 0.1]} />\n            <meshStandardMaterial\n              color=\"#0a0c0f\"\n              metalness={0.45}\n              roughness={0.42}\n            />\n          </mesh>\n        </group>\n      ))}\n    </group>\n  )\n}\n\nexport function WireHanger() {\n  const geometry = useMemo(() => getHangerGeometry(), [])\n\n  return (\n    <group>\n      <mesh position={[0, 0.06, 0]}>\n        <boxGeometry args={[0.105, 0.072, 0.085]} />\n        <meshStandardMaterial\n          color=\"#080a0d\"\n          metalness={0.4}\n          roughness={0.48}\n        />\n      </mesh>\n      <mesh position={[0, 0.018, 0]} rotation={[0, 0, Math.PI / 2]}>\n        <cylinderGeometry args={[0.01, 0.01, 0.055, 12]} />\n        <meshStandardMaterial\n          color=\"#1a1f27\"\n          metalness={0.75}\n          roughness={0.32}\n        />\n      </mesh>\n\n      <mesh geometry={geometry}>\n        <meshPhysicalMaterial\n          color=\"#7a8492\"\n          metalness={1}\n          roughness={0.1}\n          clearcoat={1}\n          clearcoatRoughness={0.05}\n          envMapIntensity={3}\n        />\n      </mesh>\n    </group>\n  )\n}\n\nexport { HANGER_BAR_Y }\n",
      "target": "components/3d/hanging-bag/rack-geometry.tsx"
    },
    {
      "path": "components/3d/hanging-bag/effects.tsx",
      "type": "registry:ui",
      "content": "\"use client\"\n\nimport { EffectComposer, Vignette } from \"@react-three/postprocessing\"\n\n/** Vignette only — Bloom was compositing bright card pixels over the chrome rail */\nexport function Effects() {\n  return (\n    <EffectComposer multisampling={4}>\n      <Vignette offset={0.28} darkness={0.3} />\n    </EffectComposer>\n  )\n}\n",
      "target": "components/3d/hanging-bag/effects.tsx"
    },
    {
      "path": "components/3d/hanging-bag/card-texture.ts",
      "type": "registry:ui",
      "content": "import * as THREE from \"three\"\n\nimport type { HangingBagItem } from \"./projects\"\n\n/** High-res so cards stay smooth when close / angled */\nconst W = 1024\nconst H = 1440\nconst S = W / 640\n\nconst SANS =\n  'Geist, \"Geist Sans\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif'\nconst STAMP =\n  '\"Permanent Marker\", \"Comic Sans MS\", \"Segoe Print\", cursive'\n\nfunction roundRect(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  w: number,\n  h: number,\n  r: number\n) {\n  const rr = Math.min(r, w / 2, h / 2)\n  ctx.beginPath()\n  ctx.moveTo(x + rr, y)\n  ctx.arcTo(x + w, y, x + w, y + h, rr)\n  ctx.arcTo(x + w, y + h, x, y + h, rr)\n  ctx.arcTo(x, y + h, x, y, rr)\n  ctx.arcTo(x, y, x + w, y, rr)\n  ctx.closePath()\n}\n\nfunction drawBarcode(\n  ctx: CanvasRenderingContext2D,\n  x: number,\n  y: number,\n  w: number,\n  h: number,\n  seed: number\n) {\n  let cx = x\n  let n = seed\n  while (cx < x + w) {\n    n = (n * 16807) % 2147483647\n    const bw = 1 + (n % 3)\n    ctx.fillStyle = \"#1e293b\"\n    ctx.fillRect(cx, y, bw * S * 0.7, h)\n    n = (n * 16807) % 2147483647\n    cx += (bw + 1 + (n % 2)) * S * 0.7\n  }\n}\n\nexport function createCardTexture(project: HangingBagItem) {\n  const canvas = document.createElement(\"canvas\")\n  canvas.width = W\n  canvas.height = H\n  const ctx = canvas.getContext(\"2d\", { alpha: false })!\n\n  ctx.imageSmoothingEnabled = true\n  ctx.imageSmoothingQuality = \"high\"\n\n  ctx.fillStyle = project.color\n  ctx.fillRect(0, 0, W, H)\n\n  for (let i = 0; i < 2800; i++) {\n    ctx.fillStyle = `rgba(255,255,255,${(i % 6) * 0.003})`\n    ctx.fillRect((i * 97) % W, (i * 53) % H, 2, 2)\n  }\n\n  ctx.strokeStyle = \"rgba(255,255,255,0.35)\"\n  ctx.lineWidth = 4\n  ctx.strokeRect(10, 10, W - 20, H - 20)\n\n  ctx.fillStyle = \"#2563eb\"\n  roundRect(ctx, 52, 52, 236, 64, 16)\n  ctx.fill()\n  ctx.fillStyle = \"#ffffff\"\n  ctx.font = `700 ${32 * S * 0.55}px ${SANS}`\n  ctx.textAlign = \"center\"\n  ctx.textBaseline = \"middle\"\n  ctx.fillText(\"PROJECT\", 170, 85)\n\n  ctx.fillStyle = \"#64748b\"\n  ctx.font = `500 ${26 * S * 0.55}px ${SANS}`\n  ctx.textAlign = \"right\"\n  ctx.fillText(`${project.start} — ${project.end}`, W - 52, 85)\n\n  ctx.fillStyle = \"#e11d48\"\n  ctx.font = `700 ${78 * S * 0.9}px ${SANS}`\n  ctx.textAlign = \"left\"\n  ctx.textBaseline = \"alphabetic\"\n  ctx.fillText(project.id, 52, 230)\n\n  ctx.fillStyle = project.ink\n  ctx.font = `700 ${28 * S * 0.85}px ${SANS}`\n  ctx.fillText(project.name, 52, 300)\n\n  ctx.strokeStyle = \"rgba(37, 99, 235, 0.28)\"\n  ctx.lineWidth = 3\n  ctx.beginPath()\n  ctx.moveTo(52, 340)\n  ctx.lineTo(W - 52, 340)\n  ctx.stroke()\n\n  const meta = [\n    [\"CLIENT\", project.client],\n    [\"LEAD\", project.lead],\n    [\"CLIENT ID\", project.id.replace(\"P \", \"C-\")],\n    [\"WORK ORDER\", `WO-${project.id.replace(/\\D/g, \"\")}`],\n  ] as const\n\n  meta.forEach(([label, value], i) => {\n    const col = i % 2\n    const row = Math.floor(i / 2)\n    const x = 52 + col * 450\n    const y = 410 + row * 120\n    ctx.fillStyle = \"#64748b\"\n    ctx.font = `600 ${20 * S * 0.6}px ${SANS}`\n    ctx.textAlign = \"left\"\n    ctx.fillText(label, x, y)\n    ctx.fillStyle = \"#0f172a\"\n    ctx.font = `600 ${36 * S * 0.6}px ${SANS}`\n    ctx.fillText(value, x, y + 48)\n  })\n\n  const tableY = 690\n  ctx.fillStyle = \"#64748b\"\n  ctx.font = `600 ${20 * S * 0.6}px ${SANS}`\n  ctx.fillText(\"QTY\", 52, tableY)\n  ctx.fillText(\"DESCRIPTION\", 170, tableY)\n  ctx.textAlign = \"right\"\n  ctx.fillText(\"AMOUNT\", W - 52, tableY)\n\n  ctx.strokeStyle = \"rgba(100,116,139,0.35)\"\n  ctx.lineWidth = 2\n  ctx.beginPath()\n  ctx.moveTo(52, tableY + 18)\n  ctx.lineTo(W - 52, tableY + 18)\n  ctx.stroke()\n\n  project.lines.forEach((line, i) => {\n    const y = tableY + 70 + i * 64\n    ctx.fillStyle = \"#0f172a\"\n    ctx.font = `500 ${30 * S * 0.6}px ${SANS}`\n    ctx.textAlign = \"left\"\n    ctx.fillText(line.qty, 52, y)\n    ctx.fillText(line.description, 170, y)\n    ctx.textAlign = \"right\"\n    ctx.fillText(line.amount, W - 52, y)\n  })\n\n  ctx.textAlign = \"left\"\n  ctx.fillStyle = \"#94a3b8\"\n  ctx.font = `600 ${20 * S * 0.6}px ${SANS}`\n  ctx.fillText(\"WORK ORDER\", 52, H - 90)\n  const seed = Number(project.id.replace(/\\D/g, \"\")) || 1000\n  drawBarcode(ctx, W - 340, H - 130, 270, 48, seed)\n\n  ctx.save()\n  ctx.translate(W * 0.54, H * 0.58)\n  ctx.rotate((project.status.angle * Math.PI) / 180)\n  ctx.globalAlpha = 0.78\n  ctx.strokeStyle = project.status.color\n  ctx.fillStyle = project.status.color\n  ctx.lineWidth = 10\n  ctx.lineJoin = \"round\"\n  roundRect(ctx, -280, -76, 560, 152, 14)\n  ctx.stroke()\n  ctx.lineWidth = 3.5\n  roundRect(ctx, -260, -60, 520, 120, 10)\n  ctx.stroke()\n  ctx.font = `700 ${90 * S * 0.55}px ${STAMP}`\n  ctx.textAlign = \"center\"\n  ctx.textBaseline = \"middle\"\n  ctx.fillText(project.status.label, 0, 6)\n  ctx.restore()\n\n  const sheen = ctx.createLinearGradient(0, 0, W, H)\n  sheen.addColorStop(0, \"rgba(255,255,255,0.14)\")\n  sheen.addColorStop(0.4, \"rgba(255,255,255,0)\")\n  sheen.addColorStop(1, \"rgba(255,255,255,0.08)\")\n  ctx.fillStyle = sheen\n  ctx.fillRect(0, 0, W, H)\n\n  const texture = new THREE.CanvasTexture(canvas)\n  texture.colorSpace = THREE.SRGBColorSpace\n  texture.generateMipmaps = true\n  texture.minFilter = THREE.LinearMipmapLinearFilter\n  texture.magFilter = THREE.LinearFilter\n  texture.anisotropy = 16\n  texture.needsUpdate = true\n  return texture\n}\n",
      "target": "components/3d/hanging-bag/card-texture.ts"
    },
    {
      "path": "components/3d/hanging-bag/hanger-geometry.ts",
      "type": "registry:ui",
      "content": "import * as THREE from \"three\"\n\nlet cached: THREE.TubeGeometry | null = null\n\n/** One shared chrome hanger geometry — classic dry-cleaner silhouette */\nexport function getHangerGeometry() {\n  if (cached && (cached.parameters as { radius?: number }).radius === 0.014) {\n    return cached\n  }\n  if (cached) {\n    cached.dispose()\n    cached = null\n  }\n\n  const pts: THREE.Vector3[] = []\n\n  const hr = 0.052\n  const hy = 0.108\n  for (let i = 0; i <= 40; i++) {\n    const t = i / 40\n    const a = Math.PI * 0.25 + t * Math.PI * 1.8\n    pts.push(\n      new THREE.Vector3(\n        Math.cos(a) * hr * 0.48,\n        hy + Math.sin(a) * hr,\n        Math.sin(a) * hr * 0.18\n      )\n    )\n  }\n\n  pts.push(new THREE.Vector3(0.008, 0.05, 0))\n  pts.push(new THREE.Vector3(0, 0.0, 0))\n  pts.push(new THREE.Vector3(0, -0.06, 0))\n\n  pts.push(new THREE.Vector3(-0.16, -0.26, 0))\n  pts.push(new THREE.Vector3(-0.34, -0.5, 0))\n  pts.push(new THREE.Vector3(-0.4, -0.6, 0))\n\n  pts.push(new THREE.Vector3(-0.2, -0.618, 0))\n  pts.push(new THREE.Vector3(0, -0.62, 0))\n  pts.push(new THREE.Vector3(0.2, -0.618, 0))\n  pts.push(new THREE.Vector3(0.4, -0.6, 0))\n\n  pts.push(new THREE.Vector3(0.34, -0.5, 0))\n  pts.push(new THREE.Vector3(0.16, -0.26, 0))\n  pts.push(new THREE.Vector3(0, -0.06, 0))\n\n  const curve = new THREE.CatmullRomCurve3(pts, false, \"catmullrom\", 0.18)\n  cached = new THREE.TubeGeometry(curve, 200, 0.014, 14, false)\n  return cached\n}\n\nexport const HANGER_BAR_Y = -0.62\n",
      "target": "components/3d/hanging-bag/hanger-geometry.ts"
    },
    {
      "path": "components/3d/hanging-bag/track.ts",
      "type": "registry:ui",
      "content": "import * as THREE from \"three\"\n\n/** Elongated oval matching the dry-cleaning conveyor */\nexport const RACK_RX = 3.1\nexport const RACK_RZ = 1.7\nexport const RACK_Y = 2.35\n\nexport function ellipsePoint(angle: number, rx = RACK_RX, rz = RACK_RZ) {\n  return new THREE.Vector3(Math.cos(angle) * rx, 0, Math.sin(angle) * rz)\n}\n\nexport function ellipseTangent(angle: number, rx = RACK_RX, rz = RACK_RZ) {\n  const tx = -Math.sin(angle) * rx\n  const tz = Math.cos(angle) * rz\n  return new THREE.Vector3(tx, 0, tz).normalize()\n}\n\nexport function makeEllipseTube(radius: number, y = 0, tubularSegments = 200) {\n  const curve = new THREE.EllipseCurve(\n    0,\n    0,\n    RACK_RX,\n    RACK_RZ,\n    0,\n    Math.PI * 2,\n    false,\n    0\n  )\n  const pts = curve\n    .getPoints(tubularSegments)\n    .map((p) => new THREE.Vector3(p.x, y, p.y))\n  const path = new THREE.CatmullRomCurve3(pts, true)\n  return new THREE.TubeGeometry(path, tubularSegments, radius, 20, true)\n}\n",
      "target": "components/3d/hanging-bag/track.ts"
    },
