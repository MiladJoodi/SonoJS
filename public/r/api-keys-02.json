      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  CheckIcon,\n  CopyIcon,\n  KeyRoundIcon,\n  PlusIcon,\n  Trash2Icon,\n} from \"lucide-react\"\n\nimport { Alert, AlertDescription, AlertTitle } from \"@/components/ui/alert\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n} from \"@/components/ui/dialog\"\nimport { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\"\nimport { cn } from \"@/lib/utils\"\n\ntype ApiKey = {\n  id: string\n  name: string\n  prefix: string\n  scopes: string[]\n  expires: string\n  lastUsed: string\n}\n\nconst INITIAL_KEYS: ApiKey[] = [\n  {\n    id: \"key_prod\",\n    name: \"Production server\",\n    prefix: \"sk_live_3f8a\",\n    scopes: [\"read\", \"write\"],\n    expires: \"Never\",\n    lastUsed: \"12 min ago\",\n  },\n  {\n    id: \"key_ci\",\n    name: \"CI / GitHub Actions\",\n    prefix: \"sk_live_9c21\",\n    scopes: [\"read\"],\n    expires: \"Jan 15, 2027\",\n    lastUsed: \"Yesterday\",\n  },\n  {\n    id: \"key_local\",\n    name: \"Local development\",\n    prefix: \"sk_test_a04e\",\n    scopes: [\"read\", \"write\"],\n    expires: \"30 days\",\n    lastUsed: \"Never\",\n  },\n]\n\nfunction CopySecretButton({ value }: { value: string }) {\n  const [copied, setCopied] = React.useState(false)\n\n  return (\n    <Button\n      type=\"button\"\n      variant=\"outline\"\n      size=\"sm\"\n      className=\"shrink-0 gap-2\"\n      onClick={async () => {\n        try {\n          await navigator.clipboard.writeText(value)\n          setCopied(true)\n          window.setTimeout(() => setCopied(false), 1500)\n        } catch {\n          /* ignore */\n        }\n      }}\n    >\n      {copied ? (\n        <CheckIcon className=\"size-3.5\" aria-hidden />\n      ) : (\n        <CopyIcon className=\"size-3.5\" aria-hidden />\n      )}\n      {copied ? \"Copied\" : \"Copy\"}\n    </Button>\n  )\n}\n\nexport default function ApiKeys({\n  className,\n  ...props\n}: React.ComponentProps<\"main\">) {\n  const [keys, setKeys] = React.useState(INITIAL_KEYS)\n  const [open, setOpen] = React.useState(false)\n  const [step, setStep] = React.useState<\"form\" | \"reveal\">(\"form\")\n  const [name, setName] = React.useState(\"\")\n  const [expires, setExpires] = React.useState(\"never\")\n  const [readScope, setReadScope] = React.useState(true)\n  const [writeScope, setWriteScope] = React.useState(false)\n  const [secret, setSecret] = React.useState<string | null>(null)\n\n  function resetDialog() {\n    setStep(\"form\")\n    setName(\"\")\n    setExpires(\"never\")\n    setReadScope(true)\n    setWriteScope(false)\n    setSecret(null)\n  }\n\n  function handleOpenChange(next: boolean) {\n    setOpen(next)\n    if (!next) resetDialog()\n  }\n\n  function handleGenerate(e: React.FormEvent) {\n    e.preventDefault()\n    const scopes = [\n      ...(readScope ? [\"read\"] : []),\n      ...(writeScope ? [\"write\"] : []),\n    ]\n    const full = `sk_live_${Math.random().toString(36).slice(2, 18)}`\n    setKeys((prev) => [\n      {\n        id: `key_${Date.now()}`,\n        name: name.trim() || \"Untitled token\",\n        prefix: full.slice(0, 13),\n        scopes: scopes.length ? scopes : [\"read\"],\n        expires:\n          expires === \"never\"\n            ? \"Never\"\n            : expires === \"30\"\n              ? \"30 days\"\n              : \"90 days\",\n        lastUsed: \"Never\",\n      },\n      ...prev,\n    ])\n    setSecret(full)\n    setStep(\"reveal\")\n  }\n\n  return (\n    <main\n      className={cn(\n        \"w-full min-w-0 bg-canvas px-4 py-10 text-foreground sm:px-6\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-xl space-y-6\">\n        <div className=\"flex items-start justify-between gap-4\">\n          <div className=\"min-w-0 text-start\">\n            <h1 className=\"text-2xl font-semibold tracking-tight\">\n              Access tokens\n            </h1>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Create tokens for CI and local tools. The secret is shown once.\n            </p>\n          </div>\n          <Button type=\"button\" onClick={() => setOpen(true)}>\n            <PlusIcon className=\"size-4\" aria-hidden />\n            New token\n          </Button>\n        </div>\n\n        <ul className=\"divide-y divide-border rounded-[12px] border border-border/70 bg-card shadow-soft\">\n          {keys.map((key) => (\n            <li\n              key={key.id}\n              className=\"flex items-start gap-3 px-4 py-4 sm:px-5\"\n            >\n              <div className=\"mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-md bg-muted\">\n                <KeyRoundIcon\n                  className=\"size-4 text-muted-foreground\"\n                  aria-hidden\n                />\n              </div>\n              <div className=\"min-w-0 flex-1 space-y-2 text-start\">\n                <div className=\"flex flex-wrap items-center gap-2\">\n                  <p className=\"font-medium text-foreground\">{key.name}</p>\n                  <span\n                    className=\"font-mono text-xs text-muted-foreground\"\n                    dir=\"ltr\"\n                  >\n                    {key.prefix}…\n                  </span>\n                </div>\n                <div className=\"flex flex-wrap gap-1.5\">\n                  {key.scopes.map((scope) => (\n                    <Badge\n                      key={scope}\n                      variant=\"secondary\"\n                      className=\"capitalize\"\n                    >\n                      {scope}\n                    </Badge>\n                  ))}\n                </div>\n                <p className=\"text-xs text-muted-foreground\">\n                  Expires {key.expires}\n                  <span aria-hidden className=\"mx-1.5\">\n                    ·\n                  </span>\n                  Last used {key.lastUsed}\n                </p>\n              </div>\n              <Button\n                type=\"button\"\n                variant=\"ghost\"\n                size=\"icon-sm\"\n                className=\"size-8 shrink-0 text-muted-foreground hover:text-destructive\"\n                aria-label={`Revoke ${key.name}`}\n                onClick={() =>\n                  setKeys((prev) => prev.filter((k) => k.id !== key.id))\n                }\n              >\n                <Trash2Icon className=\"size-4\" aria-hidden />\n              </Button>\n            </li>\n          ))}\n        </ul>\n      </div>\n\n      <Dialog open={open} onOpenChange={handleOpenChange}>\n        <DialogContent\n          className=\"gap-0 p-0 sm:max-w-md\"\n          style={{ maxWidth: \"min(28rem, calc(100% - 2rem))\" }}\n        >\n          {step === \"form\" ? (\n            <form onSubmit={handleGenerate}>\n              <DialogHeader className=\"border-b border-border/70 px-6 py-5\">\n                <DialogTitle>New access token</DialogTitle>\n                <DialogDescription>\n                  You’ll only see the full secret once after creating it.\n                </DialogDescription>\n              </DialogHeader>\n\n              <div className=\"space-y-5 px-6 py-5\">\n                <div className=\"grid gap-2\">\n                  <Label htmlFor=\"api-keys-02-name\">Name</Label>\n                  <Input\n                    id=\"api-keys-02-name\"\n                    placeholder=\"e.g. Production server\"\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    autoComplete=\"off\"\n                  />\n                </div>\n\n                <div className=\"grid gap-2\">\n                  <Label htmlFor=\"api-keys-02-expires\">Expiration</Label>\n                  <Select value={expires} onValueChange={setExpires}>\n                    <SelectTrigger id=\"api-keys-02-expires\" className=\"w-full\">\n                      <SelectValue />\n                    </SelectTrigger>\n                    <SelectContent>\n                      <SelectItem value=\"30\">30 days</SelectItem>\n                      <SelectItem value=\"90\">90 days</SelectItem>\n                      <SelectItem value=\"never\">No expiration</SelectItem>\n                    </SelectContent>\n                  </Select>\n                </div>\n\n                <div className=\"space-y-3\">\n                  <p className=\"text-sm font-medium\">Scopes</p>\n                  <div className=\"flex flex-col gap-3\">\n                    <div className=\"flex items-center gap-3\">\n                      <Checkbox\n                        id=\"api-keys-02-read\"\n                        checked={readScope}\n                        onCheckedChange={(v) => setReadScope(v === true)}\n                      />\n                      <Label htmlFor=\"api-keys-02-read\" className=\"font-normal\">\n                        Read\n                      </Label>\n                    </div>\n                    <div className=\"flex items-center gap-3\">\n                      <Checkbox\n                        id=\"api-keys-02-write\"\n                        checked={writeScope}\n                        onCheckedChange={(v) => setWriteScope(v === true)}\n                      />\n                      <Label\n                        htmlFor=\"api-keys-02-write\"\n                        className=\"font-normal\"\n                      >\n                        Write\n                      </Label>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <DialogFooter className=\"border-t border-border/70 px-6 py-4\">\n                <DialogClose asChild>\n                  <Button type=\"button\" variant=\"ghost\">\n                    Cancel\n                  </Button>\n                </DialogClose>\n                <Button type=\"submit\">Create token</Button>\n              </DialogFooter>\n            </form>\n          ) : (\n            <>\n              <DialogHeader className=\"border-b border-border/70 px-6 py-5\">\n                <DialogTitle>Copy your token</DialogTitle>\n                <DialogDescription>\n                  Store it now — you won’t be able to view it again.\n                </DialogDescription>\n              </DialogHeader>\n\n              <div className=\"space-y-4 px-6 py-5\">\n                <Alert variant=\"destructive\">\n                  <AlertTitle>Shown once</AlertTitle>\n                  <AlertDescription>\n                    If you close without copying, revoke this token and create a\n                    new one.\n                  </AlertDescription>\n                </Alert>\n                <div className=\"flex flex-col gap-2 sm:flex-row\">\n                  <Input\n                    readOnly\n                    dir=\"ltr\"\n                    value={secret ?? \"\"}\n                    className=\"font-mono text-xs sm:text-sm\"\n                  />\n                  <CopySecretButton value={secret ?? \"\"} />\n                </div>\n              </div>\n\n              <DialogFooter className=\"border-t border-border/70 px-6 py-4\">\n                <Button type=\"button\" onClick={() => handleOpenChange(false)}>\n                  Done\n                </Button>\n              </DialogFooter>\n            </>\n          )}\n        </DialogContent>\n      </Dialog>\n    </main>\n  )\n}\n",
      "target": "components/blocks/developer-tools/api-keys-02/api-keys.tsx"
    }
  ],
