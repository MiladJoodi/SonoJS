      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { ArrowRightIcon } from \"lucide-react\"\nimport { PolarAngleAxis, RadialBar, RadialBarChart } from \"recharts\"\n\nimport {\n  Card,\n  CardContent,\n  CardFooter,\n} from \"@/components/ui/card\"\nimport {\n  type ChartConfig,\n  ChartContainer,\n} from \"@/components/ui/chart\"\nimport { cn } from \"@/lib/utils\"\n\nconst DATA = [\n  {\n    name: \"Design\",\n    progress: 25,\n    budget: \"$1,000\",\n    current: \"$250\",\n    href: \"#\",\n    fill: \"var(--chart-1)\",\n  },\n  {\n    name: \"Marketing\",\n    progress: 55,\n    budget: \"$1,000\",\n    current: \"$550\",\n    href: \"#\",\n    fill: \"var(--chart-2)\",\n  },\n  {\n    name: \"Docs\",\n    progress: 85,\n    budget: \"$1,000\",\n    current: \"$850\",\n    href: \"#\",\n    fill: \"var(--chart-3)\",\n  },\n  {\n    name: \"Engineering\",\n    progress: 70,\n    budget: \"$2,000\",\n    current: \"$1,400\",\n    href: \"#\",\n    fill: \"var(--chart-4)\",\n  },\n] as const\n\nconst chartConfig = {\n  progress: {\n    label: \"Progress\",\n    color: \"var(--primary)\",\n  },\n} satisfies ChartConfig\n\nexport default function KpiCards({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  return (\n    <section\n      className={cn(\n        \"relative isolate w-full min-w-0 bg-canvas px-4 pt-10 pb-14 text-foreground sm:px-6 sm:pt-12 sm:pb-16\",\n        className\n      )}\n      aria-labelledby=\"kpi-cards-03-heading\"\n      {...props}\n    >\n      <div\n        aria-hidden\n        className=\"pointer-events-none absolute inset-0 -z-10\"\n      >\n        <div className=\"absolute start-1/2 top-[-18%] size-[22rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl\" />\n      </div>\n\n      <div className=\"mx-auto w-full max-w-5xl\">\n        <header className=\"mb-6 text-start\">\n          <h2\n            id=\"kpi-cards-03-heading\"\n            className=\"text-lg font-semibold tracking-tight text-foreground\"\n          >\n            Department budgets\n          </h2>\n          <p className=\"mt-1 text-sm text-muted-foreground\">\n            Spend vs plan this quarter across SonoJS teams.\n          </p>\n        </header>\n\n        <dl className=\"grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4\">\n          {DATA.map((item) => (\n            <Card\n              key={item.name}\n              className=\"gap-0 border-border/70 p-0 shadow-soft\"\n            >\n              <CardContent className=\"p-4\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"relative flex items-center justify-center\">\n                    <ChartContainer\n                      className=\"h-20 w-20\"\n                      config={chartConfig}\n                    >\n                      <RadialBarChart\n                        data={[item]}\n                        barSize={6}\n                        endAngle={-270}\n                        innerRadius={30}\n                        outerRadius={40}\n                        startAngle={90}\n                      >\n                        <PolarAngleAxis\n                          angleAxisId={0}\n                          axisLine={false}\n                          domain={[0, 100]}\n                          tick={false}\n                          type=\"number\"\n                        />\n                        <RadialBar\n                          angleAxisId={0}\n                          background\n                          cornerRadius={10}\n                          dataKey=\"progress\"\n                          fill={item.fill}\n                        />\n                      </RadialBarChart>\n                    </ChartContainer>\n                    <div className=\"absolute inset-0 flex items-center justify-center\">\n                      <span\n                        dir=\"ltr\"\n                        className=\"text-base font-medium text-foreground tabular-nums\"\n                      >\n                        {item.progress}%\n                      </span>\n                    </div>\n                  </div>\n                  <div className=\"min-w-0 text-start\">\n                    <dd\n                      dir=\"ltr\"\n                      className=\"text-base font-medium text-foreground tabular-nums\"\n                    >\n                      {item.current} / {item.budget}\n                    </dd>\n                    <dt className=\"text-sm text-muted-foreground\">\n                      Budget {item.name}\n                    </dt>\n                  </div>\n                </div>\n              </CardContent>\n              <CardFooter className=\"flex items-center justify-end border-t border-border/70 p-0\">\n                <a\n                  href={item.href}\n                  className=\"inline-flex items-center gap-1 px-6 py-3 text-sm font-medium text-primary hover:text-primary/90\"\n                >\n                  View more\n                  <ArrowRightIcon\n                    className=\"icon-dir size-4\"\n                    aria-hidden\n                  />\n                </a>\n              </CardFooter>\n            </Card>\n          ))}\n        </dl>\n      </div>\n    </section>\n  )\n}\n",
