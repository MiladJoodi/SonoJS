      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowDownToLineIcon,\n  ArrowRightLeftIcon,\n  CreditCardIcon,\n  EyeIcon,\n  EyeOffIcon,\n  MoreHorizontalIcon,\n  PlusIcon,\n  SettingsIcon,\n  SnowflakeIcon,\n  WalletIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { cn } from \"@/lib/utils\"\n\nimport visaLogo from \"./images/visa.webp\"\n\nfunction assetSrc(asset: string | { src: string }) {\n  return typeof asset === \"string\" ? asset : asset.src\n}\n\nconst VISA = assetSrc(visaLogo)\n\nconst ACTIVITY = [\n  {\n    id: 1,\n    merchant: \"Apple Store\",\n    date: \"Today, 14:23\",\n    amount: \"-$124.00\",\n    card: \"•••• 4444\",\n  },\n  {\n    id: 2,\n    merchant: \"Uber Eats\",\n    date: \"Yesterday, 19:45\",\n    amount: \"-$32.50\",\n    card: \"•••• 4444\",\n  },\n  {\n    id: 3,\n    merchant: \"AWS Services\",\n    date: \"Jun 24, 2026 · 08:00\",\n    amount: \"-$840.12\",\n    card: \"Main Wallet\",\n  },\n] as const\n\nfunction ChipMark({ className }: { className?: string }) {\n  return (\n    <svg\n      className={cn(\"size-9 opacity-90\", className)}\n      viewBox=\"0 0 40 32\"\n      fill=\"none\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      aria-hidden\n    >\n      <rect\n        x=\"0.5\"\n        y=\"0.5\"\n        width=\"39\"\n        height=\"31\"\n        rx=\"5.5\"\n        stroke=\"currentColor\"\n        strokeWidth=\"1\"\n        strokeOpacity=\"0.8\"\n      />\n      <path d=\"M12 16H40\" stroke=\"currentColor\" strokeOpacity=\"0.6\" />\n      <path d=\"M12 24H40\" stroke=\"currentColor\" strokeOpacity=\"0.6\" />\n      <path d=\"M12 8H40\" stroke=\"currentColor\" strokeOpacity=\"0.6\" />\n      <path d=\"M28 0V32\" stroke=\"currentColor\" strokeOpacity=\"0.6\" />\n      <path d=\"M16 0V32\" stroke=\"currentColor\" strokeOpacity=\"0.6\" />\n      <rect\n        x=\"12\"\n        y=\"8\"\n        width=\"16\"\n        height=\"16\"\n        rx=\"2\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        strokeOpacity=\"0.8\"\n      />\n    </svg>\n  )\n}\n\nfunction BrandMark({\n  src,\n  className,\n}: {\n  src: string\n  className?: string\n}) {\n  return (\n    <span className=\"inline-flex shrink-0 items-center rounded-md bg-white px-1.5 py-0.5\">\n      <img\n        src={src}\n        alt=\"\"\n        className={cn(\"h-4 w-auto object-contain\", className)}\n      />\n    </span>\n  )\n}\n\nfunction ActionButton({\n  children,\n  className,\n  ...props\n}: React.ComponentProps<typeof Button>) {\n  return (\n    <Button\n      type=\"button\"\n      variant=\"outline\"\n      className={cn(\"h-12 flex-1 cursor-pointer font-medium\", className)}\n      {...props}\n    >\n      {children}\n    </Button>\n  )\n}\n\nexport default function PaymentMethods({\n  className,\n  ...props\n}: React.ComponentProps<\"main\">) {\n  const [showNumbers, setShowNumbers] = React.useState(false)\n  const [frozen, setFrozen] = React.useState(false)\n\n  return (\n    <main\n      className={cn(\n        \"w-full min-w-0 bg-white px-4 py-10 text-foreground dark:bg-background sm:px-6\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto max-w-6xl space-y-12\">\n        <div className=\"flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center\">\n          <div className=\"min-w-0 text-start\">\n            <h1 className=\"text-3xl font-semibold tracking-tight text-foreground\">\n              Cards &amp; Wallets\n            </h1>\n            <p className=\"mt-2 text-muted-foreground\">\n              Manage your physical cards and digital wallet balances.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap gap-3\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              className=\"cursor-pointer\"\n              onClick={() => setShowNumbers((v) => !v)}\n            >\n              {showNumbers ? (\n                <EyeOffIcon aria-hidden />\n              ) : (\n                <EyeIcon aria-hidden />\n              )}\n              {showNumbers ? \"Hide numbers\" : \"Show numbers\"}\n            </Button>\n            <Button type=\"button\" className=\"cursor-pointer\">\n              <PlusIcon aria-hidden />\n              Add Card\n            </Button>\n          </div>\n        </div>\n\n        <div className=\"grid gap-8 md:grid-cols-2 lg:grid-cols-3\">\n          <div className=\"flex flex-col gap-4\">\n            <div className=\"relative flex h-[240px] flex-col justify-between overflow-hidden rounded-[12px] border border-border/70 bg-card p-8 shadow-soft\">\n              <div className=\"relative z-10 flex items-start justify-between gap-3\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"flex size-10 items-center justify-center rounded-full bg-muted\">\n                    <WalletIcon\n                      className=\"size-5 text-muted-foreground\"\n                      aria-hidden\n                    />\n                  </div>\n                  <p className=\"text-lg font-semibold text-foreground\">\n                    Main Wallet\n                  </p>\n                </div>\n                <Badge variant=\"secondary\">Virtual</Badge>\n              </div>\n\n              <div className=\"relative z-10 text-start\">\n                <p className=\"mb-2 text-sm font-medium tracking-wide text-muted-foreground uppercase\">\n                  Available Balance\n                </p>\n                <p\n                  dir=\"ltr\"\n                  className=\"text-3xl font-semibold tracking-tight tabular-nums text-foreground\"\n                >\n                  $12,450.00\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex gap-3\">\n              <ActionButton>\n                <ArrowDownToLineIcon className=\"opacity-70\" aria-hidden />\n                Top Up\n              </ActionButton>\n              <ActionButton>\n                <ArrowRightLeftIcon className=\"opacity-70\" aria-hidden />\n                Transfer\n              </ActionButton>\n            </div>\n          </div>\n\n          <div className=\"flex flex-col gap-4\">\n            <div\n              className={cn(\n                \"relative flex h-[240px] flex-col justify-between overflow-hidden rounded-[12px] bg-primary p-8 !text-white shadow-soft\",\n                frozen && \"opacity-80\"\n              )}\n            >\n              <div className=\"relative z-10 flex items-start justify-between gap-3\">\n                <ChipMark className=\"text-white\" />\n                <div className=\"flex flex-col items-end gap-2\">\n                  <BrandMark src={VISA} />\n                  <Badge className=\"border-white/30 bg-white/20 !text-white hover:bg-white/25\">\n                    {frozen ? \"Frozen\" : \"Physical\"}\n                  </Badge>\n                </div>\n              </div>\n\n              <div className=\"relative z-10 space-y-5 text-start\">\n                <p\n                  dir=\"ltr\"\n                  className=\"font-mono text-2xl font-medium tracking-wide\"\n                >\n                  {showNumbers\n                    ? \"4111 2222 3333 4444\"\n                    : \"•••• •••• •••• 4444\"}\n                </p>\n                <div className=\"flex items-end justify-between gap-4\">\n                  <div>\n                    <p className=\"text-xs font-semibold tracking-wide text-white/70 uppercase\">\n                      Cardholder\n                    </p>\n                    <p className=\"text-sm font-semibold tracking-wide\">\n                      Alex Johnson\n                    </p>\n                  </div>\n                  <div className=\"text-end\">\n                    <p className=\"text-xs font-semibold tracking-wide text-white/70 uppercase\">\n                      Valid Thru\n                    </p>\n                    <p\n                      dir=\"ltr\"\n                      className=\"font-mono text-sm font-semibold tracking-wide\"\n                    >\n                      {showNumbers ? \"12/28\" : \"••/••\"}\n                    </p>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"flex gap-3\">\n              <ActionButton\n                variant={frozen ? \"default\" : \"outline\"}\n                onClick={() => setFrozen((v) => !v)}\n                aria-pressed={frozen}\n              >\n                <SnowflakeIcon className=\"opacity-70\" aria-hidden />\n                {frozen ? \"Unfreeze\" : \"Freeze\"}\n              </ActionButton>\n              <ActionButton>\n                <SettingsIcon className=\"opacity-70\" aria-hidden />\n                Settings\n              </ActionButton>\n            </div>\n          </div>\n\n          <div className=\"flex flex-col gap-4\">\n            <div className=\"relative flex h-[240px] flex-col justify-between overflow-hidden rounded-[12px] border border-border/70 bg-card p-8 shadow-soft\">\n              <div className=\"relative z-10 flex items-start justify-between gap-3\">\n                <div className=\"flex items-center gap-3\">\n                  <div\n                    className=\"flex size-10 shrink-0 items-center justify-center rounded-full bg-muted text-sm font-semibold text-foreground\"\n                    aria-hidden\n                  >\n                    €\n                  </div>\n                  <p className=\"text-lg font-semibold text-foreground\">\n                    Euro Wallet\n                  </p>\n                </div>\n                <DropdownMenu>\n                  <DropdownMenuTrigger asChild>\n                    <Button\n                      type=\"button\"\n                      variant=\"ghost\"\n                      size=\"icon-sm\"\n                      aria-label=\"Wallet options\"\n                      className=\"-me-2 cursor-pointer\"\n                    >\n                      <MoreHorizontalIcon aria-hidden />\n                    </Button>\n                  </DropdownMenuTrigger>\n                  <DropdownMenuContent align=\"end\" className=\"w-44\">\n                    <DropdownMenuItem className=\"cursor-pointer\">\n                      View statements\n                    </DropdownMenuItem>\n                    <DropdownMenuItem className=\"cursor-pointer\">\n                      Set as default\n                    </DropdownMenuItem>\n                    <DropdownMenuItem\n                      variant=\"destructive\"\n                      className=\"cursor-pointer\"\n                    >\n                      Close wallet\n                    </DropdownMenuItem>\n                  </DropdownMenuContent>\n                </DropdownMenu>\n              </div>\n\n              <div className=\"relative z-10 text-start\">\n                <p className=\"mb-2 text-sm font-medium tracking-wide text-muted-foreground uppercase\">\n                  Available Balance\n                </p>\n                <p\n                  dir=\"ltr\"\n                  className=\"text-3xl font-semibold tracking-tight tabular-nums text-foreground\"\n                >\n                  €3,890.50\n                </p>\n                <p\n                  dir=\"ltr\"\n                  className=\"mt-2 text-sm font-medium tracking-wide text-muted-foreground\"\n                >\n                  ≈ $4,240.65 USD\n                </p>\n              </div>\n            </div>\n\n            <div className=\"flex gap-3\">\n              <ActionButton>\n                <ArrowRightLeftIcon className=\"opacity-70\" aria-hidden />\n                Convert\n              </ActionButton>\n              <ActionButton>\n                <ArrowDownToLineIcon className=\"opacity-70\" aria-hidden />\n                Withdraw\n              </ActionButton>\n            </div>\n          </div>\n        </div>\n\n        <section className=\"pt-2\">\n          <h2 className=\"mb-6 text-start text-xl font-semibold tracking-tight text-foreground\">\n            Recent Card Activity\n          </h2>\n          <div className=\"overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\">\n            <ul className=\"divide-y divide-border/70\" role=\"list\">\n              {ACTIVITY.map((tx) => (\n                <li key={tx.id}>\n                  <button\n                    type=\"button\"\n                    className=\"flex w-full cursor-pointer items-center justify-between gap-4 p-5 text-start transition-colors hover:bg-muted/40\"\n                  >\n                    <span className=\"flex min-w-0 items-center gap-4\">\n                      <span className=\"flex size-12 shrink-0 items-center justify-center rounded-full border border-border/70 bg-muted shadow-xs\">\n                        <CreditCardIcon\n                          className=\"size-5 text-muted-foreground\"\n                          aria-hidden\n                        />\n                      </span>\n                      <span className=\"min-w-0\">\n                        <span className=\"block font-semibold text-foreground\">\n                          {tx.merchant}\n                        </span>\n                        <span className=\"block text-sm text-muted-foreground\">\n                          {tx.date}\n                          <span className=\"mx-1.5 opacity-50\" aria-hidden>\n                            •\n                          </span>\n                          <span dir=\"ltr\">{tx.card}</span>\n                        </span>\n                      </span>\n                    </span>\n                    <span\n                      dir=\"ltr\"\n                      className=\"shrink-0 font-semibold tabular-nums text-foreground\"\n                    >\n                      {tx.amount}\n                    </span>\n                  </button>\n                </li>\n              ))}\n            </ul>\n            <div className=\"border-t border-border/70 bg-muted/40 p-3\">\n              <Button\n                type=\"button\"\n                variant=\"ghost\"\n                className=\"h-10 w-full cursor-pointer text-sm font-medium\"\n              >\n                View all transactions\n              </Button>\n            </div>\n          </div>\n        </section>\n      </div>\n    </main>\n  )\n}\n",
      "target": "components/blocks/payments-billing/payment-methods-01/payment-methods.tsx"
    },
