      "type": "registry:component",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  CheckCircle2Icon,\n  FilterIcon,\n  GitCommitIcon,\n  MessageSquareIcon,\n  RocketIcon,\n  ShieldAlertIcon,\n  UserPlusIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\nimport { cn } from \"@/lib/utils\"\n\nimport alexImg from \"./images/alex.webp\"\nimport davidImg from \"./images/david.webp\"\nimport mariaImg from \"./images/maria.webp\"\nimport sarahImg from \"./images/sarah.webp\"\n\nfunction assetSrc(asset: string | { src: string }) {\n  return typeof asset === \"string\" ? asset : asset.src\n}\n\nconst FILTERS = [\n  { id: \"all\", label: \"All\" },\n  { id: \"team\", label: \"Team\" },\n  { id: \"code\", label: \"Code\" },\n  { id: \"system\", label: \"System\" },\n] as const\n\ntype FilterId = (typeof FILTERS)[number][\"id\"]\ntype Category = Exclude<FilterId, \"all\">\n\ntype Activity = {\n  id: string\n  day: \"today\" | \"yesterday\" | \"earlier\"\n  category: Category\n  user: string\n  initials: string\n  avatar: string | null\n  action: string\n  target: string\n  time: string\n  detail?: string\n  icon: React.ElementType\n  iconClass: string\n  iconWrap: string\n}\n\nconst ACTIVITIES: Activity[] = [\n  {\n    id: \"1\",\n    day: \"today\",\n    category: \"team\",\n    user: \"Sarah Jenkins\",\n    initials: \"SJ\",\n    avatar: assetSrc(sarahImg),\n    action: \"commented on\",\n    target: \"Pricing page draft\",\n    time: \"12m ago\",\n    detail:\n      \"Can we tighten the hero line and move the secondary CTA under the fold?\",\n    icon: MessageSquareIcon,\n    iconClass: \"text-sky-600 dark:text-sky-400\",\n    iconWrap: \"bg-sky-500/10\",\n  },\n  {\n    id: \"2\",\n    day: \"today\",\n    category: \"code\",\n    user: \"Alex Rivera\",\n    initials: \"AR\",\n    avatar: assetSrc(alexImg),\n    action: \"deployed\",\n    target: \"web@2.14.0\",\n    time: \"1h ago\",\n    detail: \"Production · us-east-1 · build #1842\",\n    icon: RocketIcon,\n    iconClass: \"text-violet-600 dark:text-violet-400\",\n    iconWrap: \"bg-violet-500/10\",\n  },\n  {\n    id: \"3\",\n    day: \"today\",\n    category: \"code\",\n    user: \"Alex Rivera\",\n    initials: \"AR\",\n    avatar: assetSrc(alexImg),\n    action: \"pushed to\",\n    target: \"main\",\n    time: \"2h ago\",\n    detail: \"fix: stabilize activity feed hydration (#512)\",\n    icon: GitCommitIcon,\n    iconClass: \"text-emerald-700 dark:text-emerald-400\",\n    iconWrap: \"bg-emerald-500/10\",\n  },\n  {\n    id: \"4\",\n    day: \"yesterday\",\n    category: \"team\",\n    user: \"David Chen\",\n    initials: \"DC\",\n    avatar: assetSrc(davidImg),\n    action: \"invited\",\n    target: \"Jordan Lee\",\n    time: \"Yesterday, 4:20 PM\",\n    icon: UserPlusIcon,\n    iconClass: \"text-primary\",\n    iconWrap: \"bg-primary/10\",\n  },\n  {\n    id: \"5\",\n    day: \"yesterday\",\n    category: \"system\",\n    user: \"System\",\n    initials: \"SY\",\n    avatar: null,\n    action: \"completed backup for\",\n    target: \"Primary DB\",\n    time: \"Yesterday, 12:00 AM\",\n    detail: \"48GB archived · retention 30 days\",\n    icon: CheckCircle2Icon,\n    iconClass: \"text-emerald-700 dark:text-emerald-400\",\n    iconWrap: \"bg-emerald-500/10\",\n  },\n  {\n    id: \"6\",\n    day: \"earlier\",\n    category: \"system\",\n    user: \"Security\",\n    initials: \"SEC\",\n    avatar: null,\n    action: \"flagged login risk for\",\n    target: \"admin@acme.com\",\n    time: \"Oct 24\",\n    detail: \"3 failed attempts from a new device in 8 minutes.\",\n    icon: ShieldAlertIcon,\n    iconClass: \"text-destructive\",\n    iconWrap: \"bg-destructive/10\",\n  },\n  {\n    id: \"7\",\n    day: \"earlier\",\n    category: \"team\",\n    user: \"Maria Garcia\",\n    initials: \"MG\",\n    avatar: assetSrc(mariaImg),\n    action: \"shared\",\n    target: \"Brand guidelines\",\n    time: \"Oct 23\",\n    icon: MessageSquareIcon,\n    iconClass: \"text-amber-600 dark:text-amber-400\",\n    iconWrap: \"bg-amber-500/10\",\n  },\n]\n\nconst DAY_LABELS: Record<Activity[\"day\"], string> = {\n  today: \"Today\",\n  yesterday: \"Yesterday\",\n  earlier: \"Earlier\",\n}\n\nconst DAY_ORDER: Activity[\"day\"][] = [\"today\", \"yesterday\", \"earlier\"]\n\nexport default function ActivityFeed({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [filter, setFilter] = React.useState<FilterId>(\"all\")\n\n  const filtered = ACTIVITIES.filter(\n    (item) => filter === \"all\" || item.category === filter\n  )\n\n  const groups = DAY_ORDER.map((day) => ({\n    day,\n    items: filtered.filter((item) => item.day === day),\n  })).filter((group) => group.items.length > 0)\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-16\",\n        className\n      )}\n      {...props}\n    >\n      <Card className=\"mx-auto max-w-2xl overflow-hidden border-border/70 shadow-soft\">\n        <CardHeader className=\"border-b border-border/70 pb-4\">\n          <div className=\"flex flex-wrap items-start justify-between gap-3\">\n            <div className=\"text-start\">\n              <CardTitle>Activity</CardTitle>\n              <CardDescription>\n                Grouped by day — filter by team, code, or system.\n              </CardDescription>\n            </div>\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              size=\"sm\"\n              className=\"cursor-pointer gap-1.5\"\n            >\n              <FilterIcon className=\"size-4\" aria-hidden />\n              Filters\n            </Button>\n          </div>\n\n          <div\n            className=\"mt-4 flex flex-wrap gap-2\"\n            role=\"tablist\"\n            aria-label=\"Activity filters\"\n          >\n            {FILTERS.map((item) => {\n              const active = filter === item.id\n              return (\n                <button\n                  key={item.id}\n                  type=\"button\"\n                  role=\"tab\"\n                  aria-selected={active}\n                  className={cn(\n                    \"cursor-pointer rounded-full border px-3 py-1.5 text-xs font-medium transition-colors\",\n                    active\n                      ? \"border-primary/40 bg-primary text-primary-foreground\"\n                      : \"border-border/70 bg-card text-muted-foreground hover:bg-muted/50 hover:text-foreground\"\n                  )}\n                  onClick={() => setFilter(item.id)}\n                >\n                  {item.label}\n                </button>\n              )\n            })}\n          </div>\n        </CardHeader>\n\n        <CardContent className=\"p-0\">\n          {groups.length === 0 ? (\n            <p className=\"px-6 py-10 text-center text-sm text-muted-foreground\">\n              No activity in this filter.\n            </p>\n          ) : (\n            groups.map((group) => (\n              <section key={group.day} aria-labelledby={`feed-day-${group.day}`}>\n                <h2\n                  id={`feed-day-${group.day}`}\n                  className=\"sticky top-0 z-10 border-b border-border/70 bg-muted/50 px-5 py-2 text-xs font-semibold tracking-wide text-muted-foreground backdrop-blur-sm sm:px-6\"\n                >\n                  {DAY_LABELS[group.day]}\n                </h2>\n                <ul className=\"divide-y divide-border/70\">\n                  {group.items.map((activity) => {\n                    const Icon = activity.icon\n                    return (\n                      <li\n                        key={activity.id}\n                        className=\"flex items-start gap-3 px-5 py-4 sm:gap-4 sm:px-6\"\n                      >\n                        <span\n                          className={cn(\n                            \"mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-full\",\n                            activity.iconWrap\n                          )}\n                        >\n                          <Icon\n                            className={cn(\"size-4\", activity.iconClass)}\n                            aria-hidden\n                          />\n                        </span>\n                        <div className=\"min-w-0 flex-1 text-start\">\n                          <div className=\"flex flex-wrap items-center gap-2\">\n                            {activity.avatar ? (\n                              <Avatar size=\"sm\">\n                                <AvatarImage\n                                  src={activity.avatar}\n                                  alt=\"\"\n                                />\n                                <AvatarFallback>\n                                  {activity.initials}\n                                </AvatarFallback>\n                              </Avatar>\n                            ) : (\n                              <Badge variant=\"secondary\">\n                                {activity.user}\n                              </Badge>\n                            )}\n                            <p className=\"min-w-0 flex-1 text-sm\">\n                              <span className=\"font-semibold text-foreground\">\n                                {activity.user}\n                              </span>{\" \"}\n                              <span className=\"text-muted-foreground\">\n                                {activity.action}\n                              </span>{\" \"}\n                              <span className=\"font-medium text-foreground\">\n                                {activity.target}\n                              </span>\n                            </p>\n                            <time className=\"shrink-0 text-xs text-muted-foreground\">\n                              {activity.time}\n                            </time>\n                          </div>\n                          {activity.detail ? (\n                            <div className=\"mt-2 rounded-[10px] border border-border/70 bg-muted/40 px-3 py-2 text-sm text-muted-foreground\">\n                              {activity.category === \"code\" &&\n                              activity.detail.startsWith(\"fix:\") ? (\n                                <code className=\"font-mono text-xs\" dir=\"ltr\">\n                                  {activity.detail}\n                                </code>\n                              ) : (\n                                <p>{activity.detail}</p>\n                              )}\n                            </div>\n                          ) : null}\n                        </div>\n                      </li>\n                    )\n                  })}\n                </ul>\n              </section>\n            ))\n          )}\n\n          <div className=\"border-t border-border/70 px-5 py-4 sm:px-6\">\n            <Button\n              type=\"button\"\n              variant=\"ghost\"\n              className=\"w-full cursor-pointer\"\n            >\n              Load more activity\n            </Button>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  )\n}\n",
      "target": "components/blocks/communication/activity-feed-04/activity-feed.tsx"
    },
