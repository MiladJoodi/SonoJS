      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowDownToLineIcon,\n  CheckCircle2Icon,\n  Clock3Icon,\n  FileTextIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Separator } from \"@/components/ui/separator\"\nimport { cn } from \"@/lib/utils\"\n\ntype InvoiceStatus = \"paid\" | \"open\" | \"past_due\"\n\ntype Invoice = {\n  id: string\n  label: string\n  period: string\n  amount: string\n  status: InvoiceStatus\n  issued: string\n}\n\nconst MONTHS = [\n  {\n    month: \"June 2026\",\n    invoices: [\n      {\n        id: \"INV-2406\",\n        label: \"Pro · Seat expansion\",\n        period: \"Jun 1 – Jun 30\",\n        amount: \"$147.00\",\n        status: \"paid\" as const,\n        issued: \"Jun 1, 2026\",\n      },\n      {\n        id: \"INV-2405\",\n        label: \"Pro · Monthly\",\n        period: \"Jun 1 – Jun 30\",\n        amount: \"$49.00\",\n        status: \"paid\" as const,\n        issued: \"Jun 1, 2026\",\n      },\n    ],\n  },\n  {\n    month: \"May 2026\",\n    invoices: [\n      {\n        id: \"INV-2404\",\n        label: \"Pro · Monthly\",\n        period: \"May 1 – May 31\",\n        amount: \"$49.00\",\n        status: \"paid\" as const,\n        issued: \"May 1, 2026\",\n      },\n      {\n        id: \"INV-2403\",\n        label: \"Usage overage\",\n        period: \"Apr 15 – May 1\",\n        amount: \"$18.40\",\n        status: \"open\" as const,\n        issued: \"May 2, 2026\",\n      },\n    ],\n  },\n  {\n    month: \"April 2026\",\n    invoices: [\n      {\n        id: \"INV-2402\",\n        label: \"Pro · Monthly\",\n        period: \"Apr 1 – Apr 30\",\n        amount: \"$49.00\",\n        status: \"past_due\" as const,\n        issued: \"Apr 1, 2026\",\n      },\n    ],\n  },\n] as const\n\nfunction StatusBadge({ status }: { status: InvoiceStatus }) {\n  if (status === \"paid\") {\n    return (\n      <Badge className=\"gap-1 border-transparent bg-emerald-500/15 font-medium text-emerald-700 dark:text-emerald-400\">\n        <CheckCircle2Icon className=\"size-3\" aria-hidden />\n        Paid\n      </Badge>\n    )\n  }\n  if (status === \"open\") {\n    return (\n      <Badge className=\"gap-1 border-transparent bg-sky-500/15 font-medium text-sky-700 dark:text-sky-400\">\n        <Clock3Icon className=\"size-3\" aria-hidden />\n        Open\n      </Badge>\n    )\n  }\n  return (\n    <Badge variant=\"destructive\" className=\"gap-1 font-medium\">\n      Past due\n    </Badge>\n  )\n}\n\nexport default function BillingHistory({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  return (\n    <section\n      className={cn(\n        \"relative isolate w-full min-w-0 overflow-hidden bg-white py-10 text-foreground dark:bg-background sm:py-14\",\n        className\n      )}\n      aria-labelledby=\"billing-history-02-heading\"\n      {...props}\n    >\n      <div aria-hidden className=\"pointer-events-none absolute inset-0 -z-10\">\n        <div className=\"absolute inset-e-[-10%] top-10 size-72 rounded-full bg-primary/8 blur-3xl\" />\n        <div className=\"absolute inset-s-[-8%] bottom-0 size-64 rounded-full bg-emerald-500/5 blur-3xl\" />\n      </div>\n\n      <div className=\"mx-auto w-full max-w-2xl px-4 sm:px-6\">\n        <header className=\"mb-8 flex flex-col gap-4 text-start sm:flex-row sm:items-end sm:justify-between\">\n          <div>\n            <p className=\"text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase\">\n              Statements\n            </p>\n            <h1\n              id=\"billing-history-02-heading\"\n              className=\"mt-1 text-3xl font-semibold tracking-tight\"\n            >\n              Invoice archive\n            </h1>\n            <p className=\"mt-2 text-sm text-muted-foreground\">\n              Month-by-month PDF invoices for Acme Studio.\n            </p>\n          </div>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            size=\"sm\"\n            className=\"cursor-pointer gap-1.5\"\n          >\n            <ArrowDownToLineIcon className=\"size-3.5\" aria-hidden />\n            Download all\n          </Button>\n        </header>\n\n        <div className=\"space-y-8\">\n          {MONTHS.map((group) => (\n            <div key={group.month}>\n              <div className=\"mb-3 flex items-center gap-3\">\n                <h2 className=\"text-sm font-semibold tracking-tight\">\n                  {group.month}\n                </h2>\n                <Separator className=\"flex-1\" />\n                <span className=\"text-xs text-muted-foreground tabular-nums\">\n                  {group.invoices.length}{\" \"}\n                  {group.invoices.length === 1 ? \"invoice\" : \"invoices\"}\n                </span>\n              </div>\n\n              <ul className=\"overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\">\n                {group.invoices.map((invoice, index) => (\n                  <li key={invoice.id}>\n                    {index > 0 ? <Separator /> : null}\n                    <div className=\"flex flex-col gap-3 px-4 py-4 sm:flex-row sm:items-center sm:gap-4 sm:px-5\">\n                      <span className=\"flex size-10 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground\">\n                        <FileTextIcon className=\"size-4\" aria-hidden />\n                      </span>\n                      <div className=\"min-w-0 flex-1 text-start\">\n                        <div className=\"flex flex-wrap items-center gap-2\">\n                          <p className=\"text-sm font-semibold\" dir=\"ltr\">\n                            {invoice.id}\n                          </p>\n                          <StatusBadge status={invoice.status} />\n                        </div>\n                        <p className=\"mt-0.5 text-sm text-muted-foreground\">\n                          {invoice.label}\n                        </p>\n                        <p className=\"mt-0.5 text-xs text-muted-foreground\">\n                          {invoice.period}\n                          <span className=\"mx-1.5 opacity-50\" aria-hidden>\n                            ·\n                          </span>\n                          Issued {invoice.issued}\n                        </p>\n                      </div>\n                      <div className=\"flex items-center justify-between gap-3 sm:flex-col sm:items-end sm:justify-center\">\n                        <p\n                          dir=\"ltr\"\n                          className=\"text-base font-semibold tabular-nums\"\n                        >\n                          {invoice.amount}\n                        </p>\n                        <Button\n                          type=\"button\"\n                          variant=\"ghost\"\n                          size=\"sm\"\n                          className=\"h-8 cursor-pointer gap-1.5 px-2\"\n                        >\n                          <ArrowDownToLineIcon\n                            className=\"size-3.5\"\n                            aria-hidden\n                          />\n                          PDF\n                        </Button>\n                      </div>\n                    </div>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  )\n}\n",
      "target": "components/blocks/payments-billing/billing-history-02/billing-history.tsx"
