      "type": "registry:component",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  DownloadIcon,\n  EllipsisIcon,\n  PlusIcon,\n  SearchIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Checkbox } from \"@/components/ui/checkbox\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { Input } from \"@/components/ui/input\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\ntype InvoiceStatus = \"paid\" | \"pending\" | \"overdue\" | \"draft\"\n\ntype Invoice = {\n  id: string\n  number: string\n  customer: string\n  email: string\n  initials: string\n  amount: string\n  issued: string\n  status: InvoiceStatus\n}\n\nconst FILTERS = [\n  { id: \"all\", label: \"All\" },\n  { id: \"paid\", label: \"Paid\" },\n  { id: \"pending\", label: \"Pending\" },\n  { id: \"overdue\", label: \"Overdue\" },\n  { id: \"draft\", label: \"Draft\" },\n] as const\n\ntype FilterId = (typeof FILTERS)[number][\"id\"]\n\nconst INVOICES: Invoice[] = [\n  {\n    id: \"1\",\n    number: \"INV-2048\",\n    customer: \"Northwind Labs\",\n    email: \"billing@northwind.dev\",\n    initials: \"NL\",\n    amount: \"$2,480.00\",\n    issued: \"Mar 12, 2026\",\n    status: \"paid\",\n  },\n  {\n    id: \"2\",\n    number: \"INV-2049\",\n    customer: \"Acme Retail\",\n    email: \"ap@acmeretail.com\",\n    initials: \"AR\",\n    amount: \"$890.00\",\n    issued: \"Mar 14, 2026\",\n    status: \"pending\",\n  },\n  {\n    id: \"3\",\n    number: \"INV-2050\",\n    customer: \"Orbit Media\",\n    email: \"finance@orbit.media\",\n    initials: \"OM\",\n    amount: \"$4,120.00\",\n    issued: \"Mar 02, 2026\",\n    status: \"overdue\",\n  },\n  {\n    id: \"4\",\n    number: \"INV-2051\",\n    customer: \"Pixel Forge\",\n    email: \"hello@pixelforge.io\",\n    initials: \"PF\",\n    amount: \"$1,050.00\",\n    issued: \"Mar 18, 2026\",\n    status: \"paid\",\n  },\n  {\n    id: \"5\",\n    number: \"INV-2052\",\n    customer: \"Harbor Health\",\n    email: \"ops@harbor.health\",\n    initials: \"HH\",\n    amount: \"$640.00\",\n    issued: \"Mar 20, 2026\",\n    status: \"draft\",\n  },\n  {\n    id: \"6\",\n    number: \"INV-2053\",\n    customer: \"Brightline Co\",\n    email: \"accounts@brightline.co\",\n    initials: \"BC\",\n    amount: \"$3,275.00\",\n    issued: \"Mar 08, 2026\",\n    status: \"pending\",\n  },\n]\n\nconst statusStyles: Record<\n  InvoiceStatus,\n  { label: string; className: string; dot: string }\n> = {\n  paid: {\n    label: \"Paid\",\n    className:\n      \"border-transparent bg-emerald-500/10 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400\",\n    dot: \"bg-emerald-500\",\n  },\n  pending: {\n    label: \"Pending\",\n    className:\n      \"border-transparent bg-amber-500/10 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400\",\n    dot: \"bg-amber-500\",\n  },\n  overdue: {\n    label: \"Overdue\",\n    className:\n      \"border-transparent bg-rose-500/10 text-rose-700 dark:bg-rose-500/15 dark:text-rose-400\",\n    dot: \"bg-rose-500\",\n  },\n  draft: {\n    label: \"Draft\",\n    className: \"border-transparent bg-muted text-muted-foreground\",\n    dot: \"bg-muted-foreground\",\n  },\n}\n\nfunction StatusBadge({ status }: { status: InvoiceStatus }) {\n  const styles = statusStyles[status]\n  return (\n    <Badge\n      variant=\"outline\"\n      className={cn(\"h-6 gap-1.5 rounded-full px-2\", styles.className)}\n    >\n      <span aria-hidden className={cn(\"size-1.5 rounded-full\", styles.dot)} />\n      {styles.label}\n    </Badge>\n  )\n}\n\nfunction RowMenu({ number }: { number: string }) {\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger asChild>\n        <Button\n          type=\"button\"\n          variant=\"ghost\"\n          size=\"icon-sm\"\n          className=\"size-8 cursor-pointer rounded-lg text-muted-foreground\"\n          aria-label={`Actions for ${number}`}\n        >\n          <EllipsisIcon className=\"size-4\" aria-hidden />\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\" className=\"w-44\">\n        <DropdownMenuItem className=\"cursor-pointer\">View</DropdownMenuItem>\n        <DropdownMenuItem className=\"cursor-pointer\">\n          Download PDF\n        </DropdownMenuItem>\n        <DropdownMenuItem className=\"cursor-pointer\">\n          Send reminder\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem className=\"cursor-pointer text-destructive focus:text-destructive\">\n          Void invoice\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n\nfunction InvoiceCard({\n  invoice,\n  checked,\n  onCheckedChange,\n}: {\n  invoice: Invoice\n  checked: boolean\n  onCheckedChange: (next: boolean) => void\n}) {\n  return (\n    <li className=\"rounded-[12px] border border-border/70 bg-card p-4 shadow-soft\">\n      <div className=\"flex items-start gap-3\">\n        <Checkbox\n          checked={checked}\n          onCheckedChange={(v) => onCheckedChange(v === true)}\n          aria-label={`Select ${invoice.number}`}\n          className=\"mt-1 cursor-pointer\"\n        />\n        <div className=\"min-w-0 flex-1\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2\">\n            <p dir=\"ltr\" className=\"font-medium tabular-nums text-foreground\">\n              {invoice.number}\n            </p>\n            <StatusBadge status={invoice.status} />\n          </div>\n          <div className=\"mt-3 flex items-center gap-2.5\">\n            <Avatar className=\"size-8\">\n              <AvatarFallback className=\"bg-primary/10 text-xs font-medium text-primary\">\n                {invoice.initials}\n              </AvatarFallback>\n            </Avatar>\n            <div className=\"min-w-0\">\n              <p className=\"truncate text-sm font-medium text-foreground\">\n                {invoice.customer}\n              </p>\n              <p\n                dir=\"ltr\"\n                className=\"truncate text-xs text-muted-foreground text-start\"\n              >\n                {invoice.email}\n              </p>\n            </div>\n          </div>\n          <dl className=\"mt-3 grid gap-1.5 text-sm\">\n            <div className=\"flex justify-between gap-3\">\n              <dt className=\"text-muted-foreground\">Amount</dt>\n              <dd\n                dir=\"ltr\"\n                className=\"font-medium tabular-nums text-foreground\"\n              >\n                {invoice.amount}\n              </dd>\n            </div>\n            <div className=\"flex justify-between gap-3\">\n              <dt className=\"text-muted-foreground\">Issued</dt>\n              <dd dir=\"ltr\" className=\"tabular-nums text-foreground\">\n                {invoice.issued}\n              </dd>\n            </div>\n          </dl>\n          <div className=\"mt-3 flex justify-end\">\n            <RowMenu number={invoice.number} />\n          </div>\n        </div>\n      </div>\n    </li>\n  )\n}\n\nexport default function DataTable02({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [query, setQuery] = React.useState(\"\")\n  const [filter, setFilter] = React.useState<FilterId>(\"all\")\n  const [selected, setSelected] = React.useState<Set<string>>(new Set())\n\n  const rows = INVOICES.filter((invoice) => {\n    if (filter !== \"all\" && invoice.status !== filter) return false\n    const q = query.trim().toLowerCase()\n    if (!q) return true\n    return (\n      invoice.number.toLowerCase().includes(q) ||\n      invoice.customer.toLowerCase().includes(q) ||\n      invoice.email.toLowerCase().includes(q)\n    )\n  })\n\n  const allSelected = rows.length > 0 && rows.every((r) => selected.has(r.id))\n  const someSelected = rows.some((r) => selected.has(r.id))\n\n  const toggleAll = (next: boolean) => {\n    setSelected((prev) => {\n      const copy = new Set(prev)\n      for (const row of rows) {\n        if (next) copy.add(row.id)\n        else copy.delete(row.id)\n      }\n      return copy\n    })\n  }\n\n  const toggleOne = (id: string, next: boolean) => {\n    setSelected((prev) => {\n      const copy = new Set(prev)\n      if (next) copy.add(id)\n      else copy.delete(id)\n      return copy\n    })\n  }\n\n  return (\n    <div className={cn(\"w-full min-w-0\", className)} {...props}>\n      <div className=\"flex flex-col gap-4\">\n        <div className=\"flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between\">\n          <div className=\"text-start\">\n            <h3 className=\"text-lg font-semibold tracking-tight text-foreground\">\n              Invoices\n            </h3>\n            <p className=\"mt-0.5 text-sm text-muted-foreground\">\n              Track payments, send reminders, and export statements.\n            </p>\n          </div>\n          <div className=\"flex flex-wrap items-center gap-2\">\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              className=\"h-10 cursor-pointer gap-2 rounded-lg\"\n            >\n              <DownloadIcon className=\"size-4\" aria-hidden />\n              Export\n            </Button>\n            <Button\n              type=\"button\"\n              className=\"h-10 cursor-pointer gap-2 rounded-lg\"\n            >\n              <PlusIcon className=\"size-4\" aria-hidden />\n              New invoice\n            </Button>\n          </div>\n        </div>\n\n        <div className=\"flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between\">\n          <div className=\"relative w-full max-w-sm\">\n            <SearchIcon\n              aria-hidden\n              className=\"pointer-events-none absolute start-3 top-1/2 size-4 -translate-y-1/2 text-muted-foreground\"\n            />\n            <Input\n              value={query}\n              onChange={(e) => setQuery(e.target.value)}\n              placeholder=\"Search invoices…\"\n              className=\"h-10 ps-9\"\n              aria-label=\"Search invoices\"\n            />\n          </div>\n          <div\n            role=\"tablist\"\n            aria-label=\"Filter by status\"\n            className=\"flex flex-wrap gap-1.5\"\n          >\n            {FILTERS.map((item) => {\n              const active = filter === item.id\n              return (\n                <button\n                  key={item.id}\n                  type=\"button\"\n                  role=\"tab\"\n                  aria-selected={active}\n                  onClick={() => setFilter(item.id)}\n                  className={cn(\n                    \"inline-flex h-8 cursor-pointer items-center rounded-full border px-3 text-xs font-medium transition-colors\",\n                    active\n                      ? \"border-transparent bg-foreground text-background\"\n                      : \"border-border/70 bg-card text-muted-foreground hover:bg-muted/60 hover:text-foreground\"\n                  )}\n                >\n                  {item.label}\n                </button>\n              )\n            })}\n          </div>\n        </div>\n\n        {someSelected ? (\n          <div className=\"flex flex-wrap items-center justify-between gap-2 rounded-[12px] border border-border/70 bg-muted/40 px-3 py-2 text-sm\">\n            <p className=\"text-muted-foreground\">\n              <span className=\"font-medium text-foreground tabular-nums\">\n                {selected.size}\n              </span>{\" \"}\n              selected\n            </p>\n            <div className=\"flex gap-2\">\n              <Button\n                type=\"button\"\n                size=\"sm\"\n                variant=\"outline\"\n                className=\"h-8 cursor-pointer rounded-lg\"\n              >\n                Mark paid\n              </Button>\n              <Button\n                type=\"button\"\n                size=\"sm\"\n                variant=\"ghost\"\n                className=\"h-8 cursor-pointer rounded-lg\"\n                onClick={() => setSelected(new Set())}\n              >\n                Clear\n              </Button>\n            </div>\n          </div>\n        ) : null}\n\n        <ul className=\"flex flex-col gap-3 md:hidden\">\n          {rows.map((invoice) => (\n            <InvoiceCard\n              key={invoice.id}\n              invoice={invoice}\n              checked={selected.has(invoice.id)}\n              onCheckedChange={(next) => toggleOne(invoice.id, next)}\n            />\n          ))}\n          {rows.length === 0 ? (\n            <li className=\"rounded-[12px] border border-dashed border-border/70 px-4 py-10 text-center text-sm text-muted-foreground\">\n              No invoices match your filters.\n            </li>\n          ) : null}\n        </ul>\n\n        <div className=\"hidden rounded-[12px] border border-border/70 bg-card shadow-soft md:block\">\n          <Table className=\"min-w-200\">\n            <TableHeader>\n              <TableRow className=\"hover:bg-transparent\">\n                <TableHead className=\"w-12 pe-0\">\n                  <Checkbox\n                    checked={\n                      allSelected ? true : someSelected ? \"indeterminate\" : false\n                    }\n                    onCheckedChange={(v) => toggleAll(v === true)}\n                    aria-label=\"Select all invoices\"\n                    className=\"cursor-pointer\"\n                  />\n                </TableHead>\n                <TableHead className=\"font-medium\">Invoice</TableHead>\n                <TableHead className=\"font-medium\">Customer</TableHead>\n                <TableHead className=\"font-medium\">Amount</TableHead>\n                <TableHead className=\"font-medium\">Issued</TableHead>\n                <TableHead className=\"font-medium\">Status</TableHead>\n                <TableHead className=\"w-12\">\n                  <span className=\"sr-only\">Actions</span>\n                </TableHead>\n              </TableRow>\n            </TableHeader>\n            <TableBody>\n              {rows.map((invoice) => (\n                <TableRow\n                  key={invoice.id}\n                  data-state={selected.has(invoice.id) ? \"selected\" : undefined}\n                  className=\"group\"\n                >\n                  <TableCell className=\"pe-0\">\n                    <Checkbox\n                      checked={selected.has(invoice.id)}\n                      onCheckedChange={(v) =>\n                        toggleOne(invoice.id, v === true)\n                      }\n                      aria-label={`Select ${invoice.number}`}\n                      className=\"cursor-pointer\"\n                    />\n                  </TableCell>\n                  <TableCell>\n                    <span\n                      dir=\"ltr\"\n                      className=\"font-medium tabular-nums text-foreground\"\n                    >\n                      {invoice.number}\n                    </span>\n                  </TableCell>\n                  <TableCell>\n                    <div className=\"flex min-w-0 items-center gap-2.5\">\n                      <Avatar className=\"size-8\">\n                        <AvatarFallback className=\"bg-primary/10 text-xs font-medium text-primary\">\n                          {invoice.initials}\n                        </AvatarFallback>\n                      </Avatar>\n                      <div className=\"min-w-0\">\n                        <p className=\"truncate text-sm font-medium text-foreground\">\n                          {invoice.customer}\n                        </p>\n                        <p\n                          dir=\"ltr\"\n                          className=\"truncate text-xs text-muted-foreground text-start\"\n                        >\n                          {invoice.email}\n                        </p>\n                      </div>\n                    </div>\n                  </TableCell>\n                  <TableCell>\n                    <span dir=\"ltr\" className=\"tabular-nums font-medium\">\n                      {invoice.amount}\n                    </span>\n                  </TableCell>\n                  <TableCell>\n                    <span dir=\"ltr\" className=\"tabular-nums text-muted-foreground\">\n                      {invoice.issued}\n                    </span>\n                  </TableCell>\n                  <TableCell>\n                    <StatusBadge status={invoice.status} />\n                  </TableCell>\n                  <TableCell className=\"text-end\">\n                    <RowMenu number={invoice.number} />\n                  </TableCell>\n                </TableRow>\n              ))}\n              {rows.length === 0 ? (\n                <TableRow className=\"hover:bg-transparent\">\n                  <TableCell\n                    colSpan={7}\n                    className=\"h-28 text-center text-muted-foreground\"\n                  >\n                    No invoices match your filters.\n                  </TableCell>\n                </TableRow>\n              ) : null}\n            </TableBody>\n          </Table>\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/data-tables/data-table-02/table.tsx"
    }
