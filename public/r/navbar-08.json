      "content": "\"use client\"\n\nimport { MenuIcon } from \"lucide-react\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Sheet,\n  SheetContent,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@/components/ui/sheet\"\n\nconst links = [\n  { label: \"Product\", href: \"#\" },\n  { label: \"Pricing\", href: \"#\" },\n  { label: \"Customers\", href: \"#\" },\n  { label: \"Docs\", href: \"#\" },\n  { label: \"Blog\", href: \"#\" },\n  { label: \"Careers\", href: \"#\" },\n]\n\nconst ctaClass =\n  \"!h-[46px] h-[46px] min-h-[46px] max-h-[46px] rounded-[12px] shadow-none\"\n\nfunction Brand() {\n  return (\n    <a\n      href=\"#\"\n      className=\"flex cursor-pointer items-center gap-2 outline-none focus-visible:rounded-md focus-visible:ring-2 focus-visible:ring-ring\"\n    >\n      <img\n        src=\"/images/logos/logo.svg\"\n        alt=\"\"\n        width={28}\n        height={32}\n        className=\"h-8 w-auto shrink-0\"\n      />\n      <span className=\"text-sm font-semibold tracking-tight text-foreground\">\n        Sono\n      </span>\n    </a>\n  )\n}\n\nexport default function Navbar({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      className={cn(\n        \"flex h-full min-h-[28rem] w-full flex-col bg-card\",\n        className\n      )}\n      {...props}\n    >\n      <header className=\"border-b border-border/70 bg-card\">\n        <div className=\"mx-auto flex min-h-[62px] w-full max-w-5xl items-center gap-3 px-4 sm:px-6\">\n          <Brand />\n\n          <nav className=\"ms-2 hidden items-center gap-1 md:flex\">\n            {links.map((link) => (\n              <a\n                key={link.label}\n                href={link.href}\n                className=\"cursor-pointer rounded-md px-2.5 py-1.5 text-sm font-medium text-muted-foreground transition-colors hover:text-foreground\"\n              >\n                {link.label}\n              </a>\n            ))}\n          </nav>\n\n          <div className=\"ms-auto flex items-center gap-2\">\n            <Button\n              variant=\"ghost\"\n              className={cn(\"hidden md:inline-flex\", ctaClass)}\n            >\n              Sign in\n            </Button>\n            <Button className={ctaClass}>Get started</Button>\n\n            <Sheet>\n              <SheetTrigger asChild>\n                <Button\n                  variant=\"outline\"\n                  className=\"size-[46px] min-h-[46px] max-h-[46px] min-w-[46px] max-w-[46px] rounded-[12px] border-border/70 shadow-none md:hidden\"\n                  aria-label=\"Open menu\"\n                >\n                  <MenuIcon className=\"size-4\" />\n                </Button>\n              </SheetTrigger>\n              <SheetContent\n                side=\"start\"\n                className=\"flex w-[min(100%,18rem)] flex-col gap-0 border-border/70 p-0\"\n              >\n                <SheetHeader className=\"border-b border-border/70 px-4 py-4 text-start\">\n                  <SheetTitle className=\"sr-only\">Menu</SheetTitle>\n                  <Brand />\n                </SheetHeader>\n                <nav className=\"flex flex-1 flex-col gap-0.5 overflow-y-auto p-3\">\n                  {links.map((link) => (\n                    <a\n                      key={link.label}\n                      href={link.href}\n                      className=\"cursor-pointer rounded-[12px] px-3 py-3 text-sm font-medium text-foreground hover:bg-muted\"\n                    >\n                      {link.label}\n                    </a>\n                  ))}\n                </nav>\n                <div className=\"space-y-2 border-t border-border/70 p-3\">\n                  <Button\n                    variant=\"outline\"\n                    className={cn(\"w-full border-border/70\", ctaClass)}\n                  >\n                    Sign in\n                  </Button>\n                  <Button className={cn(\"w-full\", ctaClass)}>Get started</Button>\n                </div>\n              </SheetContent>\n            </Sheet>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center gap-3 px-6 py-14\">\n        <span className=\"h-0.5 w-8 rounded-full bg-primary\" aria-hidden />\n        <h1 className=\"max-w-lg text-balance text-h3 text-foreground\">\n          Responsive with a mobile sheet\n        </h1>\n        <p className=\"max-w-md text-sm text-muted-foreground\">\n          Desktop shows the full link row. Below{\" \"}\n          <code className=\"rounded bg-muted px-1 py-0.5 text-xs\">md</code>,\n          links move into a start-edge sheet.\n        </p>\n      </main>\n    </div>\n  )\n}\n",
