      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  BarChart3Icon,\n  CreditCardIcon,\n  EllipsisVerticalIcon,\n  ExternalLinkIcon,\n  GitBranchIcon,\n  MessageSquareIcon,\n  PlusIcon,\n  Settings2Icon,\n  UnplugIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { Switch } from \"@/components/ui/switch\"\nimport { cn } from \"@/lib/utils\"\n\ntype Row = {\n  id: string\n  name: string\n  category: string\n  lastSync: string\n  enabled: boolean\n  status: \"healthy\" | \"needs-attention\" | \"paused\"\n  logo: React.ElementType\n}\n\nconst INITIAL: Row[] = [\n  {\n    id: \"slack\",\n    name: \"Slack\",\n    category: \"Communication\",\n    lastSync: \"2 min ago\",\n    enabled: true,\n    status: \"healthy\",\n    logo: MessageSquareIcon,\n  },\n  {\n    id: \"stripe\",\n    name: \"Stripe\",\n    category: \"Payments\",\n    lastSync: \"14 min ago\",\n    enabled: true,\n    status: \"healthy\",\n    logo: CreditCardIcon,\n  },\n  {\n    id: \"github\",\n    name: \"GitHub\",\n    category: \"Development\",\n    lastSync: \"1 hr ago\",\n    enabled: false,\n    status: \"paused\",\n    logo: GitBranchIcon,\n  },\n  {\n    id: \"mixpanel\",\n    name: \"Mixpanel\",\n    category: \"Analytics\",\n    lastSync: \"3 hr ago\",\n    enabled: true,\n    status: \"needs-attention\",\n    logo: BarChart3Icon,\n  },\n]\n\nfunction statusBadge(status: Row[\"status\"]) {\n  if (status === \"needs-attention\") {\n    return (\n      <Badge\n        variant=\"secondary\"\n        className=\"border-transparent bg-amber-500/15 font-medium text-amber-700 dark:text-amber-400\"\n      >\n        Needs attention\n      </Badge>\n    )\n  }\n  if (status === \"paused\") {\n    return <Badge variant=\"secondary\">Paused</Badge>\n  }\n  return (\n    <Badge\n      variant=\"secondary\"\n      className=\"border-transparent bg-emerald-500/15 font-medium text-emerald-700 dark:text-emerald-400\"\n    >\n      Healthy\n    </Badge>\n  )\n}\n\nexport default function Integrations({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  const [rows, setRows] = React.useState(INITIAL)\n\n  const toggle = (id: string, enabled: boolean) => {\n    setRows((prev) =>\n      prev.map((row) =>\n        row.id === id\n          ? {\n              ...row,\n              enabled,\n              status: enabled\n                ? row.status === \"needs-attention\"\n                  ? \"needs-attention\"\n                  : \"healthy\"\n                : \"paused\",\n            }\n          : row\n      )\n    )\n  }\n\n  const remove = (id: string) => {\n    setRows((prev) => prev.filter((row) => row.id !== id))\n  }\n\n  return (\n    <section\n      className={cn(\n        \"w-full min-w-0 bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-14\",\n        className\n      )}\n      aria-labelledby=\"integrations-03-heading\"\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-3xl overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\">\n        <header className=\"flex flex-col gap-4 border-b border-border/70 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6\">\n          <div className=\"text-start\">\n            <h1\n              id=\"integrations-03-heading\"\n              className=\"text-lg font-semibold tracking-tight\"\n            >\n              Connected apps\n            </h1>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Enable, configure, or remove apps linked to this workspace.\n            </p>\n          </div>\n          <Button type=\"button\" size=\"sm\" className=\"cursor-pointer gap-1.5\">\n            <PlusIcon className=\"size-4\" aria-hidden />\n            Add integration\n          </Button>\n        </header>\n\n        <ul className=\"divide-y divide-border/70\">\n          {rows.map((row) => {\n            const Icon = row.logo\n            return (\n              <li\n                key={row.id}\n                className=\"flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:gap-4 sm:px-6\"\n              >\n                <div className=\"flex min-w-0 flex-1 items-center gap-3 text-start\">\n                  <span className=\"flex size-10 shrink-0 items-center justify-center rounded-md bg-muted text-muted-foreground\">\n                    <Icon className=\"size-5\" aria-hidden />\n                  </span>\n                  <div className=\"min-w-0\">\n                    <div className=\"flex flex-wrap items-center gap-2\">\n                      <p className=\"truncate text-sm font-medium\">{row.name}</p>\n                      {statusBadge(row.status)}\n                    </div>\n                    <p className=\"mt-0.5 text-xs text-muted-foreground\">\n                      {row.category}\n                      <span className=\"mx-1.5 text-border\" aria-hidden>\n                        ·\n                      </span>\n                      Last sync {row.lastSync}\n                    </p>\n                  </div>\n                </div>\n\n                <div className=\"flex shrink-0 items-center justify-between gap-3 sm:justify-end\">\n                  <label className=\"flex cursor-pointer items-center gap-2 text-sm text-muted-foreground\">\n                    <Switch\n                      checked={row.enabled}\n                      onCheckedChange={(v) => toggle(row.id, v)}\n                      className=\"cursor-pointer\"\n                      aria-label={`Enable ${row.name}`}\n                    />\n                    <span className=\"sm:sr-only\">Enabled</span>\n                  </label>\n\n                  <Button\n                    type=\"button\"\n                    variant=\"outline\"\n                    size=\"sm\"\n                    className=\"cursor-pointer gap-1.5\"\n                  >\n                    <Settings2Icon className=\"size-3.5\" aria-hidden />\n                    Configure\n                  </Button>\n\n                  <DropdownMenu>\n                    <DropdownMenuTrigger asChild>\n                      <Button\n                        type=\"button\"\n                        variant=\"ghost\"\n                        size=\"icon\"\n                        className=\"size-9 cursor-pointer\"\n                        aria-label={`${row.name} actions`}\n                      >\n                        <EllipsisVerticalIcon className=\"size-4\" aria-hidden />\n                      </Button>\n                    </DropdownMenuTrigger>\n                    <DropdownMenuContent align=\"end\" className=\"w-44\">\n                      <DropdownMenuItem className=\"cursor-pointer gap-2\">\n                        <ExternalLinkIcon className=\"size-4\" aria-hidden />\n                        Open docs\n                      </DropdownMenuItem>\n                      <DropdownMenuSeparator />\n                      <DropdownMenuItem\n                        variant=\"destructive\"\n                        className=\"cursor-pointer gap-2\"\n                        onClick={() => remove(row.id)}\n                      >\n                        <UnplugIcon className=\"size-4\" aria-hidden />\n                        Disconnect\n                      </DropdownMenuItem>\n                    </DropdownMenuContent>\n                  </DropdownMenu>\n                </div>\n              </li>\n            )\n          })}\n        </ul>\n\n        {rows.length === 0 ? (\n          <div className=\"px-5 py-12 text-center sm:px-6\">\n            <p className=\"text-sm font-medium\">No connected apps</p>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Add an integration to start syncing data.\n            </p>\n          </div>\n        ) : null}\n      </div>\n    </section>\n  )\n}\n",
      "target": "components/blocks/developer-tools/integrations-03/integrations.tsx"
    }
  ],
