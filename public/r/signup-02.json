      "content": "\"use client\"\n\nimport { GithubIcon } from \"@/components/blocks/authentication/signup-02/icons/github\"\nimport { GoogleIcon } from \"@/components/blocks/authentication/signup-02/icons/google\"\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"@/components/ui/button\"\nimport { Input } from \"@/components/ui/input\"\nimport { Label } from \"@/components/ui/label\"\nimport { Separator } from \"@/components/ui/separator\"\n\nconst controlClass = \"shadow-none\"\n\nexport default function SignupForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  return (\n    <div\n      className={cn(\n        \"flex w-full items-center justify-center bg-canvas px-6 py-10\",\n        className\n      )}\n      {...props}\n    >\n      <div\n        className={cn(\n          \"[--login-card-padding:1.5rem] sm:[--login-card-padding:2rem]\",\n          \"flex w-full max-w-md flex-col gap-8 rounded-[12px] border border-border/70 bg-card p-(--login-card-padding)\",\n          \"shadow-soft\",\n          \"\"\n        )}\n\n              style={{\n                backgroundColor: \"var(--card, #ffffff)\",\n                boxShadow:\n                  \"var(--shadow-soft, 0 2px 4px -1px rgba(10, 10, 12, 0.04), 0 28px 56px -28px rgba(10, 10, 12, 0.18))\",\n              }}\n            >\n        <header className=\"flex flex-col items-start gap-3\">\n          <span className=\"h-0.5 w-8 rounded-full bg-primary\" aria-hidden />\n          <div className=\"space-y-1.5\">\n            <h1 className=\"text-h3 text-foreground\">Create an account</h1>\n            <p className=\"text-sm text-muted-foreground\">\n              Continue with Google or GitHub, or use email.\n            </p>\n          </div>\n        </header>\n\n        <div className=\"grid gap-2\">\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            className=\"h-[46px] w-full rounded-[12px] border-border/70 bg-card shadow-none hover:bg-muted\">\n            <GoogleIcon />\n            Continue with Google\n          </Button>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            className=\"h-[46px] w-full rounded-[12px] border-border/70 bg-card shadow-none hover:bg-muted\">\n            <GithubIcon />\n            Continue with GitHub\n          </Button>\n        </div>\n\n        <div className=\"flex items-center gap-3\">\n          <Separator className=\"flex-1\" />\n          <span className=\"text-xs text-muted-foreground\">or</span>\n          <Separator className=\"flex-1\" />\n        </div>\n\n        <form\n          className=\"flex flex-col gap-4\"\n          onSubmit={(event) => event.preventDefault()}\n        >\n          <div className=\"grid gap-2\">\n            <Label htmlFor=\"signup-02-email\">Email</Label>\n            <Input\n              id=\"signup-02-email\"\n              type=\"email\"\n              dir=\"ltr\"\n              autoComplete=\"email\"\n              placeholder=\"name@example.com\"\n              required\n              className={controlClass}\n            />\n          </div>\n          <div className=\"grid gap-2\">\n            <Label htmlFor=\"signup-02-password\">Password</Label>\n            <Input\n              id=\"signup-02-password\"\n              type=\"password\"\n              autoComplete=\"new-password\"\n              placeholder=\"••••••••\"\n              required\n              className={controlClass}\n            />\n          </div>\n          <Button\n            type=\"submit\"\n            className=\"mt-1 w-full shadow-none\"\n          >\n            Create account\n          </Button>\n        </form>\n\n        <p className=\"text-center text-sm text-muted-foreground\">\n          Already have an account?{\" \"}\n          <a\n            href=\"#\"\n            className=\"cursor-pointer font-medium text-foreground underline-offset-4 hover:underline\"\n          >\n            Sign in\n          </a>\n        </p>\n      </div>\n    </div>\n  )\n}\n",
