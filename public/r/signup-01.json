      required\n                className={controlClass}\n              />\n            </div>\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"signup-01-last\">Last name</Label>\n              <Input\n                id=\"signup-01-last\"\n                autoComplete=\"family-name\"\n                placeholder=\"Williamson\"\n                required\n                className={controlClass}\n              />\n            </div>\n          </div>\n          <div className=\"grid gap-2\">\n            <Label htmlFor=\"signup-01-email\">Email</Label>\n            <Input\n              id=\"signup-01-email\"\n              type=\"email\"\n              dir=\"ltr\"\n              autoComplete=\"email\"\n              placeholder=\"name@example.com\"\n              required\n              className={controlClass}\n            />\n          </div>\n          <div className=\"grid gap-2\">\n            <Label htmlFor=\"signup-01-password\">Password</Label>\n            <Input\n              id=\"signup-01-password\"\n              type=\"password\"\n              autoComplete=\"new-password\"\n              placeholder=\"••••••••\"\n              required\n              className={controlClass}\n            />\n          </div>\n          <Button\n            type=\"submit\"\n            className=\"mt-1 w-full shadow-none\"\n          >\n            Create account\n          </Button>\n        </form>\n\n        <p className=\"text-center text-sm text-muted-foreground\">\n          Already have an account?{\" \"}\n          <a\n            href=\"#\"\n            className=\"cursor-pointer font-medium text-foreground underline-offset-4 hover:underline\"\n          >\n            Sign in\n          </a>\n        </p>\n      </div>\n    </div>\n  )\n}\n",
