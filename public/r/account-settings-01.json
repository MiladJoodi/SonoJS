      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { BellIcon, KeyIcon, ShieldIcon, UserIcon } from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport { Switch } from \"@/components/ui/switch\"\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from \"@/components/ui/tabs\"\nimport { Textarea } from \"@/components/ui/textarea\"\nimport { cn } from \"@/lib/utils\"\n\nimport avatarImg from \"./images/avatar.webp\"\n\nfunction assetSrc(asset: string | { src: string }) {\n  return typeof asset === \"string\" ? asset : asset.src\n}\n\nconst NAV = [\n  { value: \"profile\", label: \"Profile\", icon: UserIcon },\n  { value: \"security\", label: \"Security\", icon: ShieldIcon },\n  { value: \"notifications\", label: \"Notifications\", icon: BellIcon },\n  { value: \"api\", label: \"API Keys\", icon: KeyIcon },\n] as const\n\nexport default function AccountSettings({\n  className,\n  ...props\n}: React.ComponentProps<\"main\">) {\n  return (\n    <main\n      className={cn(\n        \"w-full min-w-0 bg-canvas py-8 text-foreground sm:py-10\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8\">\n        <div className=\"mb-8 space-y-1.5 text-start\">\n          <h1 className=\"text-h3 font-semibold tracking-tight text-foreground\">\n            Account settings\n          </h1>\n          <p className=\"text-sm text-muted-foreground sm:text-base\">\n            Manage your profile, security, and workspace preferences.\n          </p>\n        </div>\n\n        <Tabs\n          defaultValue=\"profile\"\n          orientation=\"vertical\"\n          className=\"flex flex-col gap-6 md:flex-row md:items-start md:gap-8\"\n        >\n          <div className=\"w-full shrink-0 md:w-56\">\n            <TabsList\n              aria-label=\"Account settings sections\"\n              className=\"h-auto w-full flex-row justify-start gap-1 overflow-x-auto rounded-[12px] border border-border/70 bg-card p-1.5 shadow-soft md:flex-col md:overflow-visible\"\n            >\n              {NAV.map((item) => (\n                <TabsTrigger\n                  key={item.value}\n                  value={item.value}\n                  className=\"h-10 cursor-pointer justify-start gap-2 rounded-md px-3 data-[state=active]:bg-primary/10 data-[state=active]:text-primary\"\n                >\n                  <item.icon className=\"size-4\" aria-hidden />\n                  {item.label}\n                </TabsTrigger>\n              ))}\n            </TabsList>\n          </div>\n\n          <div className=\"min-w-0 flex-1\">\n            <TabsContent value=\"profile\" className=\"mt-0\">\n              <Card className=\"gap-0 border-border/70 py-0 shadow-soft\">\n                <CardHeader className=\"border-b border-border/70 py-6\">\n                  <CardTitle>Public Profile</CardTitle>\n                  <CardDescription>\n                    This information will be displayed publicly.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"py-6\">\n                  <FieldGroup className=\"gap-6\">\n                    <div className=\"flex flex-col items-start gap-6 sm:flex-row sm:items-center\">\n                      <Avatar className=\"size-20 overflow-hidden\" size=\"lg\">\n                        <AvatarImage\n                          src={assetSrc(avatarImg)}\n                          alt=\"Alex Rivera\"\n                        />\n                        <AvatarFallback>AR</AvatarFallback>\n                      </Avatar>\n                      <div className=\"flex flex-col items-start gap-2\">\n                        <div className=\"flex flex-wrap gap-2\">\n                          <Button type=\"button\" size=\"sm\" className=\"cursor-pointer\">\n                            Change avatar\n                          </Button>\n                          <Button\n                            type=\"button\"\n                            size=\"sm\"\n                            variant=\"ghost\"\n                            className=\"cursor-pointer text-destructive hover:bg-destructive/10 hover:text-destructive\"\n                          >\n                            Remove\n                          </Button>\n                        </div>\n                        <p className=\"text-sm text-muted-foreground\">\n                          JPG, GIF or PNG. 1MB max.\n                        </p>\n                      </div>\n                    </div>\n\n                    <div className=\"grid gap-6 md:grid-cols-2\">\n                      <Field>\n                        <FieldLabel htmlFor=\"account-settings-01-fname\">\n                          First Name\n                        </FieldLabel>\n                        <Input\n                          id=\"account-settings-01-fname\"\n                          name=\"firstName\"\n                          defaultValue=\"Alex\"\n                          autoComplete=\"given-name\"\n                        />\n                      </Field>\n                      <Field>\n                        <FieldLabel htmlFor=\"account-settings-01-lname\">\n                          Last Name\n                        </FieldLabel>\n                        <Input\n                          id=\"account-settings-01-lname\"\n                          name=\"lastName\"\n                          defaultValue=\"Rivera\"\n                          autoComplete=\"family-name\"\n                        />\n                      </Field>\n                    </div>\n\n                    <Field>\n                      <FieldLabel htmlFor=\"account-settings-01-email\">\n                        Email Address\n                      </FieldLabel>\n                      <Input\n                        id=\"account-settings-01-email\"\n                        name=\"email\"\n                        type=\"email\"\n                        defaultValue=\"alex.rivera@example.com\"\n                        autoComplete=\"email\"\n                        dir=\"ltr\"\n                      />\n                    </Field>\n\n                    <Field>\n                      <FieldLabel htmlFor=\"account-settings-01-bio\">\n                        Bio\n                      </FieldLabel>\n                      <Textarea\n                        id=\"account-settings-01-bio\"\n                        name=\"bio\"\n                        rows={4}\n                        defaultValue=\"Frontend engineer and UI designer.\"\n                      />\n                      <FieldDescription>\n                        Brief description for your profile. URLs are\n                        hyperlinked.\n                      </FieldDescription>\n                    </Field>\n                  </FieldGroup>\n                </CardContent>\n                <CardFooter className=\"justify-end border-t border-border/70 bg-muted/40 py-4\">\n                  <Button type=\"button\" className=\"cursor-pointer\">\n                    Save changes\n                  </Button>\n                </CardFooter>\n              </Card>\n            </TabsContent>\n\n            <TabsContent value=\"security\" className=\"mt-0 space-y-6\">\n              <Card className=\"gap-0 border-border/70 py-0 shadow-soft\">\n                <CardHeader className=\"border-b border-border/70 py-6\">\n                  <CardTitle>Password</CardTitle>\n                  <CardDescription>\n                    Please enter your current password to change your password.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"py-6\">\n                  <FieldGroup className=\"gap-4\">\n                    <Field>\n                      <FieldLabel htmlFor=\"account-settings-01-current\">\n                        Current Password\n                      </FieldLabel>\n                      <Input\n                        id=\"account-settings-01-current\"\n                        name=\"currentPassword\"\n                        type=\"password\"\n                        autoComplete=\"current-password\"\n                      />\n                    </Field>\n                    <Field>\n                      <FieldLabel htmlFor=\"account-settings-01-new\">\n                        New Password\n                      </FieldLabel>\n                      <Input\n                        id=\"account-settings-01-new\"\n                        name=\"newPassword\"\n                        type=\"password\"\n                        autoComplete=\"new-password\"\n                      />\n                    </Field>\n                    <Field>\n                      <FieldLabel htmlFor=\"account-settings-01-confirm\">\n                        Confirm New Password\n                      </FieldLabel>\n                      <Input\n                        id=\"account-settings-01-confirm\"\n                        name=\"confirmPassword\"\n                        type=\"password\"\n                        autoComplete=\"new-password\"\n                      />\n                    </Field>\n                  </FieldGroup>\n                </CardContent>\n                <CardFooter className=\"justify-end border-t border-border/70 bg-muted/40 py-4\">\n                  <Button type=\"button\" className=\"cursor-pointer\">\n                    Update password\n                  </Button>\n                </CardFooter>\n              </Card>\n\n              <Card className=\"gap-0 border-destructive/20 py-0 shadow-soft\">\n                <CardHeader className=\"border-b border-border/70 py-6\">\n                  <CardTitle className=\"text-destructive\">Danger Zone</CardTitle>\n                  <CardDescription>\n                    Irreversible and destructive actions.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"py-6\">\n                  <div className=\"flex w-full flex-col items-start justify-between gap-4 sm:flex-row sm:items-center\">\n                    <div className=\"min-w-0 text-start\">\n                      <h4 className=\"mb-1 text-sm font-semibold text-foreground\">\n                        Delete Account\n                      </h4>\n                      <p className=\"text-sm text-muted-foreground\">\n                        Permanently delete your account and all associated data.\n                      </p>\n                    </div>\n                    <Button\n                      type=\"button\"\n                      variant=\"outline\"\n                      className=\"shrink-0 cursor-pointer border-destructive/40 text-destructive hover:bg-destructive/10 hover:text-destructive\"\n                    >\n                      Delete account\n                    </Button>\n                  </div>\n                </CardContent>\n              </Card>\n            </TabsContent>\n\n            <TabsContent value=\"notifications\" className=\"mt-0\">\n              <Card className=\"gap-0 border-border/70 py-0 shadow-soft\">\n                <CardHeader className=\"border-b border-border/70 py-6\">\n                  <CardTitle>Email Notifications</CardTitle>\n                  <CardDescription>\n                    Choose what we&apos;re allowed to send you.\n                  </CardDescription>\n                </CardHeader>\n                <CardContent className=\"p-0\">\n                  <ul className=\"divide-y divide-border/70\" role=\"list\">\n                    <li className=\"flex items-center justify-between gap-4 p-6\">\n                      <div className=\"min-w-0 pe-4 text-start\">\n                        <h4 className=\"mb-1 text-sm font-semibold text-foreground\">\n                          Marketing Emails\n                        </h4>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Receive emails about new products, features, and more.\n                        </p>\n                      </div>\n                      <Switch\n                        defaultChecked\n                        className=\"cursor-pointer\"\n                        aria-label=\"Marketing emails\"\n                      />\n                    </li>\n                    <li className=\"flex items-center justify-between gap-4 p-6\">\n                      <div className=\"min-w-0 pe-4 text-start\">\n                        <h4 className=\"mb-1 text-sm font-semibold text-foreground\">\n                          Security emails\n                        </h4>\n                        <p className=\"text-sm text-muted-foreground\">\n                          Receive emails about your account security.\n                        </p>\n                      </div>\n                      <Switch\n                        defaultChecked\n                        disabled\n                        aria-label=\"Security emails\"\n                      />\n                    </li>\n                    <li className=\"flex items-center justify-between gap-4 p-6\">\n                      <div className=\"min-w-0 pe-4 text-start\">\n                        <h4 className=\"mb-1 text-sm font-semibold text-foreground\">\n                          Activity digest\n                        </h4>\n                        <p className=\"text-sm text-muted-foreground\">\n                          A weekly summary of activity on your workspaces.\n                        </p>\n                      </div>\n                      <Switch\n                        className=\"cursor-pointer\"\n                        aria-label=\"Activity digest\"\n                      />\n                    </li>\n                  </ul>\n                </CardContent>\n              </Card>\n            </TabsContent>\n\n            <TabsContent value=\"api\" className=\"mt-0\">\n              <Card className=\"gap-0 border-border/70 py-0 shadow-soft\">\n                <CardHeader className=\"border-b border-border/70 py-6\">\n                  <div className=\"flex w-full flex-col items-start justify-between gap-4 sm:flex-row sm:items-start\">\n                    <div className=\"min-w-0 space-y-1.5 text-start\">\n                      <CardTitle>API Keys</CardTitle>\n                      <CardDescription>\n                        Manage API keys to access our APIs.\n                      </CardDescription>\n                    </div>\n                    <Button\n                      type=\"button\"\n                      size=\"sm\"\n                      className=\"shrink-0 cursor-pointer\"\n                    >\n                      Create key\n                    </Button>\n                  </div>\n                </CardHeader>\n                <CardContent className=\"p-0\">\n                  <ul className=\"divide-y divide-border/70\" role=\"list\">\n                    <li className=\"flex w-full flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center\">\n                      <div className=\"min-w-0 space-y-1 text-start\">\n                        <div className=\"flex flex-wrap items-center gap-2\">\n                          <h4 className=\"text-sm font-semibold text-foreground\">\n                            Production Key\n                          </h4>\n                          <Badge\n                            variant=\"secondary\"\n                            className=\"border-transparent bg-emerald-500/15 text-emerald-700 dark:text-emerald-400\"\n                          >\n                            Active\n                          </Badge>\n                        </div>\n                        <p\n                          dir=\"ltr\"\n                          className=\"break-all font-mono text-sm text-muted-foreground\"\n                        >\n                          pk_live_*************************\n                        </p>\n                        <p className=\"text-xs text-muted-foreground\">\n                          Created Oct 24, 2024\n                        </p>\n                      </div>\n                      <Button\n                        type=\"button\"\n                        variant=\"outline\"\n                        size=\"sm\"\n                        className=\"shrink-0 cursor-pointer\"\n                      >\n                        Revoke\n                      </Button>\n                    </li>\n                    <li className=\"flex w-full flex-col items-start justify-between gap-4 p-6 sm:flex-row sm:items-center\">\n                      <div className=\"min-w-0 space-y-1 text-start\">\n                        <div className=\"flex flex-wrap items-center gap-2\">\n                          <h4 className=\"text-sm font-semibold text-foreground\">\n                            Test key\n                          </h4>\n                          <Badge variant=\"secondary\">Active</Badge>\n                        </div>\n                        <p\n                          dir=\"ltr\"\n                          className=\"break-all font-mono text-sm text-muted-foreground\"\n                        >\n                          pk_test_*************************\n                        </p>\n                        <p className=\"text-xs text-muted-foreground\">\n                          Created Jan 12, 2025\n                        </p>\n                      </div>\n                      <Button\n                        type=\"button\"\n                        variant=\"outline\"\n                        size=\"sm\"\n                        className=\"shrink-0 cursor-pointer\"\n                      >\n                        Revoke\n                      </Button>\n                    </li>\n                  </ul>\n                </CardContent>\n              </Card>\n            </TabsContent>\n          </div>\n        </Tabs>\n      </div>\n    </main>\n  )\n}\n",
      "target": "components/blocks/user-account/account-settings-01/account-settings.tsx"
