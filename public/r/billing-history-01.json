      "type": "registry:component",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowDownToLineIcon,\n  ArrowUpFromLineIcon,\n  ChevronLeftIcon,\n  ChevronRightIcon,\n  CreditCardIcon,\n  DownloadIcon,\n  EyeIcon,\n  FilterIcon,\n  MoreHorizontalIcon,\n  RefreshCcwIcon,\n  SearchIcon,\n  XIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Card, CardContent } from \"@/components/ui/card\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport {\n  Empty,\n  EmptyContent,\n  EmptyDescription,\n  EmptyHeader,\n  EmptyMedia,\n  EmptyTitle,\n} from \"@/components/ui/empty\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupButton,\n  InputGroupInput,\n} from \"@/components/ui/input-group\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\ntype TxStatus = \"completed\" | \"pending\" | \"failed\"\ntype TxType = \"deposit\" | \"withdrawal\" | \"transfer\" | \"payment\"\n\ntype Transaction = {\n  id: string\n  counterparty: string\n  initials: string\n  category: string\n  type: TxType\n  amount: number\n  currency: string\n  status: TxStatus\n  date: string\n}\n\nconst TRANSACTIONS: Transaction[] = [\n  {\n    id: \"tx_091\",\n    counterparty: \"Acme Payout\",\n    initials: \"AP\",\n    category: \"Revenue\",\n    type: \"deposit\",\n    amount: 4250.0,\n    currency: \"USD\",\n    status: \"completed\",\n    date: \"2026-06-25T14:30:00Z\",\n  },\n  {\n    id: \"tx_092\",\n    counterparty: \"Cloud Hosting\",\n    initials: \"CH\",\n    category: \"Infrastructure\",\n    type: \"payment\",\n    amount: -342.15,\n    currency: \"USD\",\n    status: \"completed\",\n    date: \"2026-06-24T09:12:00Z\",\n  },\n  {\n    id: \"tx_093\",\n    counterparty: \"Edge Deploy\",\n    initials: \"ED\",\n    category: \"Software\",\n    type: \"payment\",\n    amount: -40.0,\n    currency: \"USD\",\n    status: \"pending\",\n    date: \"2026-06-23T11:05:00Z\",\n  },\n  {\n    id: \"tx_094\",\n    counterparty: \"Alice Smith\",\n    initials: \"AS\",\n    category: \"Transfer\",\n    type: \"transfer\",\n    amount: 150.0,\n    currency: \"USD\",\n    status: \"completed\",\n    date: \"2026-06-22T16:45:00Z\",\n  },\n  {\n    id: \"tx_095\",\n    counterparty: \"Code Hosting\",\n    initials: \"GH\",\n    category: \"Software\",\n    type: \"payment\",\n    amount: -48.0,\n    currency: \"USD\",\n    status: \"completed\",\n    date: \"2026-06-21T08:00:00Z\",\n  },\n  {\n    id: \"tx_096\",\n    counterparty: \"Bank Withdrawal\",\n    initials: \"BW\",\n    category: \"Banking\",\n    type: \"withdrawal\",\n    amount: -1000.0,\n    currency: \"USD\",\n    status: \"completed\",\n    date: \"2026-06-20T10:30:00Z\",\n  },\n  {\n    id: \"tx_097\",\n    counterparty: \"Storefront\",\n    initials: \"SF\",\n    category: \"Revenue\",\n    type: \"deposit\",\n    amount: 1205.5,\n    currency: \"USD\",\n    status: \"failed\",\n    date: \"2026-06-19T13:20:00Z\",\n  },\n  {\n    id: \"tx_098\",\n    counterparty: \"Workspace Suite\",\n    initials: \"WS\",\n    category: \"Software\",\n    type: \"payment\",\n    amount: -72.0,\n    currency: \"USD\",\n    status: \"completed\",\n    date: \"2026-06-18T09:15:00Z\",\n  },\n]\n\nconst STATUS_META: Record<\n  TxStatus,\n  { label: string; dot: string; text: string }\n> = {\n  completed: {\n    label: \"Completed\",\n    dot: \"bg-emerald-500\",\n    text: \"text-foreground\",\n  },\n  pending: {\n    label: \"Pending\",\n    dot: \"bg-amber-500\",\n    text: \"text-foreground\",\n  },\n  failed: {\n    label: \"Failed\",\n    dot: \"bg-rose-500\",\n    text: \"text-muted-foreground\",\n  },\n}\n\nfunction formatCurrency(amount: number, currency: string) {\n  return new Intl.NumberFormat(\"en-US\", {\n    style: \"currency\",\n    currency,\n    signDisplay: \"always\",\n  }).format(amount)\n}\n\nfunction formatDate(iso: string) {\n  return new Intl.DateTimeFormat(\"en-US\", {\n    month: \"short\",\n    day: \"numeric\",\n    year: \"numeric\",\n    hour: \"numeric\",\n    minute: \"2-digit\",\n    timeZone: \"UTC\",\n  }).format(new Date(iso))\n}\n\nfunction TypeIcon({ type }: { type: TxType }) {\n  const className = \"size-4 text-muted-foreground\"\n  switch (type) {\n    case \"deposit\":\n      return <ArrowDownToLineIcon className={className} aria-hidden />\n    case \"withdrawal\":\n      return <ArrowUpFromLineIcon className={className} aria-hidden />\n    case \"transfer\":\n      return <RefreshCcwIcon className={className} aria-hidden />\n    case \"payment\":\n      return <CreditCardIcon className={className} aria-hidden />\n  }\n}\n\nexport default function BillingHistory({\n  className,\n  ...props\n}: React.ComponentProps<\"section\">) {\n  const [query, setQuery] = React.useState(\"\")\n  const [statusFilter, setStatusFilter] = React.useState(\"all\")\n  const [typeFilter, setTypeFilter] = React.useState(\"all\")\n  const [page, setPage] = React.useState(1)\n  const perPage = 6\n\n  const filtered = React.useMemo(() => {\n    let result = TRANSACTIONS\n    const q = query.trim().toLowerCase()\n    if (q) {\n      result = result.filter(\n        (tx) =>\n          tx.counterparty.toLowerCase().includes(q) ||\n          tx.id.toLowerCase().includes(q) ||\n          tx.category.toLowerCase().includes(q)\n      )\n    }\n    if (statusFilter !== \"all\") {\n      result = result.filter((tx) => tx.status === statusFilter)\n    }\n    if (typeFilter !== \"all\") {\n      result = result.filter((tx) => tx.type === typeFilter)\n    }\n    return result\n  }, [query, statusFilter, typeFilter])\n\n  const totals = React.useMemo(() => {\n    const inflow = TRANSACTIONS.filter(\n      (t) => t.amount > 0 && t.status === \"completed\"\n    ).reduce((s, t) => s + t.amount, 0)\n    const outflow = TRANSACTIONS.filter(\n      (t) => t.amount < 0 && t.status === \"completed\"\n    ).reduce((s, t) => s + Math.abs(t.amount), 0)\n    const pending = TRANSACTIONS.filter((t) => t.status === \"pending\").length\n    return { inflow, outflow, pending }\n  }, [])\n\n  const totalPages = Math.max(1, Math.ceil(filtered.length / perPage))\n  const safePage = Math.min(page, totalPages)\n  const paged = filtered.slice((safePage - 1) * perPage, safePage * perPage)\n\n  const clearFilters = () => {\n    setQuery(\"\")\n    setStatusFilter(\"all\")\n    setTypeFilter(\"all\")\n    setPage(1)\n  }\n\n  const hasFilters =\n    !!query.trim() || statusFilter !== \"all\" || typeFilter !== \"all\"\n\n  return (\n    <section\n      className={cn(\n        \"relative isolate w-full min-w-0 overflow-hidden bg-white py-10 text-foreground dark:bg-background\",\n        className\n      )}\n      aria-labelledby=\"billing-history-01-heading\"\n      {...props}\n    >\n      <div aria-hidden className=\"pointer-events-none absolute inset-0 -z-10\">\n        <div className=\"absolute start-1/2 top-[-18%] size-[26rem] -translate-x-1/2 rounded-full bg-primary/10 blur-3xl\" />\n      </div>\n\n      <div className=\"mx-auto max-w-6xl space-y-8 px-4 sm:px-6 lg:px-8\">\n        <header className=\"flex flex-col items-stretch justify-between gap-4 sm:flex-row sm:items-end\">\n          <div className=\"min-w-0 text-start\">\n            <p className=\"text-xs font-semibold tracking-[0.18em] text-muted-foreground uppercase\">\n              Ledger\n            </p>\n            <h1\n              id=\"billing-history-01-heading\"\n              className=\"mt-1 text-3xl font-semibold tracking-tight text-foreground sm:text-4xl\"\n            >\n              Transaction history\n            </h1>\n            <p className=\"mt-2 max-w-xl text-sm text-muted-foreground\">\n              Every deposit, payment, and transfer — searchable, filterable, and\n              export-ready.\n            </p>\n          </div>\n          <Button\n            type=\"button\"\n            variant=\"outline\"\n            className=\"w-full shrink-0 cursor-pointer rounded-full sm:w-auto\"\n          >\n            <ArrowDownToLineIcon className=\"size-4\" aria-hidden />\n            Export CSV\n          </Button>\n        </header>\n\n        <div className=\"grid gap-3 sm:grid-cols-3\">\n          {[\n            {\n              label: \"Inflow (30d)\",\n              value: formatCurrency(totals.inflow, \"USD\"),\n              tone: \"text-emerald-700 dark:text-emerald-400\",\n            },\n            {\n              label: \"Outflow (30d)\",\n              value: formatCurrency(-totals.outflow, \"USD\"),\n              tone: \"text-foreground\",\n            },\n            {\n              label: \"Pending\",\n              value: String(totals.pending),\n              tone: \"text-amber-700 dark:text-amber-400\",\n            },\n          ].map((stat) => (\n            <div\n              key={stat.label}\n              className=\"rounded-[12px] border border-border/70 bg-card px-5 py-4 shadow-soft\"\n            >\n              <p className=\"text-xs font-medium tracking-wide text-muted-foreground uppercase\">\n                {stat.label}\n              </p>\n              <p\n                dir=\"ltr\"\n                className={cn(\n                  \"mt-1 text-2xl font-semibold tracking-tight tabular-nums\",\n                  stat.tone\n                )}\n              >\n                {stat.value}\n              </p>\n            </div>\n          ))}\n        </div>\n\n        <Card className=\"border-border/70 shadow-soft\">\n          <CardContent className=\"space-y-4 p-5 sm:p-6\">\n            <div className=\"flex flex-col gap-4 sm:flex-row\">\n              <InputGroup className=\"flex-1\">\n                <InputGroupAddon align=\"inline-start\">\n                  <SearchIcon aria-hidden />\n                </InputGroupAddon>\n                <InputGroupInput\n                  placeholder=\"Search counterparty, ID or category…\"\n                  value={query}\n                  onChange={(e) => {\n                    setQuery(e.target.value)\n                    setPage(1)\n                  }}\n                  aria-label=\"Search transactions\"\n                />\n                {query ? (\n                  <InputGroupAddon align=\"inline-end\">\n                    <InputGroupButton\n                      type=\"button\"\n                      size=\"icon-xs\"\n                      className=\"cursor-pointer\"\n                      aria-label=\"Clear search\"\n                      onClick={() => {\n                        setQuery(\"\")\n                        setPage(1)\n                      }}\n                    >\n                      <XIcon aria-hidden />\n                    </InputGroupButton>\n                  </InputGroupAddon>\n                ) : null}\n              </InputGroup>\n\n              <div className=\"flex flex-col gap-3 sm:flex-row\">\n                <Select\n                  value={statusFilter}\n                  onValueChange={(v) => {\n                    setStatusFilter(v)\n                    setPage(1)\n                  }}\n                >\n                  <SelectTrigger className=\"w-full cursor-pointer sm:w-[160px]\">\n                    <SelectValue placeholder=\"All Status\" />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"all\">All Status</SelectItem>\n                    <SelectItem value=\"completed\">Completed</SelectItem>\n                    <SelectItem value=\"pending\">Pending</SelectItem>\n                    <SelectItem value=\"failed\">Failed</SelectItem>\n                  </SelectContent>\n                </Select>\n\n                <Select\n                  value={typeFilter}\n                  onValueChange={(v) => {\n                    setTypeFilter(v)\n                    setPage(1)\n                  }}\n                >\n                  <SelectTrigger className=\"w-full cursor-pointer sm:w-[160px]\">\n                    <SelectValue placeholder=\"All Types\" />\n                  </SelectTrigger>\n                  <SelectContent>\n                    <SelectItem value=\"all\">All Types</SelectItem>\n                    <SelectItem value=\"deposit\">Deposit</SelectItem>\n                    <SelectItem value=\"withdrawal\">Withdrawal</SelectItem>\n                    <SelectItem value=\"transfer\">Transfer</SelectItem>\n                    <SelectItem value=\"payment\">Payment</SelectItem>\n                  </SelectContent>\n                </Select>\n              </div>\n            </div>\n\n            {hasFilters ? (\n              <div className=\"flex flex-wrap items-center gap-2 border-t border-border/70 pt-4\">\n                <FilterIcon\n                  className=\"size-4 text-muted-foreground\"\n                  aria-hidden\n                />\n                <span className=\"text-sm font-medium text-muted-foreground\">\n                  Active filters:\n                </span>\n                {query.trim() ? (\n                  <Badge\n                    variant=\"outline\"\n                    className=\"h-8 gap-1.5 rounded-full border-border/70 bg-muted/40 px-3 font-medium\"\n                  >\n                    “{query.trim()}”\n                    <button\n                      type=\"button\"\n                      className=\"ms-0.5 inline-flex size-5 cursor-pointer items-center justify-center rounded-full hover:bg-muted\"\n                      aria-label=\"Remove search filter\"\n                      onClick={() => {\n                        setQuery(\"\")\n                        setPage(1)\n                      }}\n                    >\n                      <XIcon className=\"size-3\" aria-hidden />\n                    </button>\n                  </Badge>\n                ) : null}\n                {statusFilter !== \"all\" ? (\n                  <Badge\n                    variant=\"outline\"\n                    className=\"h-8 gap-1.5 rounded-full border-border/70 bg-muted/40 px-3 font-medium capitalize\"\n                  >\n                    Status: {statusFilter}\n                    <button\n                      type=\"button\"\n                      className=\"ms-0.5 inline-flex size-5 cursor-pointer items-center justify-center rounded-full hover:bg-muted\"\n                      aria-label=\"Remove status filter\"\n                      onClick={() => {\n                        setStatusFilter(\"all\")\n                        setPage(1)\n                      }}\n                    >\n                      <XIcon className=\"size-3\" aria-hidden />\n                    </button>\n                  </Badge>\n                ) : null}\n                {typeFilter !== \"all\" ? (\n                  <Badge\n                    variant=\"outline\"\n                    className=\"h-8 gap-1.5 rounded-full border-border/70 bg-muted/40 px-3 font-medium capitalize\"\n                  >\n                    Type: {typeFilter}\n                    <button\n                      type=\"button\"\n                      className=\"ms-0.5 inline-flex size-5 cursor-pointer items-center justify-center rounded-full hover:bg-muted\"\n                      aria-label=\"Remove type filter\"\n                      onClick={() => {\n                        setTypeFilter(\"all\")\n                        setPage(1)\n                      }}\n                    >\n                      <XIcon className=\"size-3\" aria-hidden />\n                    </button>\n                  </Badge>\n                ) : null}\n                <Button\n                  type=\"button\"\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  className=\"ms-auto h-8 cursor-pointer rounded-full\"\n                  onClick={clearFilters}\n                >\n                  Clear all\n                </Button>\n              </div>\n            ) : null}\n          </CardContent>\n        </Card>\n\n        <Card className=\"overflow-hidden border-border/70 shadow-soft\">\n          <div className=\"overflow-x-auto\">\n            <Table>\n              <TableHeader>\n                <TableRow className=\"hover:bg-transparent\">\n                  <TableHead className=\"h-12 ps-6 text-xs tracking-wider uppercase\">\n                    Transaction\n                  </TableHead>\n                  <TableHead className=\"h-12 text-xs tracking-wider uppercase\">\n                    Date\n                  </TableHead>\n                  <TableHead className=\"h-12 text-xs tracking-wider uppercase\">\n                    Type\n                  </TableHead>\n                  <TableHead className=\"h-12 text-xs tracking-wider uppercase\">\n                    Status\n                  </TableHead>\n                  <TableHead className=\"h-12 text-end text-xs tracking-wider uppercase\">\n                    Amount\n                  </TableHead>\n                  <TableHead className=\"h-12 w-14 pe-6\" />\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {paged.length === 0 ? (\n                  <TableRow className=\"hover:bg-transparent\">\n                    <TableCell colSpan={6} className=\"py-16\">\n                      <Empty className=\"border-0\">\n                        <EmptyHeader>\n                          <EmptyMedia variant=\"icon\">\n                            <SearchIcon aria-hidden />\n                          </EmptyMedia>\n                          <EmptyTitle>No transactions found</EmptyTitle>\n                          <EmptyDescription>\n                            Try adjusting your filters or search query.\n                          </EmptyDescription>\n                        </EmptyHeader>\n                        <EmptyContent>\n                          <Button\n                            type=\"button\"\n                            variant=\"outline\"\n                            className=\"cursor-pointer rounded-full\"\n                            onClick={clearFilters}\n                          >\n                            Clear Filters\n                          </Button>\n                        </EmptyContent>\n                      </Empty>\n                    </TableCell>\n                  </TableRow>\n                ) : (\n                  paged.map((tx) => {\n                    const status = STATUS_META[tx.status]\n                    const isPositive = tx.amount > 0\n                    const isFailed = tx.status === \"failed\"\n                    return (\n                      <TableRow key={tx.id} className=\"group\">\n                        <TableCell className=\"py-5 ps-6\">\n                          <div className=\"flex items-center gap-3\">\n                            <Avatar className=\"size-10 border border-border/70\">\n                              <AvatarFallback className=\"bg-muted text-xs font-semibold\">\n                                {tx.initials}\n                              </AvatarFallback>\n                            </Avatar>\n                            <div className=\"min-w-0 text-start\">\n                              <p\n                                className={cn(\n                                  \"truncate font-semibold\",\n                                  isFailed\n                                    ? \"text-muted-foreground line-through\"\n                                    : \"text-foreground\"\n                                )}\n                              >\n                                {tx.counterparty}\n                              </p>\n                              <div className=\"mt-0.5 flex flex-wrap items-center gap-2 text-sm text-muted-foreground\">\n                                <span\n                                  dir=\"ltr\"\n                                  className=\"font-mono tracking-wide\"\n                                >\n                                  {tx.id}\n                                </span>\n                                <span\n                                  className=\"size-1 rounded-full bg-border\"\n                                  aria-hidden\n                                />\n                                <span>{tx.category}</span>\n                              </div>\n                            </div>\n                          </div>\n                        </TableCell>\n                        <TableCell className=\"py-5 whitespace-nowrap\">\n                          <span\n                            dir=\"ltr\"\n                            className=\"font-medium text-muted-foreground\"\n                          >\n                            {formatDate(tx.date)}\n                          </span>\n                        </TableCell>\n                        <TableCell className=\"py-5\">\n                          <span className=\"inline-flex items-center gap-2 capitalize text-muted-foreground\">\n                            <TypeIcon type={tx.type} />\n                            {tx.type}\n                          </span>\n                        </TableCell>\n                        <TableCell className=\"py-5\">\n                          <span\n                            className={cn(\n                              \"inline-flex items-center gap-2 text-sm font-medium\",\n                              status.text\n                            )}\n                          >\n                            <span\n                              className={cn(\"size-2 rounded-full\", status.dot)}\n                            />\n                            {status.label}\n                          </span>\n                        </TableCell>\n                        <TableCell className=\"py-5 text-end\">\n                          <span\n                            dir=\"ltr\"\n                            className={cn(\n                              \"text-lg font-semibold tracking-tight tabular-nums\",\n                              isFailed\n                                ? \"text-muted-foreground/40 line-through\"\n                                : isPositive\n                                  ? \"text-emerald-700 dark:text-emerald-400\"\n                                  : \"text-foreground\"\n                            )}\n                          >\n                            {formatCurrency(tx.amount, tx.currency)}\n                          </span>\n                        </TableCell>\n                        <TableCell className=\"py-5 pe-6 text-end\">\n                          <DropdownMenu>\n                            <DropdownMenuTrigger asChild>\n                              <Button\n                                type=\"button\"\n                                size=\"icon-xs\"\n                                variant=\"ghost\"\n                                aria-label=\"Transaction actions\"\n                                className=\"cursor-pointer rounded-full text-muted-foreground\"\n                              >\n                                <MoreHorizontalIcon\n                                  className=\"size-5\"\n                                  aria-hidden\n                                />\n                              </Button>\n                            </DropdownMenuTrigger>\n                            <DropdownMenuContent align=\"end\" className=\"w-44\">\n                              <DropdownMenuItem className=\"cursor-pointer gap-2\">\n                                <EyeIcon className=\"size-4\" aria-hidden />\n                                View details\n                              </DropdownMenuItem>\n                              <DropdownMenuItem className=\"cursor-pointer gap-2\">\n                                <DownloadIcon className=\"size-4\" aria-hidden />\n                                Download receipt\n                              </DropdownMenuItem>\n                              <DropdownMenuSeparator />\n                              <DropdownMenuItem className=\"cursor-pointer gap-2\">\n                                Copy ID\n                              </DropdownMenuItem>\n                            </DropdownMenuContent>\n                          </DropdownMenu>\n                        </TableCell>\n                      </TableRow>\n                    )\n                  })\n                )}\n              </TableBody>\n            </Table>\n          </div>\n\n          {filtered.length > 0 ? (\n            <div className=\"flex flex-col gap-4 border-t border-border/70 bg-muted/20 px-6 py-4 sm:flex-row sm:items-center sm:justify-between\">\n              <p className=\"text-sm font-medium text-muted-foreground\">\n                Showing{\" \"}\n                <span dir=\"ltr\" className=\"font-semibold text-foreground\">\n                  {Math.min((safePage - 1) * perPage + 1, filtered.length)}\n                </span>{\" \"}\n                to{\" \"}\n                <span dir=\"ltr\" className=\"font-semibold text-foreground\">\n                  {Math.min(safePage * perPage, filtered.length)}\n                </span>{\" \"}\n                of{\" \"}\n                <span dir=\"ltr\" className=\"font-semibold text-foreground\">\n                  {filtered.length}\n                </span>{\" \"}\n                results\n              </p>\n              <div className=\"flex gap-2\">\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  size=\"sm\"\n                  className=\"cursor-pointer rounded-full disabled:cursor-not-allowed\"\n                  disabled={safePage <= 1}\n                  onClick={() => setPage((p) => Math.max(1, p - 1))}\n                >\n                  <ChevronLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                  Previous\n                </Button>\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  size=\"sm\"\n                  className=\"cursor-pointer rounded-full disabled:cursor-not-allowed\"\n                  disabled={safePage >= totalPages}\n                  onClick={() => setPage((p) => Math.min(totalPages, p + 1))}\n                >\n                  Next\n                  <ChevronRightIcon className=\"icon-dir size-4\" aria-hidden />\n                </Button>\n              </div>\n            </div>\n          ) : null}\n        </Card>\n      </div>\n    </section>\n  )\n}\n",
      "target": "components/blocks/payments-billing/billing-history-01/billing-history.tsx"
    }
