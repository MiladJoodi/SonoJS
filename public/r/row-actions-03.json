      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArchiveIcon,\n  EllipsisIcon,\n  PencilIcon,\n  StarIcon,\n  Trash2Icon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\ntype PostStatus = \"published\" | \"draft\" | \"scheduled\"\n\ntype Post = {\n  id: string\n  title: string\n  author: string\n  initials: string\n  status: PostStatus\n  updated: string\n  starred: boolean\n}\n\nconst POSTS: Post[] = [\n  {\n    id: \"1\",\n    title: \"Shipping the new billing ledger\",\n    author: \"Alex Rivera\",\n    initials: \"AR\",\n    status: \"published\",\n    updated: \"2h ago\",\n    starred: true,\n  },\n  {\n    id: \"2\",\n    title: \"Draft: Registry CLI walkthrough\",\n    author: \"Sam Chen\",\n    initials: \"SC\",\n    status: \"draft\",\n    updated: \"Yesterday\",\n    starred: false,\n  },\n  {\n    id: \"3\",\n    title: \"RTL checklist for data tables\",\n    author: \"Jordan Lee\",\n    initials: \"JL\",\n    status: \"scheduled\",\n    updated: \"Mar 18\",\n    starred: false,\n  },\n  {\n    id: \"4\",\n    title: \"Design tokens for dense grids\",\n    author: \"Morgan Blake\",\n    initials: \"MB\",\n    status: \"published\",\n    updated: \"Mar 12\",\n    starred: true,\n  },\n  {\n    id: \"5\",\n    title: \"Notes from the a11y review\",\n    author: \"Casey Ng\",\n    initials: \"CN\",\n    status: \"draft\",\n    updated: \"Mar 8\",\n    starred: false,\n  },\n]\n\nconst statusStyles: Record<PostStatus, string> = {\n  published:\n    \"border-transparent bg-emerald-500/10 text-emerald-700 dark:text-emerald-400\",\n  draft: \"border-transparent bg-muted text-muted-foreground\",\n  scheduled:\n    \"border-transparent bg-sky-500/10 text-sky-700 dark:text-sky-300\",\n}\n\nconst statusLabel: Record<PostStatus, string> = {\n  published: \"Published\",\n  draft: \"Draft\",\n  scheduled: \"Scheduled\",\n}\n\nconst iconBtn =\n  \"size-8 cursor-pointer rounded-lg text-muted-foreground hover:bg-muted hover:text-foreground\"\n\nfunction MoreMenu({ title }: { title: string }) {\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger asChild>\n        <Button\n          type=\"button\"\n          size=\"icon-sm\"\n          variant=\"ghost\"\n          aria-label={`More actions for ${title}`}\n          className={iconBtn}\n        >\n          <EllipsisIcon className=\"size-4\" aria-hidden />\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\" className=\"w-44\">\n        <DropdownMenuItem className=\"cursor-pointer gap-2\">\n          <PencilIcon className=\"size-4 text-muted-foreground\" aria-hidden />\n          Edit\n        </DropdownMenuItem>\n        <DropdownMenuItem className=\"cursor-pointer gap-2\">\n          <ArchiveIcon className=\"size-4 text-muted-foreground\" aria-hidden />\n          Archive\n        </DropdownMenuItem>\n        <DropdownMenuSeparator />\n        <DropdownMenuItem className=\"cursor-pointer gap-2 text-destructive focus:text-destructive\">\n          <Trash2Icon className=\"size-4\" aria-hidden />\n          Delete\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n\nexport default function RowActions03({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [posts, setPosts] = React.useState(POSTS)\n\n  const toggleStar = (id: string) => {\n    setPosts((prev) =>\n      prev.map((p) => (p.id === id ? { ...p, starred: !p.starred } : p))\n    )\n  }\n\n  return (\n    <div className={cn(\"w-full min-w-0\", className)} {...props}>\n      <div className=\"mb-4 text-start\">\n        <h3 className=\"text-lg font-semibold tracking-tight text-foreground\">\n          Content\n        </h3>\n        <p className=\"mt-0.5 text-sm text-muted-foreground\">\n          Primary edit + star, with a muted overflow menu for the rest.\n        </p>\n      </div>\n\n      <ul className=\"flex flex-col gap-3 md:hidden\">\n        {posts.map((post) => (\n          <li\n            key={post.id}\n            className=\"rounded-[12px] border border-border/70 bg-white p-4 shadow-soft dark:bg-card\"\n          >\n            <div className=\"flex items-start gap-3\">\n              <Avatar className=\"size-9\">\n                <AvatarFallback className=\"bg-muted text-xs font-medium text-muted-foreground\">\n                  {post.initials}\n                </AvatarFallback>\n              </Avatar>\n              <div className=\"min-w-0 flex-1\">\n                <div className=\"flex flex-wrap items-start justify-between gap-2\">\n                  <p className=\"text-sm font-medium text-foreground\">\n                    {post.title}\n                  </p>\n                  <Badge\n                    variant=\"outline\"\n                    className={cn(\n                      \"h-6 rounded-full px-2.5 font-medium\",\n                      statusStyles[post.status]\n                    )}\n                  >\n                    {statusLabel[post.status]}\n                  </Badge>\n                </div>\n                <p className=\"mt-1 text-xs text-muted-foreground\">\n                  {post.author} · {post.updated}\n                </p>\n                <div className=\"mt-3 flex items-center justify-end gap-0.5 border-t border-border/70 pt-3\">\n                  <Button\n                    type=\"button\"\n                    size=\"icon-sm\"\n                    variant=\"ghost\"\n                    aria-label={post.starred ? \"Unstar\" : \"Star\"}\n                    onClick={() => toggleStar(post.id)}\n                    className={cn(\n                      iconBtn,\n                      post.starred && \"text-amber-600 hover:text-amber-700\"\n                    )}\n                  >\n                    <StarIcon\n                      className={cn(\"size-4\", post.starred && \"fill-current\")}\n                      aria-hidden\n                    />\n                  </Button>\n                  <Button\n                    type=\"button\"\n                    size=\"icon-sm\"\n                    variant=\"ghost\"\n                    aria-label={`Edit ${post.title}`}\n                    className={iconBtn}\n                  >\n                    <PencilIcon className=\"size-4\" aria-hidden />\n                  </Button>\n                  <MoreMenu title={post.title} />\n                </div>\n              </div>\n            </div>\n          </li>\n        ))}\n      </ul>\n\n      <div className=\"hidden rounded-[12px] border border-border/70 bg-white shadow-soft md:block dark:bg-card\">\n        <Table className=\"min-w-180\">\n          <TableHeader>\n            <TableRow className=\"hover:bg-transparent\">\n              <TableHead className=\"w-10 font-medium\" />\n              <TableHead className=\"font-medium\">Title</TableHead>\n              <TableHead className=\"font-medium\">Author</TableHead>\n              <TableHead className=\"font-medium\">Status</TableHead>\n              <TableHead className=\"font-medium\">Updated</TableHead>\n              <TableHead className=\"w-28 font-medium\">\n                <span className=\"sr-only\">Actions</span>\n              </TableHead>\n            </TableRow>\n          </TableHeader>\n          <TableBody>\n            {posts.map((post) => (\n              <TableRow key={post.id} className=\"group hover:bg-muted/40\">\n                <TableCell className=\"pe-0\">\n                  <Button\n                    type=\"button\"\n                    size=\"icon-sm\"\n                    variant=\"ghost\"\n                    aria-label={post.starred ? \"Unstar\" : \"Star\"}\n                    onClick={() => toggleStar(post.id)}\n                    className={cn(\n                      iconBtn,\n                      post.starred\n                        ? \"text-amber-600 hover:text-amber-700\"\n                        : \"opacity-40 group-hover:opacity-100\"\n                    )}\n                  >\n                    <StarIcon\n                      className={cn(\"size-4\", post.starred && \"fill-current\")}\n                      aria-hidden\n                    />\n                  </Button>\n                </TableCell>\n                <TableCell className=\"text-sm font-medium text-foreground\">\n                  {post.title}\n                </TableCell>\n                <TableCell>\n                  <div className=\"flex items-center gap-2.5\">\n                    <Avatar className=\"size-7\">\n                      <AvatarFallback className=\"bg-muted text-[10px] font-medium text-muted-foreground\">\n                        {post.initials}\n                      </AvatarFallback>\n                    </Avatar>\n                    <span className=\"text-sm text-muted-foreground\">\n                      {post.author}\n                    </span>\n                  </div>\n                </TableCell>\n                <TableCell>\n                  <Badge\n                    variant=\"outline\"\n                    className={cn(\n                      \"h-6 rounded-full px-2.5 font-medium\",\n                      statusStyles[post.status]\n                    )}\n                  >\n                    {statusLabel[post.status]}\n                  </Badge>\n                </TableCell>\n                <TableCell className=\"text-sm tabular-nums text-muted-foreground\">\n                  {post.updated}\n                </TableCell>\n                <TableCell className=\"text-end\">\n                  <div className=\"flex items-center justify-end gap-0.5 opacity-100 md:opacity-0 md:group-hover:opacity-100 md:group-focus-within:opacity-100\">\n                    <Button\n                      type=\"button\"\n                      size=\"icon-sm\"\n                      variant=\"ghost\"\n                      aria-label={`Edit ${post.title}`}\n                      className={iconBtn}\n                    >\n                      <PencilIcon className=\"size-4\" aria-hidden />\n                    </Button>\n                    <MoreMenu title={post.title} />\n                  </div>\n                </TableCell>\n              </TableRow>\n            ))}\n          </TableBody>\n        </Table>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/data-tables/row-actions-03/table.tsx"
    }
  ],
