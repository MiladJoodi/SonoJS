      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  CopyIcon,\n  EllipsisVerticalIcon,\n  PencilIcon,\n  PlusIcon,\n  Trash2Icon,\n  ZapIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { Switch } from \"@/components/ui/switch\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\ntype WebhookRow = {\n  id: string\n  url: string\n  enabled: boolean\n  status: \"active\" | \"failing\" | \"paused\"\n  events: number\n  lastFired: string\n}\n\nconst INITIAL: WebhookRow[] = [\n  {\n    id: \"wh_12345\",\n    url: \"https://api.acmecorp.com/webhooks/billing\",\n    enabled: true,\n    status: \"active\",\n    events: 3,\n    lastFired: \"10 mins ago\",\n  },\n  {\n    id: \"wh_67890\",\n    url: \"https://hooks.slack.com/services/T01/B02/xyz\",\n    enabled: true,\n    status: \"active\",\n    events: 2,\n    lastFired: \"2 hours ago\",\n  },\n  {\n    id: \"wh_11223\",\n    url: \"https://zapier.com/hooks/catch/123/abc\",\n    enabled: false,\n    status: \"failing\",\n    events: 1,\n    lastFired: \"1 day ago\",\n  },\n  {\n    id: \"wh_44556\",\n    url: \"https://ops.example.com/hooks/deploy\",\n    enabled: true,\n    status: \"active\",\n    events: 5,\n    lastFired: \"Just now\",\n  },\n]\n\nfunction statusBadge(status: WebhookRow[\"status\"]) {\n  if (status === \"failing\") {\n    return (\n      <Badge variant=\"destructive\" className=\"capitalize\">\n        failing\n      </Badge>\n    )\n  }\n  if (status === \"paused\") {\n    return (\n      <Badge variant=\"secondary\" className=\"capitalize\">\n        paused\n      </Badge>\n    )\n  }\n  return (\n    <Badge\n      variant=\"secondary\"\n      className=\"border-transparent bg-emerald-500/15 capitalize text-emerald-700 dark:text-emerald-400\"\n    >\n      active\n    </Badge>\n  )\n}\n\nexport default function WebhookManagement({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [rows, setRows] = React.useState(INITIAL)\n\n  const toggle = (id: string, enabled: boolean) => {\n    setRows((prev) =>\n      prev.map((row) =>\n        row.id === id\n          ? {\n              ...row,\n              enabled,\n              status: enabled\n                ? row.status === \"failing\"\n                  ? \"failing\"\n                  : \"active\"\n                : \"paused\",\n            }\n          : row\n      )\n    )\n  }\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-16\",\n        className\n      )}\n      {...props}\n    >\n      <Card className=\"mx-auto max-w-4xl overflow-hidden border-border/70 shadow-soft\">\n        <CardHeader className=\"flex flex-col gap-4 border-b border-border/70 sm:flex-row sm:items-center sm:justify-between\">\n          <div className=\"text-start\">\n            <CardTitle>Endpoints</CardTitle>\n            <CardDescription>\n              Compact list — enable, test, or edit each webhook.\n            </CardDescription>\n          </div>\n          <Button type=\"button\" size=\"sm\" className=\"cursor-pointer gap-1.5\">\n            <PlusIcon className=\"size-4\" aria-hidden />\n            Add endpoint\n          </Button>\n        </CardHeader>\n\n        <CardContent className=\"p-0\">\n          <div className=\"overflow-x-auto\">\n            <Table>\n              <TableHeader>\n                <TableRow className=\"hover:bg-transparent\">\n                  <TableHead className=\"w-[4.5rem] ps-5\">On</TableHead>\n                  <TableHead>URL</TableHead>\n                  <TableHead className=\"hidden sm:table-cell\">Status</TableHead>\n                  <TableHead className=\"hidden md:table-cell\">Events</TableHead>\n                  <TableHead className=\"hidden lg:table-cell\">\n                    Last fired\n                  </TableHead>\n                  <TableHead className=\"pe-5 text-end\">Actions</TableHead>\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {rows.map((row) => (\n                  <TableRow key={row.id}>\n                    <TableCell className=\"ps-5\">\n                      <Switch\n                        checked={row.enabled}\n                        onCheckedChange={(checked) =>\n                          toggle(row.id, checked === true)\n                        }\n                        className=\"cursor-pointer\"\n                        aria-label={`Toggle ${row.id}`}\n                      />\n                    </TableCell>\n                    <TableCell className=\"max-w-[14rem] sm:max-w-xs\">\n                      <p\n                        dir=\"ltr\"\n                        className=\"truncate text-sm font-medium text-foreground\"\n                        title={row.url}\n                      >\n                        {row.url}\n                      </p>\n                      <p\n                        dir=\"ltr\"\n                        className=\"mt-0.5 font-mono text-[11px] text-muted-foreground\"\n                      >\n                        {row.id}\n                      </p>\n                      <div className=\"mt-1.5 flex flex-wrap gap-1.5 sm:hidden\">\n                        {statusBadge(row.status)}\n                        <span className=\"text-xs text-muted-foreground\">\n                          {row.events} events\n                        </span>\n                      </div>\n                    </TableCell>\n                    <TableCell className=\"hidden sm:table-cell\">\n                      {statusBadge(row.status)}\n                    </TableCell>\n                    <TableCell className=\"hidden tabular-nums md:table-cell\">\n                      {row.events}\n                    </TableCell>\n                    <TableCell className=\"hidden text-muted-foreground lg:table-cell\">\n                      {row.lastFired}\n                    </TableCell>\n                    <TableCell className=\"pe-5\">\n                      <div className=\"flex items-center justify-end gap-1\">\n                        <Button\n                          type=\"button\"\n                          variant=\"outline\"\n                          size=\"sm\"\n                          className=\"hidden h-8 cursor-pointer gap-1 text-xs sm:inline-flex\"\n                        >\n                          <ZapIcon className=\"size-3.5\" aria-hidden />\n                          Test\n                        </Button>\n                        <DropdownMenu>\n                          <DropdownMenuTrigger asChild>\n                            <Button\n                              type=\"button\"\n                              variant=\"ghost\"\n                              size=\"icon-sm\"\n                              className=\"size-8 cursor-pointer\"\n                              aria-label={`Actions for ${row.id}`}\n                            >\n                              <EllipsisVerticalIcon\n                                className=\"size-4\"\n                                aria-hidden\n                              />\n                            </Button>\n                          </DropdownMenuTrigger>\n                          <DropdownMenuContent align=\"end\" className=\"w-44\">\n                            <DropdownMenuItem className=\"cursor-pointer sm:hidden\">\n                              <ZapIcon className=\"size-4\" aria-hidden />\n                              Test\n                            </DropdownMenuItem>\n                            <DropdownMenuItem className=\"cursor-pointer\">\n                              <PencilIcon className=\"size-4\" aria-hidden />\n                              Edit\n                            </DropdownMenuItem>\n                            <DropdownMenuItem className=\"cursor-pointer\">\n                              <CopyIcon className=\"size-4\" aria-hidden />\n                              Copy secret\n                            </DropdownMenuItem>\n                            <DropdownMenuSeparator />\n                            <DropdownMenuItem\n                              variant=\"destructive\"\n                              className=\"cursor-pointer\"\n                            >\n                              <Trash2Icon className=\"size-4\" aria-hidden />\n                              Delete\n                            </DropdownMenuItem>\n                          </DropdownMenuContent>\n                        </DropdownMenu>\n                      </div>\n                    </TableCell>\n                  </TableRow>\n                ))}\n              </TableBody>\n            </Table>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  )\n}\n",
      "target": "components/blocks/developer-tools/webhook-management-03/webhook-management.tsx"
    }
  ],
