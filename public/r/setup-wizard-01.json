      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowLeftIcon,\n  ArrowRightIcon,\n  CheckCircle2Icon,\n  CheckIcon,\n  LockIcon,\n  MailIcon,\n  RocketIcon,\n  ShieldCheckIcon,\n  SparklesIcon,\n  UserIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n} from \"@/components/ui/input-group\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\nimport { Progress } from \"@/components/ui/progress\"\nimport { cn } from \"@/lib/utils\"\n\nconst STEPS = [\n  { id: \"account\", label: \"Account\", icon: UserIcon },\n  { id: \"verify\", label: \"Verify\", icon: ShieldCheckIcon },\n  { id: \"experience\", label: \"Experience\", icon: SparklesIcon },\n  { id: \"launch\", label: \"Launch\", icon: RocketIcon },\n] as const\n\nconst EXPERIENCE_OPTIONS = [\n  {\n    value: \"beginner\",\n    label: \"Just starting out\",\n    desc: \"Learning React and modern UI\",\n  },\n  {\n    value: \"intermediate\",\n    label: \"Growing team\",\n    desc: \"Building production apps\",\n  },\n  {\n    value: \"expert\",\n    label: \"Senior / architect\",\n    desc: \"Design systems and scale\",\n  },\n] as const\n\nfunction WizardSteps({\n  activeStep,\n}: {\n  activeStep: number\n}) {\n  return (\n    <nav aria-label=\"Onboarding progress\" className=\"mb-8\">\n      <ol className=\"flex items-center gap-1 sm:gap-2\">\n        {STEPS.map((step, index) => {\n          const Icon = step.icon\n          const done = index < activeStep\n          const current = index === activeStep\n          return (\n            <li key={step.id} className=\"flex min-w-0 flex-1 items-center gap-1 sm:gap-2\">\n              <div\n                className={cn(\n                  \"flex size-8 shrink-0 items-center justify-center rounded-full border text-xs font-medium transition-colors sm:size-9\",\n                  done &&\n                    \"border-primary bg-primary text-primary-foreground\",\n                  current &&\n                    !done &&\n                    \"border-primary bg-primary/10 text-primary\",\n                  !done &&\n                    !current &&\n                    \"border-border/70 bg-muted/50 text-muted-foreground\"\n                )}\n                aria-current={current ? \"step\" : undefined}\n              >\n                {done ? (\n                  <CheckIcon className=\"size-3.5\" aria-hidden />\n                ) : (\n                  <Icon className=\"size-3.5\" aria-hidden />\n                )}\n              </div>\n              <span\n                className={cn(\n                  \"hidden truncate text-xs font-medium sm:block\",\n                  current || done ? \"text-foreground\" : \"text-muted-foreground\"\n                )}\n              >\n                {step.label}\n              </span>\n              {index < STEPS.length - 1 ? (\n                <div\n                  className={cn(\n                    \"mx-1 hidden h-px min-w-2 flex-1 sm:block\",\n                    index < activeStep ? \"bg-primary\" : \"bg-border/70\"\n                  )}\n                  aria-hidden\n                />\n              ) : null}\n            </li>\n          )\n        })}\n      </ol>\n      <Progress\n        value={((activeStep + 1) / STEPS.length) * 100}\n        className=\"mt-4 h-1.5 sm:hidden\"\n        aria-label={`Step ${activeStep + 1} of ${STEPS.length}`}\n      />\n      <p className=\"mt-2 text-xs text-muted-foreground sm:hidden\" aria-live=\"polite\">\n        Step {activeStep + 1} of {STEPS.length} · {STEPS[activeStep].label}\n      </p>\n    </nav>\n  )\n}\n\nexport default function SetupWizard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [step, setStep] = React.useState(0)\n  const [email, setEmail] = React.useState(\"\")\n  const [name, setName] = React.useState(\"\")\n  const [otp, setOtp] = React.useState(\"\")\n  const [experience, setExperience] = React.useState(\"\")\n\n  const next = () => setStep((s) => Math.min(s + 1, STEPS.length - 1))\n  const back = () => setStep((s) => Math.max(s - 1, 0))\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-16\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-lg overflow-hidden rounded-[12px] border border-border/70 bg-card p-6 shadow-soft sm:p-8\">\n        <WizardSteps activeStep={step} />\n\n        {step === 0 ? (\n          <FieldGroup className=\"gap-6\">\n            <div className=\"space-y-1 text-start\">\n              <h1 className=\"text-2xl font-semibold tracking-tight\">\n                Create your account\n              </h1>\n              <p className=\"text-sm text-muted-foreground\">\n                Get started with SonoJS in under 2 minutes.\n              </p>\n            </div>\n\n            <Field>\n              <FieldLabel htmlFor=\"setup-wizard-01-name\">\n                Full name\n              </FieldLabel>\n              <InputGroup>\n                <InputGroupAddon align=\"inline-start\">\n                  <UserIcon aria-hidden />\n                </InputGroupAddon>\n                <InputGroupInput\n                  id=\"setup-wizard-01-name\"\n                  placeholder=\"Alex Rivera\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  autoComplete=\"name\"\n                />\n              </InputGroup>\n            </Field>\n\n            <Field>\n              <FieldLabel htmlFor=\"setup-wizard-01-email\">\n                Email address\n              </FieldLabel>\n              <InputGroup>\n                <InputGroupAddon align=\"inline-start\">\n                  <MailIcon aria-hidden />\n                </InputGroupAddon>\n                <InputGroupInput\n                  id=\"setup-wizard-01-email\"\n                  type=\"email\"\n                  placeholder=\"alex@company.com\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  autoComplete=\"email\"\n                />\n              </InputGroup>\n            </Field>\n\n            <Field>\n              <FieldLabel htmlFor=\"setup-wizard-01-password\">\n                Password\n              </FieldLabel>\n              <InputGroup>\n                <InputGroupAddon align=\"inline-start\">\n                  <LockIcon aria-hidden />\n                </InputGroupAddon>\n                <InputGroupInput\n                  id=\"setup-wizard-01-password\"\n                  type=\"password\"\n                  placeholder=\"At least 8 characters\"\n                  autoComplete=\"new-password\"\n                />\n              </InputGroup>\n              <FieldDescription>\n                Use 8+ characters with a mix of letters and numbers.\n              </FieldDescription>\n            </Field>\n\n            <Button\n              type=\"button\"\n              size=\"lg\"\n              className=\"w-full gap-2\"\n              onClick={next}\n            >\n              Continue\n              <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n            </Button>\n          </FieldGroup>\n        ) : null}\n\n        {step === 1 ? (\n          <div className=\"flex flex-col items-center gap-6 text-center\">\n            <div className=\"flex size-14 items-center justify-center rounded-lg bg-emerald-500/10\">\n              <ShieldCheckIcon\n                className=\"size-7 text-emerald-600 dark:text-emerald-400\"\n                aria-hidden\n              />\n            </div>\n            <div className=\"space-y-1.5\">\n              <h1 className=\"text-2xl font-semibold tracking-tight\">\n                Check your email\n              </h1>\n              <p className=\"mx-auto max-w-sm text-sm leading-relaxed text-muted-foreground\">\n                We sent a 6-digit code to{\" \"}\n                <span className=\"font-medium text-foreground\">\n                  {email || \"alex@company.com\"}\n                </span>\n              </p>\n            </div>\n\n            <div className=\"w-full space-y-3\">\n              <label htmlFor=\"setup-wizard-01-otp\" className=\"sr-only\">\n                Verification code\n              </label>\n              <div dir=\"ltr\" className=\"flex w-full justify-center\">\n                <InputOTP\n                  id=\"setup-wizard-01-otp\"\n                  maxLength={6}\n                  value={otp}\n                  onChange={setOtp}\n                  containerClassName=\"justify-center\"\n                >\n                  <InputOTPGroup>\n                    <InputOTPSlot index={0} />\n                    <InputOTPSlot index={1} />\n                    <InputOTPSlot index={2} />\n                  </InputOTPGroup>\n                  <InputOTPSeparator />\n                  <InputOTPGroup>\n                    <InputOTPSlot index={3} />\n                    <InputOTPSlot index={4} />\n                    <InputOTPSlot index={5} />\n                  </InputOTPGroup>\n                </InputOTP>\n              </div>\n              <p className=\"text-sm text-muted-foreground\">\n                Didn&apos;t receive it?{\" \"}\n                <button\n                  type=\"button\"\n                  className=\"cursor-pointer font-medium text-primary hover:underline\"\n                >\n                  Resend code\n                </button>\n              </p>\n            </div>\n\n            <div className=\"flex w-full gap-3\">\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                size=\"lg\"\n                className=\"flex-1 gap-2\"\n                onClick={back}\n              >\n                <ArrowLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                Back\n              </Button>\n              <Button\n                type=\"button\"\n                size=\"lg\"\n                className=\"flex-[1.6] gap-2\"\n                onClick={next}\n              >\n                Verify\n                <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n              </Button>\n            </div>\n          </div>\n        ) : null}\n\n        {step === 2 ? (\n          <div className=\"space-y-6\">\n            <div className=\"space-y-1 text-start\">\n              <h1 className=\"text-2xl font-semibold tracking-tight\">\n                Your experience level\n              </h1>\n              <p className=\"text-sm text-muted-foreground\">\n                We&apos;ll tailor your onboarding based on this.\n              </p>\n            </div>\n\n            <div\n              className=\"flex flex-col gap-3\"\n              role=\"radiogroup\"\n              aria-label=\"Experience level\"\n            >\n              {EXPERIENCE_OPTIONS.map((opt) => {\n                const selected = experience === opt.value\n                return (\n                  <button\n                    key={opt.value}\n                    type=\"button\"\n                    role=\"radio\"\n                    aria-checked={selected}\n                    onClick={() => setExperience(opt.value)}\n                    className={cn(\n                      \"flex w-full cursor-pointer items-center justify-between gap-3 rounded-lg border-2 p-4 text-start transition-colors\",\n                      selected\n                        ? \"border-primary bg-primary/5\"\n                        : \"border-border/70 bg-canvas hover:border-border\"\n                    )}\n                  >\n                    <span className=\"min-w-0\">\n                      <span className=\"block text-sm font-semibold\">\n                        {opt.label}\n                      </span>\n                      <span className=\"mt-0.5 block text-xs text-muted-foreground\">\n                        {opt.desc}\n                      </span>\n                    </span>\n                    {selected ? (\n                      <CheckCircle2Icon\n                        className=\"size-5 shrink-0 text-primary\"\n                        aria-hidden\n                      />\n                    ) : null}\n                  </button>\n                )\n              })}\n            </div>\n\n            <div className=\"flex gap-3\">\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                size=\"lg\"\n                className=\"flex-1 gap-2\"\n                onClick={back}\n              >\n                <ArrowLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                Back\n              </Button>\n              <Button\n                type=\"button\"\n                size=\"lg\"\n                className=\"flex-[1.6] gap-2\"\n                disabled={!experience}\n                onClick={next}\n              >\n                Continue\n                <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n              </Button>\n            </div>\n          </div>\n        ) : null}\n\n        {step === 3 ? (\n          <div className=\"flex flex-col items-center gap-6 py-2 text-center\">\n            <div className=\"flex size-16 items-center justify-center rounded-full bg-primary/10\">\n              <RocketIcon className=\"size-8 text-primary\" aria-hidden />\n            </div>\n            <div className=\"space-y-3\">\n              <Badge\n                variant=\"secondary\"\n                className=\"bg-emerald-500/10 text-emerald-700 dark:text-emerald-300\"\n              >\n                You&apos;re all set\n              </Badge>\n              <h1 className=\"text-2xl font-semibold tracking-tight\">\n                Welcome to SonoJS\n              </h1>\n              <p className=\"mx-auto max-w-sm text-sm leading-relaxed text-muted-foreground\">\n                Your workspace is ready. Start exploring components, blocks, and\n                charts tailored for production apps.\n              </p>\n            </div>\n            <Button type=\"button\" size=\"lg\" className=\"w-full gap-2\">\n              Go to Dashboard\n              <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n            </Button>\n            <button\n              type=\"button\"\n              className=\"cursor-pointer text-sm text-muted-foreground transition-colors hover:text-foreground\"\n              onClick={() => {\n                setStep(0)\n                setOtp(\"\")\n                setExperience(\"\")\n              }}\n            >\n              Start over\n            </button>\n          </div>\n        ) : null}\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/onboarding/setup-wizard-01/setup-wizard.tsx"
    }
  ],
