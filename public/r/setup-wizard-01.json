      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  ArrowLeftIcon,\n  ArrowRightIcon,\n  CheckCircle2Icon,\n  CheckIcon,\n  LockIcon,\n  MailIcon,\n  RocketIcon,\n  ShieldCheckIcon,\n  SparklesIcon,\n  UserIcon,\n} from \"lucide-react\"\n\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Field,\n  FieldDescription,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport {\n  InputGroup,\n  InputGroupAddon,\n  InputGroupInput,\n} from \"@/components/ui/input-group\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\nimport { Progress } from \"@/components/ui/progress\"\nimport { cn } from \"@/lib/utils\"\n\nconst STEPS = [\n  { id: \"account\", label: \"Account\", icon: UserIcon },\n  { id: \"verify\", label: \"Verify\", icon: ShieldCheckIcon },\n  { id: \"experience\", label: \"Experience\", icon: SparklesIcon },\n  { id: \"launch\", label: \"Launch\", icon: RocketIcon },\n] as const\n\nconst EXPERIENCE_OPTIONS = [\n  {\n    value: \"beginner\",\n    label: \"Just starting out\",\n    desc: \"Learning React and modern UI\",\n  },\n  {\n    value: \"intermediate\",\n    label: \"Growing team\",\n    desc: \"Building production apps\",\n  },\n  {\n    value: \"expert\",\n    label: \"Senior / architect\",\n    desc: \"Design systems and scale\",\n  },\n] as const\n\nfunction StepperBand({ activeStep }: { activeStep: number }) {\n  return (\n    <div className=\"border-b border-border/70 bg-muted/40 px-5 py-4 sm:px-8 sm:py-5\">\n      <nav aria-label=\"Onboarding progress\">\n        <ol className=\"flex items-center gap-1 sm:gap-2\">\n          {STEPS.map((step, index) => {\n            const Icon = step.icon\n            const done = index < activeStep\n            const current = index === activeStep\n            return (\n              <li\n                key={step.id}\n                className=\"flex min-w-0 flex-1 items-center gap-1 sm:gap-2\"\n              >\n                <div\n                  className={cn(\n                    \"flex size-8 shrink-0 items-center justify-center rounded-full border text-xs font-medium transition-colors sm:size-9\",\n                    done && \"border-primary bg-primary text-primary-foreground\",\n                    current &&\n                      !done &&\n                      \"border-primary bg-primary/10 text-primary\",\n                    !done &&\n                      !current &&\n                      \"border-border/70 bg-card text-muted-foreground\"\n                  )}\n                  aria-current={current ? \"step\" : undefined}\n                >\n                  {done ? (\n                    <CheckIcon className=\"size-3.5\" aria-hidden />\n                  ) : (\n                    <Icon className=\"size-3.5\" aria-hidden />\n                  )}\n                </div>\n                <span\n                  className={cn(\n                    \"hidden truncate text-xs font-medium sm:block\",\n                    current || done\n                      ? \"text-foreground\"\n                      : \"text-muted-foreground\"\n                  )}\n                >\n                  {step.label}\n                </span>\n                {index < STEPS.length - 1 ? (\n                  <div\n                    className={cn(\n                      \"mx-1 hidden h-px min-w-2 flex-1 sm:block\",\n                      index < activeStep ? \"bg-primary\" : \"bg-border/70\"\n                    )}\n                    aria-hidden\n                  />\n                ) : null}\n              </li>\n            )\n          })}\n        </ol>\n        <Progress\n          value={((activeStep + 1) / STEPS.length) * 100}\n          className=\"mt-3 h-1.5 sm:hidden\"\n          aria-label={`Step ${activeStep + 1} of ${STEPS.length}`}\n        />\n        <p\n          className=\"mt-2 text-xs text-muted-foreground sm:hidden\"\n          aria-live=\"polite\"\n        >\n          Step {activeStep + 1} of {STEPS.length} · {STEPS[activeStep].label}\n        </p>\n      </nav>\n    </div>\n  )\n}\n\nexport default function SetupWizard({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [step, setStep] = React.useState(0)\n  const [email, setEmail] = React.useState(\"\")\n  const [name, setName] = React.useState(\"\")\n  const [otp, setOtp] = React.useState(\"\")\n  const [experience, setExperience] = React.useState(\"\")\n\n  const next = () => setStep((s) => Math.min(s + 1, STEPS.length - 1))\n  const back = () => setStep((s) => Math.max(s - 1, 0))\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-16\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-lg overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\">\n        <StepperBand activeStep={step} />\n\n        <div className=\"p-6 sm:p-8\">\n          {step === 0 ? (\n            <FieldGroup className=\"gap-6\">\n              <div className=\"space-y-1.5 text-start\">\n                <h1 className=\"text-h3 font-semibold tracking-tight\">\n                  Create your account\n                </h1>\n                <p className=\"text-sm text-muted-foreground\">\n                  Get started in under two minutes.\n                </p>\n              </div>\n\n              <Field>\n                <FieldLabel htmlFor=\"setup-wizard-01-name\">Full name</FieldLabel>\n                <InputGroup>\n                  <InputGroupAddon align=\"inline-start\">\n                    <UserIcon aria-hidden />\n                  </InputGroupAddon>\n                  <InputGroupInput\n                    id=\"setup-wizard-01-name\"\n                    placeholder=\"Alex Rivera\"\n                    value={name}\n                    onChange={(e) => setName(e.target.value)}\n                    autoComplete=\"name\"\n                  />\n                </InputGroup>\n              </Field>\n\n              <Field>\n                <FieldLabel htmlFor=\"setup-wizard-01-email\">\n                  Email address\n                </FieldLabel>\n                <InputGroup>\n                  <InputGroupAddon align=\"inline-start\">\n                    <MailIcon aria-hidden />\n                  </InputGroupAddon>\n                  <InputGroupInput\n                    id=\"setup-wizard-01-email\"\n                    type=\"email\"\n                    dir=\"ltr\"\n                    placeholder=\"alex@company.com\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    autoComplete=\"email\"\n                  />\n                </InputGroup>\n              </Field>\n\n              <Field>\n                <FieldLabel htmlFor=\"setup-wizard-01-password\">\n                  Password\n                </FieldLabel>\n                <InputGroup>\n                  <InputGroupAddon align=\"inline-start\">\n                    <LockIcon aria-hidden />\n                  </InputGroupAddon>\n                  <InputGroupInput\n                    id=\"setup-wizard-01-password\"\n                    type=\"password\"\n                    placeholder=\"At least 8 characters\"\n                    autoComplete=\"new-password\"\n                  />\n                </InputGroup>\n                <FieldDescription>\n                  Use 8+ characters with a mix of letters and numbers.\n                </FieldDescription>\n              </Field>\n\n              <Button\n                type=\"button\"\n                size=\"lg\"\n                className=\"w-full cursor-pointer gap-2\"\n                onClick={next}\n              >\n                Continue\n                <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n              </Button>\n            </FieldGroup>\n          ) : null}\n\n          {step === 1 ? (\n            <div className=\"flex flex-col items-center gap-6 text-center\">\n              <span className=\"flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary\">\n                <ShieldCheckIcon className=\"size-6\" aria-hidden />\n              </span>\n              <div className=\"space-y-1.5\">\n                <h1 className=\"text-h3 font-semibold tracking-tight\">\n                  Check your email\n                </h1>\n                <p className=\"mx-auto max-w-sm text-sm text-muted-foreground\">\n                  We sent a 6-digit code to{\" \"}\n                  <span dir=\"ltr\" className=\"font-medium text-foreground\">\n                    {email || \"alex@company.com\"}\n                  </span>\n                </p>\n              </div>\n\n              <div className=\"w-full space-y-3\">\n                <label htmlFor=\"setup-wizard-01-otp\" className=\"sr-only\">\n                  Verification code\n                </label>\n                <div dir=\"ltr\" className=\"flex w-full justify-center\">\n                  <InputOTP\n                    id=\"setup-wizard-01-otp\"\n                    maxLength={6}\n                    value={otp}\n                    onChange={setOtp}\n                    containerClassName=\"justify-center\"\n                  >\n                    <InputOTPGroup>\n                      <InputOTPSlot index={0} />\n                      <InputOTPSlot index={1} />\n                      <InputOTPSlot index={2} />\n                    </InputOTPGroup>\n                    <InputOTPSeparator />\n                    <InputOTPGroup>\n                      <InputOTPSlot index={3} />\n                      <InputOTPSlot index={4} />\n                      <InputOTPSlot index={5} />\n                    </InputOTPGroup>\n                  </InputOTP>\n                </div>\n                <p className=\"text-sm text-muted-foreground\">\n                  Didn&apos;t receive it?{\" \"}\n                  <button\n                    type=\"button\"\n                    className=\"cursor-pointer font-medium text-primary hover:underline\"\n                  >\n                    Resend code\n                  </button>\n                </p>\n              </div>\n\n              <div className=\"flex w-full gap-3\">\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  size=\"lg\"\n                  className=\"flex-1 cursor-pointer gap-2\"\n                  onClick={back}\n                >\n                  <ArrowLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                  Back\n                </Button>\n                <Button\n                  type=\"button\"\n                  size=\"lg\"\n                  className=\"flex-[1.6] cursor-pointer gap-2\"\n                  onClick={next}\n                >\n                  Verify\n                  <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n                </Button>\n              </div>\n            </div>\n          ) : null}\n\n          {step === 2 ? (\n            <div className=\"space-y-6\">\n              <div className=\"space-y-1.5 text-start\">\n                <h1 className=\"text-h3 font-semibold tracking-tight\">\n                  Your experience level\n                </h1>\n                <p className=\"text-sm text-muted-foreground\">\n                  We&apos;ll tailor onboarding based on this.\n                </p>\n              </div>\n\n              <div\n                className=\"flex flex-col gap-2.5\"\n                role=\"radiogroup\"\n                aria-label=\"Experience level\"\n              >\n                {EXPERIENCE_OPTIONS.map((opt) => {\n                  const selected = experience === opt.value\n                  return (\n                    <button\n                      key={opt.value}\n                      type=\"button\"\n                      role=\"radio\"\n                      aria-checked={selected}\n                      onClick={() => setExperience(opt.value)}\n                      className={cn(\n                        \"flex w-full cursor-pointer items-center justify-between gap-3 rounded-[12px] border px-4 py-3.5 text-start transition-colors\",\n                        selected\n                          ? \"border-primary/40 bg-primary/5 ring-1 ring-primary/30\"\n                          : \"border-border/70 hover:bg-muted/40\"\n                      )}\n                    >\n                      <span className=\"min-w-0\">\n                        <span className=\"block text-sm font-semibold\">\n                          {opt.label}\n                        </span>\n                        <span className=\"mt-0.5 block text-xs text-muted-foreground\">\n                          {opt.desc}\n                        </span>\n                      </span>\n                      {selected ? (\n                        <CheckCircle2Icon\n                          className=\"size-5 shrink-0 text-primary\"\n                          aria-hidden\n                        />\n                      ) : null}\n                    </button>\n                  )\n                })}\n              </div>\n\n              <div className=\"flex gap-3\">\n                <Button\n                  type=\"button\"\n                  variant=\"outline\"\n                  size=\"lg\"\n                  className=\"flex-1 cursor-pointer gap-2\"\n                  onClick={back}\n                >\n                  <ArrowLeftIcon className=\"icon-dir size-4\" aria-hidden />\n                  Back\n                </Button>\n                <Button\n                  type=\"button\"\n                  size=\"lg\"\n                  className=\"flex-[1.6] cursor-pointer gap-2\"\n                  disabled={!experience}\n                  onClick={next}\n                >\n                  Continue\n                  <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n                </Button>\n              </div>\n            </div>\n          ) : null}\n\n          {step === 3 ? (\n            <div className=\"flex flex-col items-center gap-6 py-2 text-center\">\n              <span className=\"flex size-14 items-center justify-center rounded-full bg-primary/10 text-primary\">\n                <RocketIcon className=\"size-7\" aria-hidden />\n              </span>\n              <div className=\"space-y-3\">\n                <Badge className=\"border-0 bg-emerald-500/10 text-emerald-700 dark:text-emerald-300\">\n                  You&apos;re all set\n                </Badge>\n                <h1 className=\"text-h3 font-semibold tracking-tight\">\n                  Welcome aboard\n                </h1>\n                <p className=\"mx-auto max-w-sm text-sm text-muted-foreground\">\n                  Your workspace is ready. Start exploring components, blocks,\n                  and charts.\n                </p>\n              </div>\n              <Button\n                type=\"button\"\n                size=\"lg\"\n                className=\"w-full cursor-pointer gap-2\"\n              >\n                Go to dashboard\n                <ArrowRightIcon className=\"icon-dir size-4\" aria-hidden />\n              </Button>\n              <button\n                type=\"button\"\n                className=\"cursor-pointer text-sm text-muted-foreground underline-offset-4 hover:text-foreground hover:underline\"\n                onClick={() => {\n                  setStep(0)\n                  setOtp(\"\")\n                  setExperience(\"\")\n                }}\n              >\n                Start over\n              </button>\n            </div>\n          ) : null}\n        </div>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/onboarding/setup-wizard-01/setup-wizard.tsx"
    }
