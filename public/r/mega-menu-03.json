      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { ChevronDownIcon, MenuIcon, XIcon } from \"lucide-react\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Collapsible,\n  CollapsibleContent,\n  CollapsibleTrigger,\n} from \"@/components/ui/collapsible\"\nimport {\n  Sheet,\n  SheetClose,\n  SheetContent,\n  SheetHeader,\n  SheetTitle,\n  SheetTrigger,\n} from \"@/components/ui/sheet\"\n\nconst links = [\n  { label: \"Solutions\", href: \"#\" },\n  { label: \"Resources\", href: \"#\" },\n  { label: \"Contact\", href: \"#\" },\n  { label: \"About Us\", href: \"#\" },\n]\n\nconst megaColumns = [\n  {\n    heading: \"Indian & Fusion Wear\",\n    muted: false,\n    items: [\n      \"Kurtas & Suits\",\n      \"Kurtis, Tunics & Tops\",\n      \"Sarees\",\n      \"Ethnic Wear\",\n      \"Dress Materials\",\n      \"Lehenga Cholis\",\n    ],\n  },\n  {\n    heading: \"Western Wear\",\n    muted: true,\n    items: [\n      \"Dresses\",\n      \"Tops\",\n      \"Tshirts\",\n      \"Jeans\",\n      \"Trousers & Capris\",\n      \"Shorts & Skirts\",\n      \"Co-ords\",\n      \"Playsuits\",\n    ],\n  },\n  {\n    heading: \"Maternity\",\n    muted: false,\n    items: [\n      \"Flats\",\n      \"Casual Shoes\",\n      \"Heels\",\n      \"Boots\",\n      \"Sports Shoes & Floaters\",\n    ],\n  },\n  {\n    heading: \"Gadgets\",\n    muted: true,\n    items: [\n      \"Smart Wearables\",\n      \"Fitness Gadgets\",\n      \"Headphones\",\n      \"Speakers\",\n      \"Smart Phone\",\n      \"Watch\",\n    ],\n  },\n  {\n    heading: \"Accessories\",\n    muted: false,\n    items: [\n      \"Bags & Backpacks\",\n      \"Wallets\",\n      \"Belts\",\n      \"Sunglasses\",\n      \"Watches\",\n      \"Jewelry\",\n    ],\n  },\n]\n\nconst ctaClass =\n  \"!h-[46px] h-[46px] min-h-[46px] max-h-[46px] rounded-[12px] shadow-none\"\n\nconst iconBtn =\n  \"size-[46px] min-h-[46px] max-h-[46px] min-w-[46px] max-w-[46px] rounded-[12px] border-border/70 shadow-none\"\n\nfunction Brand() {\n  return (\n    <a\n      href=\"#\"\n      className=\"flex shrink-0 cursor-pointer items-center gap-2 outline-none focus-visible:rounded-md focus-visible:ring-2 focus-visible:ring-ring\"\n      aria-label=\"Sono\"\n    >\n      <img\n        src=\"/images/logos/logo.svg\"\n        alt=\"\"\n        width={28}\n        height={32}\n        className=\"h-8 w-auto shrink-0\"\n      />\n      <span className=\"text-sm font-semibold tracking-tight text-foreground\">\n        Sono\n      </span>\n    </a>\n  )\n}\n\nfunction MegaPanel() {\n  return (\n    <div className=\"grid w-full grid-cols-2 gap-0 sm:grid-cols-3 lg:grid-cols-5\">\n      {megaColumns.map((col) => (\n        <div\n          key={col.heading}\n          className={cn(\n            \"min-w-0 px-4 py-6\",\n            col.muted && \"bg-muted\"\n          )}\n        >\n          <p className=\"mb-6 text-sm font-semibold text-foreground\">\n            {col.heading}\n          </p>\n          <ul className=\"space-y-3 text-sm font-medium text-muted-foreground\">\n            {col.items.map((item) => (\n              <li key={item}>\n                <a\n                  href=\"#\"\n                  className=\"cursor-pointer rounded-md outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring\"\n                >\n                  {item}\n                </a>\n              </li>\n            ))}\n          </ul>\n        </div>\n      ))}\n    </div>\n  )\n}\n\nexport default function MegaMenu({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [megaOpen, setMegaOpen] = React.useState(false)\n  const triggerRef = React.useRef<HTMLButtonElement>(null)\n  const panelRef = React.useRef<HTMLDivElement>(null)\n\n  React.useEffect(() => {\n    if (!megaOpen) return\n    function onPointerDown(event: PointerEvent) {\n      const target = event.target as Node\n      if (\n        triggerRef.current?.contains(target) ||\n        panelRef.current?.contains(target)\n      ) {\n        return\n      }\n      setMegaOpen(false)\n    }\n    function onKeyDown(event: KeyboardEvent) {\n      if (event.key === \"Escape\") setMegaOpen(false)\n    }\n    document.addEventListener(\"pointerdown\", onPointerDown)\n    document.addEventListener(\"keydown\", onKeyDown)\n    return () => {\n      document.removeEventListener(\"pointerdown\", onPointerDown)\n      document.removeEventListener(\"keydown\", onKeyDown)\n    }\n  }, [megaOpen])\n\n  return (\n    <div\n      className={cn(\n        \"flex min-h-[28rem] w-full flex-1 flex-col bg-card\",\n        className\n      )}\n      {...props}>\n      <header className=\"sticky top-0 z-20 w-full border-b border-border/70 bg-card\">\n        <nav\n          className=\"mx-auto flex min-h-16 w-full max-w-7xl flex-nowrap items-center gap-4 px-4 py-2 sm:px-6 lg:px-8\"\n          aria-label=\"Main\"\n        >\n          <Brand />\n\n          <ul className=\"ms-0 hidden min-w-0 items-center gap-6 text-sm font-semibold text-foreground lg:ms-8 lg:flex\">\n            <li>\n              <button\n                type=\"button\"\n                aria-haspopup=\"true\"\n                ref={triggerRef}\n                aria-expanded={megaOpen}\n                aria-controls=\"mega-menu-panel\"\n                onClick={() => setMegaOpen((o) => !o)}\n                className=\"inline-flex cursor-pointer items-center gap-1.5 rounded-md outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring\"\n              >\n                Products\n                <ChevronDownIcon\n                  className={cn(\n                    \"size-3.5 transition-transform\",\n                    megaOpen && \"rotate-180\"\n                  )}\n                  aria-hidden\n                />\n              </button>\n            </li>\n\n            {links.map((link) => (\n              <li key={link.label}>\n                <a\n                  href={link.href}\n                  className=\"cursor-pointer rounded-md outline-none transition-colors hover:text-primary focus-visible:ring-2 focus-visible:ring-ring\"\n                >\n                  {link.label}\n                </a>\n              </li>\n            ))}\n          </ul>\n\n          <div className=\"ms-auto flex shrink-0 items-center gap-2\">\n            <Button className={cn(\"hidden lg:flex\", ctaClass)}>Sign up</Button>\n\n            <Sheet>\n              <SheetTrigger asChild>\n                <Button\n                  variant=\"outline\"\n                  className={cn(iconBtn, \"lg:hidden\")}\n                  aria-label=\"Open menu\"\n                >\n                  <MenuIcon className=\"size-4\" />\n                </Button>\n              </SheetTrigger>\n              <SheetContent\n                side=\"end\"\n                showCloseButton={false}\n                className=\"flex w-[min(100%,20rem)] flex-col gap-0 border-border/70 p-0\"\n              >\n                <SheetHeader className=\"flex flex-row items-center justify-between space-y-0 border-b border-border/70 px-4 py-4 text-start\">\n                  <SheetTitle className=\"sr-only\">Menu</SheetTitle>\n                  <Brand />\n                  <SheetClose asChild>\n                    <Button\n                      variant=\"ghost\"\n                      size=\"icon\"\n                      className=\"size-8 rounded-full\"\n                      aria-label=\"Close\"\n                    >\n                      <XIcon className=\"size-4\" />\n                    </Button>\n                  </SheetClose>\n                </SheetHeader>\n                <div className=\"flex-1 overflow-y-auto p-4\">\n                  <ul className=\"flex flex-col gap-1 text-sm font-semibold text-foreground\">\n                    <li>\n                      <Collapsible>\n                        <CollapsibleTrigger className=\"flex w-full cursor-pointer items-center justify-between rounded-[12px] px-3 py-3 hover:bg-muted [&[data-state=open]>svg]:rotate-180\">\n                          Products\n                          <ChevronDownIcon className=\"size-4 shrink-0 transition-transform\" />\n                        </CollapsibleTrigger>\n                        <CollapsibleContent className=\"space-y-4 px-3 pb-3 pt-1\">\n                          {megaColumns.map((col) => (\n                            <div key={col.heading}>\n                              <p className=\"mb-2 text-xs font-semibold tracking-wider text-muted-foreground uppercase\">\n                                {col.heading}\n                              </p>\n                              <ul className=\"space-y-1 font-medium text-muted-foreground\">\n                                {col.items.map((item) => (\n                                  <li key={item}>\n                                    <a\n                                      href=\"#\"\n                                      className=\"flex cursor-pointer rounded-md px-2 py-1.5 hover:bg-muted hover:text-foreground\"\n                                    >\n                                      {item}\n                                    </a>\n                                  </li>\n                                ))}\n                              </ul>\n                            </div>\n                          ))}\n                        </CollapsibleContent>\n                      </Collapsible>\n                    </li>\n                    {links.map((link) => (\n                      <li key={link.label}>\n                        <a\n                          href={link.href}\n                          className=\"flex cursor-pointer rounded-[12px] px-3 py-3 hover:bg-muted\"\n                        >\n                          {link.label}\n                        </a>\n                      </li>\n                    ))}\n                  </ul>\n                </div>\n                <div className=\"border-t border-border/70 p-3\">\n                  <Button className={cn(\"w-full\", ctaClass)}>Sign up</Button>\n                </div>\n              </SheetContent>\n            </Sheet>\n          </div>\n        </nav>\n\n        {megaOpen ? (\n          <div id=\"mega-menu-panel\" ref={panelRef} className=\"absolute inset-x-0 top-full z-50\">\n            <div className=\"mx-auto w-full max-w-5xl overflow-hidden rounded-b-[12px] border border-t-0 border-border/70 bg-card shadow-md\">\n              <MegaPanel />\n            </div>\n          </div>\n        ) : null}\n      </header>\n\n      <main className=\"mx-auto flex w-full max-w-5xl flex-1 flex-col justify-center gap-3 px-6 py-14\">\n        <span className=\"h-0.5 w-8 rounded-full bg-primary\" aria-hidden />\n        <h1 className=\"max-w-lg text-balance text-h3 text-foreground\">\n          Products mega with striped columns\n        </h1>\n        <p className=\"max-w-md text-sm text-muted-foreground\">\n          Five category columns with alternating muted backgrounds — sheet on\n          small screens.\n        </p>\n      </main>\n    </div>\n  )\n}\n",
      "target": "components/blocks/navigation/mega-menu-03/mega-menu.tsx"
    }
