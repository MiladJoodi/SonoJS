      "type": "registry:component",
      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  AtSignIcon,\n  BellIcon,\n  CheckCheckIcon,\n  CheckIcon,\n  CircleAlertIcon,\n  EllipsisIcon,\n  GitPullRequestIcon,\n  KeyRoundIcon,\n  Trash2Icon,\n  UserPlusIcon,\n  XIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport { ScrollArea } from \"@/components/ui/scroll-area\"\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from \"@/components/ui/tabs\"\nimport { cn } from \"@/lib/utils\"\n\ntype NotificationType = \"mention\" | \"request\" | \"system\" | \"security\"\n\ntype Notification = {\n  id: string\n  type: NotificationType\n  title: string\n  body: string\n  time: string\n  unread: boolean\n  actor?: { name: string; initials: string }\n}\n\nconst INITIAL: Notification[] = [\n  {\n    id: \"n1\",\n    type: \"mention\",\n    title: \"Sarah Jenkins mentioned you\",\n    body: \"in #design-system — Could you review the primary button states before Friday's design review?\",\n    time: \"2m\",\n    unread: true,\n    actor: { name: \"Sarah Jenkins\", initials: \"SJ\" },\n  },\n  {\n    id: \"n2\",\n    type: \"request\",\n    title: \"Access request\",\n    body: \"David Chen requested editor access to the Sono Pro workspace.\",\n    time: \"45m\",\n    unread: true,\n    actor: { name: \"David Chen\", initials: \"DC\" },\n  },\n  {\n    id: \"n3\",\n    type: \"security\",\n    title: \"New sign-in\",\n    body: \"Chrome on macOS · San Francisco, CA. If this wasn’t you, revoke the session.\",\n    time: \"1h\",\n    unread: true,\n  },\n  {\n    id: \"n4\",\n    type: \"system\",\n    title: \"Production build succeeded\",\n    body: \"sonojs-web completed in 1m 24s. Preview is ready for review.\",\n    time: \"2h\",\n    unread: false,\n  },\n  {\n    id: \"n5\",\n    type: \"mention\",\n    title: \"Alex Rivera mentioned you\",\n    body: \"in PR #482 — Please take a look at the RTL spacing fixes when you have a moment.\",\n    time: \"Yesterday\",\n    unread: false,\n    actor: { name: \"Alex Rivera\", initials: \"AR\" },\n  },\n  {\n    id: \"n6\",\n    type: \"request\",\n    title: \"Invite accepted\",\n    body: \"Maya Patel joined Engineering as a member.\",\n    time: \"2d\",\n    unread: false,\n    actor: { name: \"Maya Patel\", initials: \"MP\" },\n  },\n]\n\nfunction typeTone(type: NotificationType) {\n  switch (type) {\n    case \"mention\":\n      return \"bg-primary/10 text-primary\"\n    case \"request\":\n      return \"bg-muted text-foreground\"\n    case \"security\":\n      return \"bg-destructive/10 text-destructive\"\n    default:\n      return \"bg-muted text-muted-foreground\"\n  }\n}\n\nfunction TypeIcon({\n  type,\n  className,\n}: {\n  type: NotificationType\n  className?: string\n}) {\n  const cls = cn(\"size-4\", className)\n  switch (type) {\n    case \"mention\":\n      return <AtSignIcon className={cls} aria-hidden />\n    case \"request\":\n      return <UserPlusIcon className={cls} aria-hidden />\n    case \"security\":\n      return <KeyRoundIcon className={cls} aria-hidden />\n    default:\n      return <GitPullRequestIcon className={cls} aria-hidden />\n  }\n}\n\nfunction filterItems(items: Notification[], filter: string) {\n  if (filter === \"unread\") return items.filter((n) => n.unread)\n  if (filter === \"mentions\") return items.filter((n) => n.type === \"mention\")\n  return items\n}\n\nexport default function NotificationCenter({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [items, setItems] = React.useState(INITIAL)\n  const unread = items.filter((n) => n.unread).length\n  const mentions = items.filter((n) => n.type === \"mention\").length\n\n  const markRead = (id: string) =>\n    setItems((prev) =>\n      prev.map((n) => (n.id === id ? { ...n, unread: false } : n))\n    )\n\n  const markAllRead = () =>\n    setItems((prev) => prev.map((n) => ({ ...n, unread: false })))\n\n  const remove = (id: string) =>\n    setItems((prev) => prev.filter((n) => n.id !== id))\n\n  return (\n    <div\n      className={cn(\n        \"flex w-full justify-center bg-canvas px-4 py-10 text-foreground sm:px-6 sm:py-14\",\n        className\n      )}\n      {...props}\n    >\n      <section\n        className=\"w-full max-w-md overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\"\n        aria-label=\"Notifications\"\n      >\n        <header className=\"flex items-start justify-between gap-3 border-b border-border/70 px-4 py-4 sm:px-5\">\n          <div className=\"min-w-0 text-start\">\n            <div className=\"flex items-center gap-2\">\n              <h1 className=\"text-base font-semibold tracking-tight\">\n                Notifications\n              </h1>\n              {unread > 0 ? (\n                <Badge variant=\"secondary\" className=\"tabular-nums\">\n                  {unread}\n                </Badge>\n              ) : null}\n            </div>\n            <p className=\"mt-1 text-sm text-muted-foreground\" role=\"status\">\n              {unread > 0\n                ? `${unread} unread`\n                : \"You're all caught up\"}\n            </p>\n          </div>\n          <Button\n            type=\"button\"\n            variant=\"ghost\"\n            size=\"sm\"\n            className=\"shrink-0 cursor-pointer gap-1.5 disabled:cursor-not-allowed\"\n            disabled={unread === 0}\n            onClick={markAllRead}\n          >\n            <CheckCheckIcon className=\"size-3.5\" aria-hidden />\n            Mark all read\n          </Button>\n        </header>\n\n        <Tabs defaultValue=\"all\" className=\"gap-0\">\n          <div className=\"border-b border-border/70 px-2 pt-1\">\n            <TabsList\n              variant=\"line\"\n              className=\"h-10 w-full justify-start rounded-none bg-transparent p-0\"\n            >\n              <TabsTrigger value=\"all\" className=\"px-3\">\n                All\n                <span className=\"text-muted-foreground tabular-nums\">\n                  {items.length}\n                </span>\n              </TabsTrigger>\n              <TabsTrigger value=\"unread\" className=\"px-3\">\n                Unread\n                <span className=\"text-muted-foreground tabular-nums\">\n                  {unread}\n                </span>\n              </TabsTrigger>\n              <TabsTrigger value=\"mentions\" className=\"px-3\">\n                Mentions\n                <span className=\"text-muted-foreground tabular-nums\">\n                  {mentions}\n                </span>\n              </TabsTrigger>\n            </TabsList>\n          </div>\n\n          {([\"all\", \"unread\", \"mentions\"] as const).map((filter) => {\n            const list = filterItems(items, filter)\n            return (\n              <TabsContent key={filter} value={filter} className=\"mt-0\">\n                {list.length === 0 ? (\n                  <div className=\"flex flex-col items-center px-6 py-14 text-center\">\n                    <div className=\"mb-3 flex size-10 items-center justify-center rounded-full bg-muted\">\n                      {filter === \"mentions\" ? (\n                        <AtSignIcon\n                          className=\"size-4 text-muted-foreground\"\n                          aria-hidden\n                        />\n                      ) : (\n                        <BellIcon\n                          className=\"size-4 text-muted-foreground\"\n                          aria-hidden\n                        />\n                      )}\n                    </div>\n                    <p className=\"text-sm font-medium\">\n                      {filter === \"unread\"\n                        ? \"No unread notifications\"\n                        : filter === \"mentions\"\n                          ? \"No mentions yet\"\n                          : \"Inbox is empty\"}\n                    </p>\n                    <p className=\"mt-1 max-w-[16rem] text-sm text-muted-foreground\">\n                      New activity from your team will show up here.\n                    </p>\n                  </div>\n                ) : (\n                  <ScrollArea className=\"h-[min(28rem,55svh)]\">\n                    <ul className=\"divide-y divide-border/70\">\n                      {list.map((item) => (\n                        <li key={item.id}>\n                          <div\n                            className={cn(\n                              \"group relative flex gap-3 px-4 py-3.5 transition-colors sm:px-5\",\n                              item.unread\n                                ? \"bg-primary/[0.04] hover:bg-primary/[0.07]\"\n                                : \"hover:bg-muted/40\"\n                            )}\n                          >\n                            <div className=\"relative shrink-0 pt-0.5\">\n                              {item.actor ? (\n                                <Avatar size=\"default\">\n                                  <AvatarFallback>\n                                    {item.actor.initials}\n                                  </AvatarFallback>\n                                </Avatar>\n                              ) : (\n                                <div\n                                  className={cn(\n                                    \"flex size-8 items-center justify-center rounded-full\",\n                                    typeTone(item.type)\n                                  )}\n                                >\n                                  <TypeIcon type={item.type} />\n                                </div>\n                              )}\n                              {item.actor ? (\n                                <span\n                                  className={cn(\n                                    \"absolute -end-0.5 -bottom-0.5 flex size-4 items-center justify-center rounded-full ring-2 ring-card\",\n                                    typeTone(item.type)\n                                  )}\n                                  aria-hidden\n                                >\n                                  <TypeIcon\n                                    type={item.type}\n                                    className=\"size-2.5\"\n                                  />\n                                </span>\n                              ) : null}\n                            </div>\n\n                            <div className=\"min-w-0 flex-1 text-start\">\n                              <div className=\"flex items-start gap-2\">\n                                <button\n                                  type=\"button\"\n                                  className=\"min-w-0 flex-1 cursor-pointer text-start\"\n                                  onClick={() => markRead(item.id)}\n                                >\n                                  <div className=\"flex items-baseline justify-between gap-2\">\n                                    <p\n                                      className={cn(\n                                        \"truncate text-sm\",\n                                        item.unread\n                                          ? \"font-semibold text-foreground\"\n                                          : \"font-medium text-foreground\"\n                                      )}\n                                    >\n                                      {item.title}\n                                    </p>\n                                    <time\n                                      className=\"shrink-0 text-xs text-muted-foreground tabular-nums\"\n                                      dateTime={item.time}\n                                    >\n                                      {item.time}\n                                    </time>\n                                  </div>\n                                  <p className=\"mt-0.5 line-clamp-2 text-sm leading-snug text-muted-foreground\">\n                                    {item.body}\n                                  </p>\n                                  {item.unread ? (\n                                    <span className=\"sr-only\">Unread</span>\n                                  ) : null}\n                                </button>\n                                <span\n                                  className={cn(\n                                    \"mt-1.5 size-1.5 shrink-0 rounded-full\",\n                                    item.unread\n                                      ? \"bg-primary\"\n                                      : \"bg-transparent\"\n                                  )}\n                                  aria-hidden\n                                />\n                              </div>\n\n                              {item.type === \"request\" && item.unread ? (\n                                <div className=\"mt-2.5 flex flex-wrap gap-2\">\n                                  <Button\n                                    type=\"button\"\n                                    size=\"xs\"\n                                    className=\"cursor-pointer gap-1\"\n                                    onClick={() => markRead(item.id)}\n                                  >\n                                    <CheckIcon className=\"size-3.5\" aria-hidden />\n                                    Approve\n                                  </Button>\n                                  <Button\n                                    type=\"button\"\n                                    size=\"xs\"\n                                    variant=\"outline\"\n                                    className=\"cursor-pointer gap-1\"\n                                    onClick={() => remove(item.id)}\n                                  >\n                                    <XIcon className=\"size-3.5\" aria-hidden />\n                                    Decline\n                                  </Button>\n                                </div>\n                              ) : null}\n\n                              {item.type === \"security\" && item.unread ? (\n                                <div className=\"mt-2.5 flex flex-wrap gap-2\">\n                                  <Button\n                                    type=\"button\"\n                                    size=\"xs\"\n                                    variant=\"outline\"\n                                    className=\"cursor-pointer gap-1\"\n                                    onClick={() => markRead(item.id)}\n                                  >\n                                    <CircleAlertIcon\n                                      className=\"size-3.5\"\n                                      aria-hidden\n                                    />\n                                    Review session\n                                  </Button>\n                                </div>\n                              ) : null}\n\n                              {item.type === \"mention\" && item.unread ? (\n                                <div className=\"mt-2.5\">\n                                  <Button\n                                    type=\"button\"\n                                    size=\"xs\"\n                                    variant=\"outline\"\n                                    className=\"cursor-pointer\"\n                                    onClick={() => markRead(item.id)}\n                                  >\n                                    Open thread\n                                  </Button>\n                                </div>\n                              ) : null}\n                            </div>\n\n                            <DropdownMenu>\n                              <DropdownMenuTrigger asChild>\n                                <Button\n                                  type=\"button\"\n                                  variant=\"ghost\"\n                                  size=\"icon-xs\"\n                                  className=\"absolute end-2 top-2 cursor-pointer opacity-0 group-hover:opacity-100 focus-visible:opacity-100 data-[state=open]:opacity-100\"\n                                  aria-label={`Actions for ${item.title}`}\n                                >\n                                  <EllipsisIcon className=\"size-4\" aria-hidden />\n                                </Button>\n                              </DropdownMenuTrigger>\n                              <DropdownMenuContent align=\"end\" className=\"w-44\">\n                                {item.unread ? (\n                                  <>\n                                    <DropdownMenuItem\n                                      onClick={() => markRead(item.id)}\n                                    >\n                                      <CheckIcon\n                                        className=\"size-4\"\n                                        aria-hidden\n                                      />\n                                      Mark as read\n                                    </DropdownMenuItem>\n                                    <DropdownMenuSeparator />\n                                  </>\n                                ) : null}\n                                <DropdownMenuItem\n                                  variant=\"destructive\"\n                                  onClick={() => remove(item.id)}\n                                >\n                                  <Trash2Icon className=\"size-4\" aria-hidden />\n                                  Delete\n                                </DropdownMenuItem>\n                              </DropdownMenuContent>\n                            </DropdownMenu>\n                          </div>\n                        </li>\n                      ))}\n                    </ul>\n                  </ScrollArea>\n                )}\n              </TabsContent>\n            )\n          })}\n        </Tabs>\n      </section>\n    </div>\n  )\n}\n",
      "target": "components/blocks/communication/notification-center-01/notification-center.tsx"
    }
  ],
