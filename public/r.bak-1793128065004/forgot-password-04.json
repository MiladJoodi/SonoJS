      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport { CheckIcon } from \"lucide-react\"\n\nimport { cn } from \"@/lib/utils\"\nimport { Button } from \"@/components/ui/button\"\nimport { Input } from \"@/components/ui/input\"\nimport {\n  InputOTP,\n  InputOTPGroup,\n  InputOTPSeparator,\n  InputOTPSlot,\n} from \"@/components/ui/input-otp\"\nimport { Label } from \"@/components/ui/label\"\n\nconst controlClass = \"shadow-none\"\n\nconst steps = [\"Email\", \"Code\", \"Password\"] as const\n\nfunction Stepper({ step }: { step: number }) {\n  return (\n    <ol className=\"flex w-full items-center gap-2\">\n      {steps.map((label, index) => {\n        const n = index + 1\n        const active = n === step\n        const done = n < step\n        return (\n          <li key={label} className=\"flex min-w-0 flex-1 flex-col gap-2\">\n            <div className=\"flex items-center gap-2\">\n              <span\n                className={cn(\n                  \"flex size-7 shrink-0 items-center justify-center rounded-full text-xs font-medium\",\n                  done && \"bg-primary text-primary-foreground\",\n                  active && \"bg-primary text-primary-foreground\",\n                  !done && !active && \"bg-muted text-muted-foreground\"\n                )}\n              >\n                {done ? <CheckIcon className=\"size-3.5\" /> : n}\n              </span>\n              <span\n                className={cn(\n                  \"truncate text-xs font-medium\",\n                  active || done ? \"text-foreground\" : \"text-muted-foreground\"\n                )}\n              >\n                {label}\n              </span>\n            </div>\n            <div\n              className={cn(\n                \"h-0.5 w-full rounded-full\",\n                done || active ? \"bg-primary\" : \"bg-muted\"\n              )}\n            />\n          </li>\n        )\n      })}\n    </ol>\n  )\n}\n\nexport default function ForgotPasswordForm({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const [step, setStep] = React.useState(1)\n  const [otp, setOtp] = React.useState(\"\")\n\n  return (\n    <div\n      className={cn(\n        \"flex w-full items-center justify-center bg-canvas px-6 py-10\",\n        className\n      )}\n      {...props}\n    >\n      <div\n        className={cn(\n          \"[--login-card-padding:1.5rem] sm:[--login-card-padding:2rem]\",\n          \"flex w-full max-w-md flex-col gap-8 rounded-[12px] border border-border/70 bg-card p-(--login-card-padding)\",\n          \"shadow-soft\",\n          \"\"\n        )}\n\n              style={{\n                backgroundColor: \"var(--card, #ffffff)\",\n                boxShadow:\n                  \"var(--shadow-soft, 0 2px 4px -1px rgba(10, 10, 12, 0.04), 0 28px 56px -28px rgba(10, 10, 12, 0.18))\",\n              }}\n            >\n        <header className=\"flex flex-col items-start gap-3\">\n          <span className=\"h-0.5 w-8 rounded-full bg-primary\" aria-hidden />\n          <div className=\"space-y-1.5\">\n            <h1 className=\"text-h3 text-foreground\">Reset your password</h1>\n            <p className=\"text-sm text-muted-foreground\">\n              Email, then a code, then choose a new password.\n            </p>\n          </div>\n        </header>\n\n        <Stepper step={step} />\n\n        {step === 1 ? (\n          <form\n            className=\"flex flex-col gap-4\"\n            onSubmit={(event) => {\n              event.preventDefault()\n              setStep(2)\n            }}\n          >\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"forgot-04-email\">Email</Label>\n              <Input\n                id=\"forgot-04-email\"\n                type=\"email\"\n                dir=\"ltr\"\n                autoComplete=\"email\"\n                placeholder=\"name@example.com\"\n                required\n                className={controlClass}\n              />\n            </div>\n            <Button\n              type=\"submit\"\n              className=\"mt-1 w-full shadow-none\"\n            >\n              Send code\n            </Button>\n          </form>\n        ) : null}\n\n        {step === 2 ? (\n          <form\n            className=\"flex flex-col gap-4\"\n            onSubmit={(event) => {\n              event.preventDefault()\n              setStep(3)\n            }}\n          >\n            <div className=\"flex flex-col items-center gap-2\">\n              <Label htmlFor=\"forgot-04-otp\" className=\"sr-only\">\n                Verification code\n              </Label>\n              <div dir=\"ltr\" className=\"flex w-full justify-center\">\n                <InputOTP\n                  id=\"forgot-04-otp\"\n                  maxLength={6}\n                  value={otp}\n                  onChange={setOtp}\n                  containerClassName=\"justify-center\"\n                >\n                  <InputOTPGroup>\n                    <InputOTPSlot index={0} />\n                    <InputOTPSlot index={1} />\n                    <InputOTPSlot index={2} />\n                  </InputOTPGroup>\n                  <InputOTPSeparator />\n                  <InputOTPGroup>\n                    <InputOTPSlot index={3} />\n                    <InputOTPSlot index={4} />\n                    <InputOTPSlot index={5} />\n                  </InputOTPGroup>\n                </InputOTP>\n              </div>\n            </div>\n            <div className=\"grid gap-2 sm:grid-cols-2\">\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                className=\"border-border/70 bg-card shadow-none hover:bg-muted\"\n                onClick={() => setStep(1)}>\n                Back\n              </Button>\n              <Button\n                type=\"submit\"\n                className=\"h-[46px] rounded-[12px] shadow-none\"\n              >\n                Continue\n              </Button>\n            </div>\n          </form>\n        ) : null}\n\n        {step === 3 ? (\n          <form\n            className=\"flex flex-col gap-4\"\n            onSubmit={(event) => event.preventDefault()}\n          >\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"forgot-04-password\">New password</Label>\n              <Input\n                id=\"forgot-04-password\"\n                type=\"password\"\n                autoComplete=\"new-password\"\n                placeholder={\"\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\"}\n                required\n                className={controlClass}\n              />\n            </div>\n            <div className=\"grid gap-2\">\n              <Label htmlFor=\"forgot-04-confirm\">Confirm password</Label>\n              <Input\n                id=\"forgot-04-confirm\"\n                type=\"password\"\n                autoComplete=\"new-password\"\n                placeholder={\"\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\\u2022\"}\n                required\n                className={controlClass}\n              />\n            </div>\n            <div className=\"grid gap-2 sm:grid-cols-2\">\n              <Button\n                type=\"button\"\n                variant=\"outline\"\n                className=\"border-border/70 bg-card shadow-none hover:bg-muted\"\n                onClick={() => setStep(2)}\n            >\n                Back\n              </Button>\n              <Button\n                type=\"submit\"\n                className=\"h-[46px] rounded-[12px] shadow-none\"\n              >\n                Update password\n              </Button>\n            </div>\n          </form>\n        ) : null}\n\n        <p className=\"text-center text-sm text-muted-foreground\">\n          Remembered it?{\" \"}\n          <a\n            href=\"#\"\n            className=\"cursor-pointer font-medium text-foreground underline-offset-4 hover:underline\"\n          >\n            Back to sign in\n          </a>\n        </p>\n      </div>\n    </div>\n  )\n}\n",
