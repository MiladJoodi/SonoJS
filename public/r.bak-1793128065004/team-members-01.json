      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  EllipsisIcon,\n  MailIcon,\n  PlusIcon,\n  ShieldIcon,\n  Trash2Icon,\n  UserIcon,\n  UserMinusIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Dialog,\n  DialogClose,\n  DialogContent,\n  DialogDescription,\n  DialogFooter,\n  DialogHeader,\n  DialogTitle,\n  DialogTrigger,\n} from \"@/components/ui/dialog\"\nimport {\n  DropdownMenu,\n  DropdownMenuContent,\n  DropdownMenuItem,\n  DropdownMenuSeparator,\n  DropdownMenuTrigger,\n} from \"@/components/ui/dropdown-menu\"\nimport {\n  Field,\n  FieldGroup,\n  FieldLabel,\n} from \"@/components/ui/field\"\nimport { Input } from \"@/components/ui/input\"\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@/components/ui/select\"\nimport {\n  Table,\n  TableBody,\n  TableCell,\n  TableHead,\n  TableHeader,\n  TableRow,\n} from \"@/components/ui/table\"\nimport { cn } from \"@/lib/utils\"\n\ntype Role = \"Owner\" | \"Admin\" | \"Member\" | \"Viewer\"\ntype Status = \"Active\" | \"Invited\"\n\ntype Member = {\n  id: string\n  name: string\n  email: string\n  role: Role\n  status: Status\n  initials: string\n}\n\nconst MEMBERS: Member[] = [\n  {\n    id: \"1\",\n    name: \"Alice Johnson\",\n    email: \"alice@example.com\",\n    role: \"Owner\",\n    status: \"Active\",\n    initials: \"AJ\",\n  },\n  {\n    id: \"2\",\n    name: \"Bob Smith\",\n    email: \"bob@example.com\",\n    role: \"Admin\",\n    status: \"Active\",\n    initials: \"BS\",\n  },\n  {\n    id: \"3\",\n    name: \"Charlie Davis\",\n    email: \"charlie@example.com\",\n    role: \"Member\",\n    status: \"Active\",\n    initials: \"CD\",\n  },\n  {\n    id: \"4\",\n    name: \"Diana Prince\",\n    email: \"diana@example.com\",\n    role: \"Member\",\n    status: \"Invited\",\n    initials: \"DP\",\n  },\n]\n\nfunction statusBadge(status: Status) {\n  if (status === \"Active\") {\n    return \"bg-emerald-500/10 text-emerald-700 dark:text-emerald-300\"\n  }\n  return \"bg-amber-500/10 text-amber-700 dark:text-amber-300\"\n}\n\nfunction InviteDialog() {\n  const [open, setOpen] = React.useState(false)\n\n  return (\n    <Dialog open={open} onOpenChange={setOpen}>\n      <DialogTrigger asChild>\n        <Button type=\"button\" className=\"gap-1.5\">\n          <PlusIcon className=\"size-4\" aria-hidden />\n          Invite member\n        </Button>\n      </DialogTrigger>\n      <DialogContent\n        className=\"gap-0 p-0 sm:max-w-md\"\n        style={{ maxWidth: \"min(28rem, calc(100% - 2rem))\" }}\n      >\n        <DialogHeader className=\"border-b border-border/70 px-6 py-5 text-start\">\n          <DialogTitle>Invite to team</DialogTitle>\n          <DialogDescription>\n            Send an email invitation to add someone to this workspace.\n          </DialogDescription>\n        </DialogHeader>\n        <div className=\"px-6 py-5\">\n          <FieldGroup className=\"gap-4\">\n            <Field>\n              <FieldLabel htmlFor=\"team-members-01-email\">\n                Email address\n              </FieldLabel>\n              <Input\n                id=\"team-members-01-email\"\n                type=\"email\"\n                placeholder=\"colleague@company.com\"\n                autoComplete=\"email\"\n              />\n            </Field>\n            <Field>\n              <FieldLabel htmlFor=\"team-members-01-role\">Role</FieldLabel>\n              <Select defaultValue=\"member\">\n                <SelectTrigger id=\"team-members-01-role\" className=\"w-full\">\n                  <SelectValue placeholder=\"Select role\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"admin\">Admin — full access</SelectItem>\n                  <SelectItem value=\"member\">\n                    Member — can edit projects\n                  </SelectItem>\n                  <SelectItem value=\"viewer\">Viewer — read only</SelectItem>\n                </SelectContent>\n              </Select>\n            </Field>\n          </FieldGroup>\n        </div>\n        <DialogFooter className=\"border-t border-border/70 px-6 py-4\">\n          <DialogClose asChild>\n            <Button type=\"button\" variant=\"ghost\">\n              Cancel\n            </Button>\n          </DialogClose>\n          <Button type=\"button\" onClick={() => setOpen(false)}>\n            Send invitation\n          </Button>\n        </DialogFooter>\n      </DialogContent>\n    </Dialog>\n  )\n}\n\nfunction MemberActions({ member }: { member: Member }) {\n  const isOwner = member.role === \"Owner\"\n  return (\n    <DropdownMenu>\n      <DropdownMenuTrigger asChild>\n        <Button\n          type=\"button\"\n          variant=\"ghost\"\n          size=\"icon-xs\"\n          aria-label={`Manage ${member.name}`}\n        >\n          <EllipsisIcon className=\"size-4\" aria-hidden />\n        </Button>\n      </DropdownMenuTrigger>\n      <DropdownMenuContent align=\"end\" className=\"w-48\">\n        {member.status === \"Invited\" ? (\n          <DropdownMenuItem>\n            <MailIcon className=\"size-4\" aria-hidden />\n            Resend invite\n          </DropdownMenuItem>\n        ) : (\n          <DropdownMenuItem disabled={isOwner}>\n            <ShieldIcon className=\"size-4\" aria-hidden />\n            Change role\n          </DropdownMenuItem>\n        )}\n        <DropdownMenuSeparator />\n        <DropdownMenuItem variant=\"destructive\" disabled={isOwner}>\n          {member.status === \"Invited\" ? (\n            <>\n              <Trash2Icon className=\"size-4\" aria-hidden />\n              Revoke invite\n            </>\n          ) : (\n            <>\n              <UserMinusIcon className=\"size-4\" aria-hidden />\n              Remove member\n            </>\n          )}\n        </DropdownMenuItem>\n      </DropdownMenuContent>\n    </DropdownMenu>\n  )\n}\n\nexport default function TeamMembers({\n  className,\n  ...props\n}: React.ComponentProps<\"div\">) {\n  const active = MEMBERS.filter((m) => m.status === \"Active\").length\n  const invited = MEMBERS.filter((m) => m.status === \"Invited\").length\n\n  return (\n    <div\n      className={cn(\n        \"w-full bg-canvas px-4 py-8 text-foreground sm:px-6 sm:py-10\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"mx-auto w-full max-w-4xl space-y-6\">\n        <div className=\"flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between\">\n          <div className=\"min-w-0 text-start\">\n            <h1 className=\"text-2xl font-semibold tracking-tight\">\n              Team members\n            </h1>\n            <p className=\"mt-1 text-sm text-muted-foreground\">\n              Manage people, roles, and pending invitations.\n            </p>\n          </div>\n          <InviteDialog />\n        </div>\n\n        <section className=\"overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\">\n          <div className=\"border-b border-border/70 px-5 py-4 sm:px-6\">\n            <h2 className=\"text-sm font-semibold\">Workspace team</h2>\n            <p className=\"mt-0.5 text-sm text-muted-foreground\">\n              {active} active\n              {invited > 0 ? ` · ${invited} pending` : null}\n            </p>\n          </div>\n\n          <div className=\"overflow-x-auto\">\n            <Table>\n              <TableHeader>\n                <TableRow className=\"hover:bg-transparent\">\n                  <TableHead className=\"ps-5 sm:ps-6\">Member</TableHead>\n                  <TableHead>Role</TableHead>\n                  <TableHead>Status</TableHead>\n                  <TableHead className=\"w-12 pe-5 text-end sm:pe-6\">\n                    <span className=\"sr-only\">Actions</span>\n                  </TableHead>\n                </TableRow>\n              </TableHeader>\n              <TableBody>\n                {MEMBERS.map((member) => {\n                  const privileged =\n                    member.role === \"Owner\" || member.role === \"Admin\"\n                  return (\n                    <TableRow key={member.id}>\n                      <TableCell className=\"ps-5 sm:ps-6\">\n                        <div className=\"flex items-center gap-3\">\n                          <Avatar size=\"default\">\n                            <AvatarFallback>{member.initials}</AvatarFallback>\n                          </Avatar>\n                          <div className=\"min-w-0 text-start\">\n                            <p className=\"truncate text-sm font-medium\">\n                              {member.name}\n                            </p>\n                            <p className=\"truncate text-xs text-muted-foreground\">\n                              {member.email}\n                            </p>\n                          </div>\n                        </div>\n                      </TableCell>\n                      <TableCell>\n                        <div className=\"flex items-center gap-2\">\n                          {privileged ? (\n                            <ShieldIcon\n                              className=\"size-3.5 text-primary\"\n                              aria-hidden\n                            />\n                          ) : (\n                            <UserIcon\n                              className=\"size-3.5 text-muted-foreground\"\n                              aria-hidden\n                            />\n                          )}\n                          <span className=\"text-sm font-medium\">\n                            {member.role}\n                          </span>\n                        </div>\n                      </TableCell>\n                      <TableCell>\n                        <Badge\n                          variant=\"secondary\"\n                          className={statusBadge(member.status)}\n                        >\n                          {member.status}\n                        </Badge>\n                      </TableCell>\n                      <TableCell className=\"pe-5 text-end sm:pe-6\">\n                        <MemberActions member={member} />\n                      </TableCell>\n                    </TableRow>\n                  )\n                })}\n              </TableBody>\n            </Table>\n          </div>\n        </section>\n      </div>\n    </div>\n  )\n}\n",
      "target": "components/blocks/user-account/team-members-01/team-members.tsx"
    }
  ],
