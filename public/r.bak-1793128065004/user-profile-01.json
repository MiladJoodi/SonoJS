      "content": "\"use client\"\n\nimport * as React from \"react\"\nimport {\n  BookOpenIcon,\n  CalendarIcon,\n  ExternalLinkIcon,\n  GitForkIcon,\n  Link2Icon,\n  MapPinIcon,\n  MessageSquareIcon,\n  MoreHorizontalIcon,\n  StarIcon,\n} from \"lucide-react\"\n\nimport { Avatar, AvatarFallback, AvatarImage } from \"@/components/ui/avatar\"\nimport { Badge } from \"@/components/ui/badge\"\nimport { Button } from \"@/components/ui/button\"\nimport { Separator } from \"@/components/ui/separator\"\nimport {\n  Tabs,\n  TabsContent,\n  TabsList,\n  TabsTrigger,\n} from \"@/components/ui/tabs\"\nimport { cn } from \"@/lib/utils\"\n\nimport avatarImg from \"./images/avatar.webp\"\n\nfunction assetSrc(asset: string | { src: string }) {\n  return typeof asset === \"string\" ? asset : asset.src\n}\n\nconst USER = {\n  name: \"Alex Rivera\",\n  username: \"@alexrivera\",\n  bio: \"Full-stack developer passionate about design systems and accessible UI. Building open-source UI kits in public.\",\n  location: \"San Francisco, CA\",\n  website: \"alexrivera.dev\",\n  joinDate: \"March 2022\",\n  following: 234,\n  followers: 1842,\n} as const\n\nconst STATS = [\n  { label: \"Repositories\", value: \"48\" },\n  { label: \"Stars Earned\", value: \"2.4k\" },\n  { label: \"Contributions\", value: \"1,203\" },\n  { label: \"Pull Requests\", value: \"87\" },\n] as const\n\nconst PINNED_REPOS = [\n  {\n    name: \"sono-ui\",\n    description:\n      \"Production-ready React component library with accessible primitives and a clear token scale.\",\n    language: \"TypeScript\",\n    stars: 1204,\n    forks: 89,\n    dotClass: \"bg-sky-500\",\n  },\n  {\n    name: \"design-system-starter\",\n    description:\n      \"Opinionated starter template for building design systems with accessible primitives and Tailwind CSS.\",\n    language: \"TypeScript\",\n    stars: 387,\n    forks: 42,\n    dotClass: \"bg-sky-500\",\n  },\n  {\n    name: \"oklch-tools\",\n    description:\n      \"CLI and browser tools for working with oklch perceptual color space in CSS.\",\n    language: \"JavaScript\",\n    stars: 156,\n    forks: 18,\n    dotClass: \"bg-amber-500\",\n  },\n  {\n    name: \"react-router-workshop\",\n    description:\n      \"Hands-on workshop code for React Router with SSR, data loading, and form actions.\",\n    language: \"TypeScript\",\n    stars: 98,\n    forks: 31,\n    dotClass: \"bg-sky-500\",\n  },\n] as const\n\nconst ACTIVITY = [\n  {\n    type: \"commit\",\n    repo: \"sono-ui\",\n    message: \"feat: add oklch color preview to theme switcher\",\n    time: \"2 hours ago\",\n  },\n  {\n    type: \"pr\",\n    repo: \"radix-ui/primitives\",\n    message: \"fix: correct aria-label for Dialog close button\",\n    time: \"Yesterday\",\n  },\n  {\n    type: \"star\",\n    repo: \"tailwindlabs/tailwindcss\",\n    message: \"starred repository\",\n    time: \"2 days ago\",\n  },\n  {\n    type: \"issue\",\n    repo: \"sono-ui\",\n    message: \"fix: Slider thumb focus ring not visible in Safari\",\n    time: \"3 days ago\",\n  },\n  {\n    type: \"commit\",\n    repo: \"design-system-starter\",\n    message: \"docs: add migration guide from Tailwind v3\",\n    time: \"4 days ago\",\n  },\n] as const\n\nconst SKILLS = [\n  \"TypeScript\",\n  \"React\",\n  \"Tailwind CSS\",\n  \"Node.js\",\n  \"CSS\",\n  \"Design Systems\",\n] as const\n\nfunction ActivityIcon({ type }: { type: string }) {\n  const map: Record<\n    string,\n    { icon: React.ReactNode; className: string }\n  > = {\n    commit: {\n      icon: <BookOpenIcon aria-hidden className=\"size-3\" />,\n      className: \"bg-emerald-500/10 text-emerald-600 dark:text-emerald-400\",\n    },\n    pr: {\n      icon: <GitForkIcon aria-hidden className=\"size-3\" />,\n      className: \"bg-sky-500/10 text-sky-600 dark:text-sky-400\",\n    },\n    star: {\n      icon: <StarIcon aria-hidden className=\"size-3\" />,\n      className: \"bg-amber-500/10 text-amber-600 dark:text-amber-400\",\n    },\n    issue: {\n      icon: <MessageSquareIcon aria-hidden className=\"size-3\" />,\n      className: \"bg-primary/10 text-primary\",\n    },\n  }\n  const entry = map[type] ?? map.commit\n  return (\n    <div\n      className={cn(\n        \"flex size-6 shrink-0 items-center justify-center rounded-full\",\n        entry.className\n      )}\n    >\n      {entry.icon}\n    </div>\n  )\n}\n\nexport default function UserProfile({\n  className,\n  ...props\n}: React.ComponentProps<\"main\">) {\n  const [following, setFollowing] = React.useState(false)\n\n  return (\n    <main\n      className={cn(\n        \"min-h-svh w-full min-w-0 bg-canvas text-foreground\",\n        className\n      )}\n      {...props}\n    >\n      <div className=\"h-40 bg-muted sm:h-52\" aria-hidden />\n\n      <div className=\"mx-auto max-w-5xl px-4 sm:px-6 lg:px-8\">\n        <div className=\"-mt-16 mb-6 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between\">\n          <div className=\"flex items-end gap-4\">\n            <Avatar className=\"size-24 ring-4 ring-canvas shadow-soft sm:size-28\">\n              <AvatarImage src={assetSrc(avatarImg)} alt={USER.name} />\n              <AvatarFallback className=\"text-lg\">AR</AvatarFallback>\n            </Avatar>\n            <div className=\"mb-2 min-w-0 text-start\">\n              <h1 className=\"text-2xl font-semibold tracking-tight text-foreground\">\n                {USER.name}\n              </h1>\n              <p className=\"text-sm text-muted-foreground\">{USER.username}</p>\n            </div>\n          </div>\n\n          <div className=\"flex shrink-0 flex-wrap gap-2\">\n            <Button\n              type=\"button\"\n              size=\"sm\"\n              variant={following ? \"outline\" : \"default\"}\n              className=\"flex-1 justify-center sm:flex-none\"\n              onClick={() => setFollowing((v) => !v)}\n            >\n              {following ? \"Following\" : \"Follow\"}\n            </Button>\n            <Button\n              type=\"button\"\n              variant=\"outline\"\n              size=\"sm\"\n              className=\"flex-1 justify-center sm:flex-none\"\n            >\n              Edit Profile\n            </Button>\n            <Button\n              type=\"button\"\n              variant=\"ghost\"\n              size=\"sm\"\n              aria-label=\"More options\"\n              className=\"shrink-0\"\n            >\n              <MoreHorizontalIcon aria-hidden />\n            </Button>\n          </div>\n        </div>\n\n        <div className=\"grid gap-8 lg:grid-cols-[280px_minmax(0,1fr)]\">\n          <aside className=\"min-w-0\">\n            <div className=\"flex flex-col gap-6\">\n              <div className=\"text-start\">\n                <p className=\"text-sm leading-relaxed text-muted-foreground\">\n                  {USER.bio}\n                </p>\n                <ul className=\"mt-4 space-y-2\" role=\"list\">\n                  <li className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                    <MapPinIcon\n                      className=\"size-4 shrink-0\"\n                      aria-hidden\n                    />\n                    {USER.location}\n                  </li>\n                  <li className=\"flex items-center gap-2 text-sm\">\n                    <Link2Icon\n                      className=\"size-4 shrink-0 text-muted-foreground\"\n                      aria-hidden\n                    />\n                    <a\n                      href={`https://${USER.website}`}\n                      className=\"cursor-pointer text-primary hover:underline\"\n                      dir=\"ltr\"\n                    >\n                      {USER.website}\n                    </a>\n                  </li>\n                  <li className=\"flex items-center gap-2 text-sm text-muted-foreground\">\n                    <CalendarIcon\n                      className=\"size-4 shrink-0\"\n                      aria-hidden\n                    />\n                    Joined {USER.joinDate}\n                  </li>\n                </ul>\n              </div>\n\n              <div className=\"flex items-center gap-4\">\n                <div className=\"text-start\">\n                  <p className=\"text-sm font-bold tabular-nums text-foreground\">\n                    {USER.followers.toLocaleString(\"en-US\")}\n                  </p>\n                  <p className=\"text-xs text-muted-foreground\">followers</p>\n                </div>\n                <Separator orientation=\"vertical\" className=\"h-8\" />\n                <div className=\"text-start\">\n                  <p className=\"text-sm font-bold tabular-nums text-foreground\">\n                    {USER.following}\n                  </p>\n                  <p className=\"text-xs text-muted-foreground\">following</p>\n                </div>\n              </div>\n\n              <Separator />\n\n              <div className=\"grid grid-cols-1 gap-3 sm:grid-cols-2\">\n                {STATS.map((stat) => (\n                  <div\n                    key={stat.label}\n                    className=\"rounded-[12px] border border-border/70 bg-card p-3 shadow-soft\"\n                  >\n                    <p\n                      dir=\"ltr\"\n                      className=\"text-lg font-semibold tabular-nums text-foreground\"\n                    >\n                      {stat.value}\n                    </p>\n                    <p className=\"text-xs text-muted-foreground\">{stat.label}</p>\n                  </div>\n                ))}\n              </div>\n\n              <div className=\"text-start\">\n                <p className=\"mb-3 text-xs font-semibold tracking-wider text-muted-foreground uppercase\">\n                  Top Skills\n                </p>\n                <div className=\"flex flex-wrap gap-2\">\n                  {SKILLS.map((skill) => (\n                    <Badge key={skill} variant=\"secondary\">\n                      {skill}\n                    </Badge>\n                  ))}\n                </div>\n              </div>\n            </div>\n          </aside>\n\n          <div className=\"min-w-0\">\n            <Tabs defaultValue=\"repos\" className=\"gap-0\">\n              <TabsList\n                variant=\"line\"\n                aria-label=\"Profile sections\"\n                className=\"h-auto w-full max-w-full justify-start gap-0 overflow-x-auto rounded-none bg-transparent p-0\"\n              >\n                <TabsTrigger value=\"repos\">Repositories</TabsTrigger>\n                <TabsTrigger value=\"activity\">Activity</TabsTrigger>\n                <TabsTrigger value=\"stars\">Starred</TabsTrigger>\n              </TabsList>\n\n              <TabsContent value=\"repos\" className=\"mt-6\">\n                <p className=\"mb-4 text-start text-sm text-muted-foreground\">\n                  {PINNED_REPOS.length} public repositories\n                </p>\n                <ul className=\"space-y-3\" role=\"list\">\n                  {PINNED_REPOS.map((repo) => (\n                    <li key={repo.name}>\n                      <button\n                        type=\"button\"\n                        className=\"group w-full cursor-pointer rounded-[12px] border border-border/70 bg-card p-5 text-start shadow-soft transition-colors hover:border-primary/20\"\n                      >\n                        <div className=\"flex flex-col gap-3\">\n                          <div className=\"flex items-start justify-between gap-3\">\n                            <div className=\"flex min-w-0 flex-wrap items-center gap-2\">\n                              <span className=\"text-sm font-semibold text-primary group-hover:underline\">\n                                {repo.name}\n                              </span>\n                              <Badge variant=\"outline\">Public</Badge>\n                            </div>\n                            <ExternalLinkIcon\n                              className=\"size-3.5 shrink-0 text-muted-foreground transition-colors group-hover:text-primary\"\n                              aria-hidden\n                            />\n                          </div>\n                          <p className=\"text-sm leading-relaxed text-muted-foreground\">\n                            {repo.description}\n                          </p>\n                          <div className=\"flex flex-wrap items-center gap-4 text-muted-foreground\">\n                            <span className=\"inline-flex items-center gap-2 text-xs\">\n                              <span\n                                className={cn(\n                                  \"size-2.5 rounded-full\",\n                                  repo.dotClass\n                                )}\n                                aria-hidden\n                              />\n                              {repo.language}\n                            </span>\n                            <span\n                              dir=\"ltr\"\n                              className=\"inline-flex items-center gap-1 text-xs tabular-nums\"\n                            >\n                              <StarIcon className=\"size-3.5\" aria-hidden />\n                              {repo.stars.toLocaleString(\"en-US\")}\n                            </span>\n                            <span\n                              dir=\"ltr\"\n                              className=\"inline-flex items-center gap-1 text-xs tabular-nums\"\n                            >\n                              <GitForkIcon className=\"size-3.5\" aria-hidden />\n                              {repo.forks}\n                            </span>\n                          </div>\n                        </div>\n                      </button>\n                    </li>\n                  ))}\n                </ul>\n              </TabsContent>\n\n              <TabsContent value=\"activity\" className=\"mt-6\">\n                <ul\n                  className=\"divide-y divide-border/70 overflow-hidden rounded-[12px] border border-border/70 bg-card shadow-soft\"\n                  role=\"list\"\n                >\n                  {ACTIVITY.map((item) => (\n                    <li\n                      key={`${item.type}-${item.repo}-${item.time}`}\n                      className=\"flex items-start gap-3 px-4 py-3\"\n                    >\n                      <ActivityIcon type={item.type} />\n                      <div className=\"min-w-0 flex-1 text-start\">\n                        <p className=\"text-sm\">\n                          <span className=\"font-medium text-primary\">\n                            {item.repo}\n                          </span>{\" \"}\n                          <span className=\"text-muted-foreground\">\n                            — {item.message}\n                          </span>\n                        </p>\n                        <p className=\"mt-0.5 text-xs text-muted-foreground\">\n                          {item.time}\n                        </p>\n                      </div>\n                    </li>\n                  ))}\n                </ul>\n              </TabsContent>\n\n              <TabsContent value=\"stars\" className=\"mt-6\">\n                <ul className=\"space-y-3\" role=\"list\">\n                  {PINNED_REPOS.slice(0, 3).map((repo) => (\n                    <li\n                      key={repo.name}\n                      className=\"rounded-[12px] border border-border/70 bg-card p-5 shadow-soft\"\n                    >\n                      <div className=\"flex items-start justify-between gap-3\">\n                        <div className=\"min-w-0 text-start\">\n                          <p\n                            dir=\"ltr\"\n                            className=\"text-sm font-semibold text-primary\"\n                          >\n                            {USER.username.replace(/^@/, \"\")}/{repo.name}\n                          </p>\n                          <p className=\"mt-1 text-sm text-muted-foreground\">\n                            {repo.description}\n                          </p>\n                        </div>\n                        <Button\n                          type=\"button\"\n                          variant=\"outline\"\n                          size=\"xs\"\n                          aria-label={`Unstar ${repo.name}`}\n                          className=\"shrink-0 text-amber-600 hover:bg-amber-500/10 hover:text-amber-700 dark:text-amber-400\"\n                        >\n                          <StarIcon className=\"size-3\" aria-hidden />\n                        </Button>\n                      </div>\n                    </li>\n                  ))}\n                </ul>\n              </TabsContent>\n            </Tabs>\n          </div>\n        </div>\n      </div>\n\n      <div className=\"pb-16\" aria-hidden />\n    </main>\n  )\n}\n",
      "target": "components/blocks/user-account/user-profile-01/user-profile.tsx"
    },
