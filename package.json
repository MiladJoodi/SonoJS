{
  "name": "sonojs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/patch-next-themes.mjs",
    "registry:loaders": "node scripts/generate-example-loaders.mjs",
    "registry:build": "npm run registry:loaders && node scripts/build-registry.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "verify:cache": "node scripts/verify-cache-headers.mjs",
    "generate:og": "node scripts/generate-og-assets.mjs",
    "verify:seo": "node scripts/verify-seo.mjs && vitest run lib/seo.test.ts",
    "sonojs": "node packages/cli/bin/sonojs.mjs",
    "fix:ui-imports": "node scripts/fix-ui-imports.mjs",
    "publish:ui": "npm publish -w @sonojs/ui --access public"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@sonojs/ui": "*",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "highcharts": "^13.1.1",
    "highcharts-react-official": "^3.2.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.7.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-gauge-chart": "^0.5.1",
    "recharts": "^3.10.1",
    "resend": "^6.34.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.27",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "react-gauge-chart": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
